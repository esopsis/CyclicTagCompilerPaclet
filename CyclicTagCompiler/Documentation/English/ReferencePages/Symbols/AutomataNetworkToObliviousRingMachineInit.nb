Cell["\<\
A network of 3 automata: automaton 1 is the XOR of automata 2 and 3, \
automaton 2 is NOT automaton 1, and automaton 3 is the AND of automata 1 and \
2:\
\>", "ExampleText",
 CellID->386912227, ExpressionUUID->"8d01a50b-61ea-ab4b-9a10-cfc19bc7c6f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
         RowBox[{"1", " ", "-", " ", "x"}]}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"x", " ", "y"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "3"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->825628961, ExpressionUUID->"2dafe3e3-6a6b-b041-8659-d0e0ee4487df"],

Cell["\<\
Automaton 1 reads 2 inputs, automaton 2 is read by 2 automata, and automaton \
3 reads 2 inputs, so each takes 2 cells:\
\>", "ExampleText",
 CellID->89553050, ExpressionUUID->"06ae7ca9-5913-a445-8d7d-93ffc96e69cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkToObliviousRingMachineInit", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", "net"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->881295141, ExpressionUUID->"0a5ca919-35a8-b84e-8952-8b0c541be8d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "1", ",", "1"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->987570453, ExpressionUUID->"d250b260-55e1-9947-851c-05bc842dfd5a"]
}, Open  ]],

