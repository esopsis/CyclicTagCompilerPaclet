Cell["DecodeCyclicTagToObliviousRingMachine", "ObjectName",
 CellID->748272037, ExpressionUUID->"8529132d-df5c-3e41-bff4-3c77c986e0c5"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "76f61f37-4d6b-f74c-9915-71dabc7560b9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeCyclicTagToObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToObliviousRingMachine"], "[", 
   StyleBox["history", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "41b5393b-afb7-0f40-9b90-165f548e995e"],
 " \[LineSeparator]",
 "decodes the cyclic tag evolution ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "42814da7-50ae-d44c-8a82-57dd254c5990"],
 " to the evolution of the oblivious ring machine ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "af96f85b-fb82-e641-8bed-0eb54f31b726"],
 " on a tape of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "f0b9e59a-d8c7-214c-8856-9547c1d908ca"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "3b429d19-2269-7d4a-aa0a-8cd83ac658b1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeCyclicTagToObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToObliviousRingMachine"], "[", 
   StyleBox["history", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeStates", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "eaadc1d1-572c-fa4d-9b76-2b02de1630e7"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "bbfa03ef-3def-574c-ad37-afa3a71381d8"],
 " tape symbols."
}], "Usage",
 CellID->656886079, ExpressionUUID->"792da0d7-8d04-db49-8c99-a31e0bef9b00"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "8e6171dc-9e6b-f64f-becf-2dad37e26c97"],
 " is a list of cyclic tag tapes, one for each step, as given by ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"4483614c-b0ce-ce41-846b-8aa450742a24"],
 "."
}], "Notes",
 CellID->146966268, ExpressionUUID->"bdf01fac-004a-4c40-bb98-560bf2074b1e"],

Cell[TextData[{
 "Decoding first gives the evolution of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "63ba94bc-3fd5-bc47-bfe1-eca4d02f65e7"],
 "-ary cyclic tag system, as ",
 Cell[BoxData[
  ButtonBox["DecodeCyclicTagToNaryCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag"]], "InlineFormula", ExpressionUUID->
  "0a723f86-05b5-fb47-bc64-1c105088ef74"],
 " does, and then keeps the tapes at which a ring machine step ends, as ",
 Cell[BoxData[
  ButtonBox["DecodeNaryCyclicTagToObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeNaryCyclicTagToObliviousRingMachine"]], "InlineFormula", ExpressionUUID->
  "0007b0fd-e7f3-e04f-a3bf-d7927b28793c"],
 " does."
}], "Notes",
 CellID->301205998, ExpressionUUID->"705298ea-f307-634c-b7db-467c41cb66e9"],

Cell[TextData[{
 "Give the same ",
