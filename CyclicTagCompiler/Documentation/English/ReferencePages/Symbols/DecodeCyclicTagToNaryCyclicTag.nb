Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "abdfc79f-bef7-354b-900f-3a5abdc1caca"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeCyclicTagToNaryCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag"], "[", 
   StyleBox["history", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "6e94adc8-2863-1a49-a137-6f23e3b7be05"],
 " \[LineSeparator]",
 "decodes the cyclic tag evolution ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "c32addf1-7250-b447-9e7b-0268a57bd5a0"],
 " to the evolution of the 2-symbol cyclic tag system that it emulates.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "770a9ca8-85f5-f947-8b57-f68737a606c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeCyclicTagToNaryCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag"], "[", 
   StyleBox["history", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "4c253984-81a0-9143-a6c3-e81e0054dc11"],
 " \[LineSeparator]",
 "decodes ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "a3377eb3-ceb5-d743-ac90-23f2e63f1053"],
 " for a cyclic tag system with ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "1f0987b7-1d22-2b44-9f73-89fbba50e89b"],
 " symbols."
}], "Usage",
 CellID->620044140, ExpressionUUID->"9e2d7504-986d-3d4f-927d-5b741d160df6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "581ece1f-1386-1240-8bf3-134f04b1eafc"],
 " is a list of cyclic tag tapes, one for each step, as given by ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"8458797f-c212-4f40-a7a1-82ba0da0b586"],
 "."
}], "Notes",
 CellID->265610514, ExpressionUUID->"9121880e-3760-6843-897e-2057c180f670"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DecodeCyclicTagToNaryCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag"]], "InlineFormula", ExpressionUUID->
  "3e5530bb-7f59-5d49-87d6-91f4a2352a00"],
 " keeps every ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "e2d61e59-527d-2b4c-800d-79464ea881c0"],
 "-th tape, which is where a step of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "1ede7416-7650-ae4a-9a24-d68e234ee633"],
 "-ary system ends, and turns each block of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "3bd746f2-0dad-864f-9699-9125884aa87a"],
 " cells back into a symbol."
}], "Notes",
 CellID->754316963, ExpressionUUID->"4a62c88c-00f1-2e4f-a388-160ac186a37b"],

