Cell[BoxData[
 RowBox[{
  RowBox[{"ObliviousRingMachineToCyclicTagInit", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "}"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "x"}], "}"}]}]}], "]"}], " ", "===", " ", 
  RowBox[{"NaryCyclicTagToCyclicTagInit", "[", 
   RowBox[{
    RowBox[{"{", 
