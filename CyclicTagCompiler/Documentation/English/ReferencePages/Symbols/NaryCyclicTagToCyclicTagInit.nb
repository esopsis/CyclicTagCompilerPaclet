Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "37fa0ece-f6bc-8c41-8e89-a40de934bdca"],
 " is a list of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "c1c9e764-1438-874a-8c29-309295c29ba6"],
 "-1."
}], "Notes",
 CellID->8475976, ExpressionUUID->"2053b868-07b2-1545-999d-b23ab750850a"],

Cell[TextData[{
 "Each symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "26d44b7c-b8db-3446-80a1-149d4d0b0dbe"],
 " becomes a block of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "0472674c-9244-7141-bdcc-6416b16553f4"],
 " cells that are all 0 except for a 1 at position ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "fefe9707-bf69-024a-95a5-a579223a7d0b"],
 "+1."
}], "Notes",
 CellID->282599932, ExpressionUUID->"354c2535-9077-064f-8457-5ef644a98fe0"],

Cell[TextData[{
 "Use the same number of symbols as ",
 Cell[BoxData[
  ButtonBox["NaryCyclicTagToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "9f68484d-7009-ae46-a175-47b3ff2c41d8"],
 " uses for the rule. If ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "0ca7a0ec-16f1-2a4b-8ebd-aa2916d7368e"],
 " contains a symbol of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "930dfa09-51cc-0d4e-848a-677af8fbb58a"],
 " or more, more cells are used for every symbol."
}], "Notes",
 CellID->813700257, ExpressionUUID->"790951f1-c152-9948-8c15-dd79f8071ffb"],

Cell["The following option can be given:", "Notes",
 CellID->885249170, ExpressionUUID->"56a4eb11-50ed-d947-906c-d6c187fbb5e3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "fa712ee9-6db7-f64a-9f79-2668f1ba086e"], "\"\<TargetSystem\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "the kind of cyclic tag system to compile to", "TableText", 
     ExpressionUUID->"c596cee1-ad40-ec4a-af2f-ae41c27cc595"]}
  }]], "3ColumnTableMod",
 CellID->608114205, ExpressionUUID->"22f7adf3-f687-f545-bab6-6dce22ab64f0"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"f8c2e2b8-4211-a74d-b374-7e8ffcf1f230"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["Automatic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Automatic"]}]], "InlineFormula", ExpressionUUID->
  "e8db0911-ef61-7840-87e7-7765afd33d55"],
 " uses as few cells as possible."
}], "Notes",
 CellID->425611352, ExpressionUUID->"a2dff5d8-3be0-ed46-bbed-b588566a94e4"]
}, Open  ]],

