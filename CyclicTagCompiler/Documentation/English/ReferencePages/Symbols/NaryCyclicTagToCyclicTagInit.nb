   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "64c2b3f7-2d32-5843-96c5-1fb4716f3620"],
 " \[LineSeparator]",
 "converts the tape ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "b2927f80-07d8-d548-9aa4-d587b7d5d338"],
 " of a cyclic tag system with ",
