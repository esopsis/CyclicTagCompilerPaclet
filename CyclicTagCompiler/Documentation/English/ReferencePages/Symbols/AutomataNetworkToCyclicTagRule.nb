Notebook[{

Cell[CellGroupData[{
Cell["AutomataNetworkToCyclicTagRule", "ObjectName",
 CellID->710663847, ExpressionUUID->"4a4e1c16-eede-0a48-8b0a-d0fdcd9db5e8"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "b25f96ea-55b2-074c-9fd5-038eeb1b2319"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkToCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagRule"], "[", 
   StyleBox["network", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "d62b17db-6ea8-4142-9627-dd3323b13b64"],
 " \[LineSeparator]",
 "compiles the automata network ",
 Cell[BoxData[
  StyleBox["network", "TI"]], "InlineFormula", ExpressionUUID->
  "629324e1-0062-4f41-9382-ab5de158b9eb"],
 " to a cyclic tag rule.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "f701d3b4-2fed-e640-a3ba-ce0ffb53a10d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkToCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagRule"], "[", 
   StyleBox["network", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "6bb8bd70-3117-8a46-8bd6-0156a7b750f4"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "bef3ee8d-4afc-834f-be41-feaae5cf9711"],
 " states."
}], "Usage",
 CellID->898520256, ExpressionUUID->"bb07e5d2-50b5-7e4d-8c45-e8f149cde894"],

Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{"}], 
   StyleBox["rules1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["inputs1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["label1", "TI"], 
   RowBox[{"}", ",", " ", "{"}], 
   StyleBox["rules2", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["inputs2", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["label2", "TI"], 
   RowBox[{
    RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"1c390995-31cc-d44c-9372-4a06f77aab24"],
 " of automata, as in ",
 Cell[BoxData[
  ButtonBox["AutomataNetworkRun",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun"]], 
  "InlineFormula", ExpressionUUID->"359d2255-a4bc-9845-8958-b3ff7c0d0719"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->56931960, ExpressionUUID->"0ebf55a1-ac15-004a-a191-c57bb1d26cbd"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula", ExpressionUUID->"455ec997-7c45-054d-940b-8cee6fb01d4b"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["x", "TI"], 
   RowBox[{"_", ",", " "}], 
   StyleBox["y", "TI"], 
   RowBox[{
    RowBox[{"_", "}"}], " ", ":>", " "}], 
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{"+", " "}]}], 
   StyleBox["y", "TI"], 
   RowBox[{
    RowBox[{",", " ", "2"}], "]"}]}]], "InlineFormula", ExpressionUUID->
  "3b9e46c0-d4eb-c040-ba70-f902ed5220a5"],
 "."
}], "Notes",
 CellID->7034549, ExpressionUUID->"67101b30-1104-d54f-b1f9-ad9849582ba0"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->727242809, ExpressionUUID->"781a803d-cf05-854e-9cdc-f65940e5f3ca"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "51e07559-b546-dc4f-b276-f34046856cb2"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "71dff5a1-799c-8149-a671-25c97e807e56"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "23399f62-b34d-dc42-8969-3dbf8f310c49"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "700ef01e-3b22-5245-b08c-ba6ac00fa5b8"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["x", "TI"], 
   RowBox[{
    RowBox[{"_", "}"}], " ", ":>", " "}], 
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}], "]"}]}]], "InlineFormula", 
  ExpressionUUID->"32972291-60df-c543-9b0e-6b3c30bda270"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "77f84d8e-f5cf-d14a-b907-3ed611aff25f"],
 " is 2."
}], "Notes",
 CellID->604155449, ExpressionUUID->"a81426f5-8c3c-d049-ab55-4b525d101e19"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "eded09a0-fb68-e748-98b2-15a2822114c2"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->916940783, ExpressionUUID->"f7136af4-a09b-9447-8775-d4f38f07b78e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["AutomataNetworkToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "b9fb40c9-d2ad-4e45-bedc-0a1f036385e1"],
 " compiles the network to an oblivious ring machine with ",
 Cell[BoxData[
  ButtonBox["AutomataNetworkToObliviousRingMachineRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToObliviousRingMachineRule"]], "InlineFormula", ExpressionUUID->
  "a1dc26f7-5d59-5241-a372-05fcfa39eba3"],
 ", and that to a cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachineToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "5b8d0804-a61b-584e-bd6b-fdd331e21974"],
 "."
}], "Notes",
 CellID->78500321, ExpressionUUID->"6920bc0e-ad6f-6b4c-9cd5-280df24c33f9"],

Cell[TextData[{
 "Run the cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"527b28be-fc6f-0949-8a91-01a4fd27b567"],
 ", starting from ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkToCyclicTagInit",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagInit"], "[", 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["network", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "183ffa59-2adf-7e4e-87f4-06fd462f0465"],
 " for ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkToCyclicTagSteps",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagSteps"], "[", 
   StyleBox["t", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["network", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "778dcd40-c57b-c145-90cf-43e53f98e8ba"],
 " steps, and decode its evolution with ",
 Cell[BoxData[
  ButtonBox["DecodeCyclicTagToAutomataNetwork",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToAutomataNetwork"]], "InlineFormula", ExpressionUUID->
  "cfe0bffd-7f85-2e49-b390-51d0416d8739"],
 ". ",
 Cell[BoxData[
  ButtonBox["CompiledAutomataNetworkToCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag"]], "InlineFormula", ExpressionUUID->
  "9e8e5f46-0e7f-8047-a464-d351901f3e85"],
 " does all of this."
}], "Notes",
 CellID->146613073, ExpressionUUID->"ec6ef81d-d3c2-1e44-a9e7-adc8b0d7c895"],

Cell["The following option can be given:", "Notes",
 CellID->623592424, ExpressionUUID->"58ea87af-7571-9645-9257-61b032b45ac0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "3706b120-18f7-e146-af02-a7ec51993194"], "\"\<TargetSystem\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "the kind of cyclic tag system to compile to", "TableText", 
     ExpressionUUID->"4f13ebca-4d7c-1646-ad0b-923ccaa5a21f"]}
  }]], "3ColumnTableMod",
 CellID->263528891, ExpressionUUID->"e04ecd9a-8cfe-7247-ac73-201a5cc97812"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"d139613e-1b50-a448-a700-9898877a5971"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["Automatic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Automatic"]}]], "InlineFormula", ExpressionUUID->
  "2b5bdc23-0e9e-574f-9c78-0adb27444adb"],
 " uses as few cells as possible."
}], "Notes",
 CellID->32354045, ExpressionUUID->"7aa5fdcd-6e5a-2c40-a8bf-85bb36ba9ec7"],

Cell[TextData[{
 "Use the same ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "f14cfdcf-bc7a-c749-b30a-bd70a76c1b00"],
 " and option settings for the rule, initial condition, step count and \
decoding."
}], "Notes",
 CellID->647436844, ExpressionUUID->"2b5566a9-c108-8d46-81c5-208a4643b168"]
}, Open  ]],

