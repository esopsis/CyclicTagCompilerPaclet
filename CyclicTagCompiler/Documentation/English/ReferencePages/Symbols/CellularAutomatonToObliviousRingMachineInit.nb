 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "9915b513-85f7-b04c-8297-e86c6990f325"],
 " extra cells, which the ring machine uses to keep the old colors of the \
cells that wrap around."
}], "Notes",
 CellID->359081895, ExpressionUUID->"4fea52e3-f4a3-da42-9955-7e81a1d8a8a4"],

Cell[TextData[{
 "The default value of ",
