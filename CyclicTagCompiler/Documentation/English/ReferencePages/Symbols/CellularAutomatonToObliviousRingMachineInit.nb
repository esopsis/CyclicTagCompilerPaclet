Cell[TextData[{
 "By default, the ring machine tape is ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "0b47da54-54b7-3e47-b655-97a7a062a929"],
 " itself."
}], "Notes",
 CellID->116920114, ExpressionUUID->"48481080-18ba-9042-a795-269bcd96298f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "4d804ac0-da53-f245-8e03-31525c761a6a"],
