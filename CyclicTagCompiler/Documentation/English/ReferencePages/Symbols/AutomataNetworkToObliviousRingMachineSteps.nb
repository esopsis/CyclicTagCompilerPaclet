Cell[TextData[{
 "Each step of the network is one pass through the ring machine rule, so ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkToObliviousRingMachineSteps",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToObliviousRingMachineSteps"], "[", 
   StyleBox["steps", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["network", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "36fa7311-5e55-8f4f-947c-2391ef68d8ba"],
 " is ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula", ExpressionUUID->
  "6224a05e-954a-594d-9ce9-7a70d3d441da"],
 " times the length of ",
 Cell[BoxData[
  RowBox[{
