Cell[CellGroupData[{
Cell["NaryCyclicTagToCyclicTagRule", "ObjectName",
 CellID->883887527, ExpressionUUID->"b6b74047-d041-7d43-9d5a-5fc1810511c3"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "1a98bd8e-3f05-724a-a2f1-43cef11bc3cb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTagToCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "218af2bc-8ebb-574e-a181-ad3a832b928a"],
 " \[LineSeparator]",
 "converts the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "9e4893b5-ce72-af49-a283-ebffeb6eebe7"],
 "-ary cyclic tag rule ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "d0a541a8-9d9a-4b4a-81d4-748d2ef095c8"],
 " to a cyclic tag rule.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "29931cb3-8d7d-e948-a534-609c3bfec494"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTagToCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "e1dc535d-69b0-184c-ad79-2a66a8a4f10d"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "69cc9dce-86e3-4149-b64f-bb5999ce5af1"],
 " tape symbols."
}], "Usage",
 CellID->814324685, ExpressionUUID->"a4629369-b8da-6f49-857b-499c740caf3b"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "ceef86d2-1ec4-3f4d-840a-5c693f63fe33"],
 "-ary cyclic tag system has a tape of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "798e9800-3cf5-bb4d-a9cf-c54e1fe4be39"],
 "-1 and a list of rule parts that it uses in turn. At each step it deletes \
the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "03f24888-2a42-474f-8717-af07fcb67587"],
 " of the tape and appends the appendant for ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "6a2c0c1c-d276-234c-8b3e-770bff6862a8"],
 " from the current rule part."
}], "Notes",
 CellID->596608220, ExpressionUUID->"983a14fd-c23b-6c48-b8f2-3330444d5759"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "4f8e1c4a-f3c3-be42-9b64-7b0d3e566a17"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["part1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["part2", "TI"], 
   RowBox[{
    RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"94fef106-23d5-984e-abec-c1271ded1db0"],
 " of rule parts. Each part is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["a0", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["a1", "TI"], 
   RowBox[{
    RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"f5850493-95cf-ec47-8e9c-ce0a23e502f4"],
 " of appendants: ",
 Cell[BoxData[
  StyleBox["a0", "TI"]], "InlineFormula", ExpressionUUID->
  "6836b026-35a5-3c43-a2d0-660a194642a7"],
 " is appended when the deleted symbol is 0, ",
 Cell[BoxData[
  StyleBox["a1", "TI"]], "InlineFormula", ExpressionUUID->
  "97c532ce-8ad8-5847-a5f5-4a92a3fa54b5"],
 " when it is 1, and so on. Each appendant is a list of symbols."
}], "Notes",
 CellID->909996744, ExpressionUUID->"42ac70a9-b2fb-684a-b3b1-6e7d39f0d877"],

Cell["\<\
A rule part with fewer appendants than symbols appends nothing for the \
missing symbols.\
\>", "Notes",
 CellID->721716713, ExpressionUUID->"1e781431-b577-514b-b625-5946eca958cf"],

Cell[TextData[{
 "The number of symbols ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "79813de0-19e4-1349-9351-61e5f11b5772"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "d82441e6-b4a2-a943-9807-4880a7ef6a6a"],
 ", one more than the largest symbol in ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "b1b3ecfe-a3c4-5d4b-a531-83554303529b"],
 ", and the length of the longest rule part. The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "1f4b655d-89e2-b94d-9b1f-2e8fb4d7712e"],
 " is 2."
}], "Notes",
 CellID->817974380, ExpressionUUID->"18e9f37d-6988-664c-94cf-27e19e57dc08"],

Cell[TextData[{
 "Each symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "82a9c6e9-eafb-5f44-9db3-8ef530020965"],
 " is encoded as a block of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "0fbabe0d-b9b5-314d-bf61-0157d549faad"],
 " cyclic tag cells that are all 0 except for a 1 at position ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "899c1fa7-0520-d34f-90af-436f2b0d5ee2"],
 "+1. Each rule part becomes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "a6796273-dd8c-ea47-8a1d-410d98176804"],
 " consecutive cyclic tag appendants, one for each symbol, so one step of the \
",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "a4028fcb-b4fe-6f4e-a22d-4f7af33329dd"],
 "-ary system takes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "bad7ac0e-a067-a245-98a4-ee5478e9a0c2"],
 " cyclic tag steps."
}], "Notes",
 CellID->398508024, ExpressionUUID->"ce82bbd3-ad22-be42-8277-33a115a58df9"],

Cell[TextData[{
 "Run the cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"23e722ea-a2d6-8f45-bc02-bfac606c592b"],
 ", starting from ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTagToCyclicTagInit",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagInit"], "[", 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["n", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "1564371a-61c5-ba44-8d46-fd15294146e1"],
 " for ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTagToCyclicTagSteps",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagSteps"], "[", 
   StyleBox["t", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["n", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "5ad86197-40cf-ae4d-96fd-bcab011509ca"],
 " steps, and decode its evolution with ",
 Cell[BoxData[
  ButtonBox["DecodeCyclicTagToNaryCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag"]], "InlineFormula", ExpressionUUID->
  "23fd5630-ab89-0b42-9b31-fccdce5b3226"],
 "."
}], "Notes",
 CellID->49467831, ExpressionUUID->"56939101-d664-174e-910e-22b202ace099"],

Cell["The following option can be given:", "Notes",
 CellID->490037067, ExpressionUUID->"dc838fd4-da4e-074a-aa5b-f3049ca1ed45"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "a12123f5-826d-1849-9ebd-c31b8becf8e7"], "\"\<TargetSystem\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "the kind of cyclic tag system to compile to", "TableText", 
     ExpressionUUID->"9b78fb45-4412-b646-a427-bd630edfbf36"]}
  }]], "3ColumnTableMod",
 CellID->468953122, ExpressionUUID->"c7413133-39ee-994e-ace2-14651fa80d8c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"fe968ce4-340d-ab4e-9277-fcde022fe2d1"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["Automatic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Automatic"]}]], "InlineFormula", ExpressionUUID->
  "259aa1f2-ef9b-f24d-b790-2c7730f60bec"],
 " uses as few cells as possible."
}], "Notes",
 CellID->185295740, ExpressionUUID->"443f5e9a-a36f-ae40-a009-f3f308ea5b6f"],

Cell[TextData[{
 "The rule, initial condition, step count and decoding of one compilation \
must all use the same number of symbols and the same ",
 Cell[BoxData["\"\<TargetSystem\>\""], "InlineFormula", ExpressionUUID->
  "96587ad5-30e6-314c-a425-6f99356067e7"],
 " setting."
}], "Notes",
 CellID->762107408, ExpressionUUID->"295f667d-8d21-5444-ac4c-25400d4f2e10"]
}, Open  ]],

