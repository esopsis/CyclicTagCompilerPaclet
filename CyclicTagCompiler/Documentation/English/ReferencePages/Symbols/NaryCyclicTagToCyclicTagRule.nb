\>", "ExampleText",
 CellID->965914004, ExpressionUUID->"c9043448-633b-b546-9b22-2b2fb9ec5327"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NaryCyclicTagToCyclicTagRule", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}]}], "}"}], "]"}]], "Input",\

