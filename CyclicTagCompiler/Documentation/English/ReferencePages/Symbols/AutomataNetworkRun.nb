Cell[BoxData[
 RowBox[{
  RowBox[{"network", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "0", "}"}], " ", "->", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "1", "}"}], " ", "->", " ", "0"}]}], "}"}], ",", " ", 
       RowBox[{"{", "3", "}"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
