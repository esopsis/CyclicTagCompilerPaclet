Cell[TextData[{
 Cell[BoxData[
  ButtonBox["AutomataNetworkRun",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun"]], 
  "InlineFormula", ExpressionUUID->"c8d6aa14-c752-624f-809c-dc36d325e9f9"],
 " is the Wolfram Function Repository function ",
 ButtonBox["AutomataNetworkRun",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/FunctionRepository/resources/\
AutomataNetworkRun"], None}],
 ". It is retrieved the first time it is used."
}], "Notes",
 CellID->290165838, ExpressionUUID->"fdad5b39-dde0-2248-927a-da9b2b30f699"],

Cell["\<\
An automata network is a set of automata, each of which has a state. At each \
step, each automaton computes its new state from the current states of \
certain automata in the network, called its inputs.\
\>", "Notes",
 CellID->616324255, ExpressionUUID->"cff90200-4c00-3d40-bb9c-02e6b675ade6"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rulesi", "TI"]], "InlineFormula", ExpressionUUID->
  "872bee87-a5aa-b24b-ba41-a0652a8964ff"],
 " is a list of rules of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["x1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["x2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], " ", "->", " "}], 
   StyleBox["y", "TI"]}]], "InlineFormula", ExpressionUUID->
  "208dff30-3fa0-374d-9a98-70e1ea18ee31"],
 ". At each step, the first rule whose left-hand side matches the list of the \
current states of the automata ",
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula", ExpressionUUID->
  "1091dba9-2168-0c47-99a7-87e20643b80e"],
 " gives the new state ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula", ExpressionUUID->
  "253c7320-0538-2d48-86a8-6ed8cd0f2bec"],
 "."
}], "Notes",
 CellID->21850030, ExpressionUUID->"44c35404-9541-cf49-bfe3-680acdd51b99"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula", ExpressionUUID->
  "d8203470-37ad-1d4e-9cf4-fa9d3ba41d89"],
 " is a list of labels of automata. It can include ",
 Cell[BoxData[
  StyleBox["labeli", "TI"]], "InlineFormula", ExpressionUUID->
  "7eaac28b-ad3e-874c-8fd6-82744267203a"],
 " itself, and it can contain the same label more than once."
}], "Notes",
 CellID->172687368, ExpressionUUID->"7a137dcf-6684-c747-89f3-a93122871165"],

Cell[TextData[{
 "Labels can be any expressions, such as integers or strings. They are used \
only to refer to automata in ",
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula", ExpressionUUID->
  "94be87ac-f237-7140-83c7-17fb16d44ef4"],
 ", and do not have to match the positions of the automata in the list."
}], "Notes",
 CellID->933571231, ExpressionUUID->"e8ba6ce2-89ac-8b43-89ed-8a0679de85a1"],

Cell["\<\
All automata are updated at the same time, using the states from the previous \
step. This is known as parallel or synchronous updating.\
\>", "Notes",
 CellID->672622872, ExpressionUUID->"1e3bea48-8a21-864e-894c-33bb367d344d"],

Cell[TextData[{
 "States can be any expressions. ",
 Cell[BoxData[
  StyleBox["rulesi", "TI"]], "InlineFormula", ExpressionUUID->
  "bf535972-f679-0a4c-8215-df5f0e074b46"],
 " can use patterns, conditions and ",
 Cell[BoxData[
  ButtonBox["RuleDelayed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/RuleDelayed"]], "InlineFormula", ExpressionUUID->
  "cffa395f-e9d2-464d-bf11-888bc2057d7b"],
 "."
}], "Notes",
 CellID->386912160, ExpressionUUID->"0016a2ed-f4dd-4446-9538-1ccd75fc5d60"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "5e4d65d5-f419-b541-af0a-338da91502af"],
 " is a list of initial states, in the same order as the automata. Each \
element of the result gives the states in that order."
}], "Notes",
 CellID->528157382, ExpressionUUID->"1d35a7c3-ee14-9443-9489-65185f931245"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkRun",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun"], "[", 
   StyleBox["network", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "37cbeb36-94a8-2249-a5e5-5d7443354a0b"],
 ", each automaton has the form ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{"}], 
   StyleBox["rulesi", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["si", "TI"], 
   RowBox[{"}", ",", " "}], 
   StyleBox["inputsi", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["labeli", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "e81e3c32-1cf5-0e48-9faf-4ab025c23362"],
 ". The result is a list of ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "00f528e4-87fb-d347-a8cf-715e2283d63f"],
 "+1 networks of the same form, in which only the states ",
 Cell[BoxData[
  StyleBox["si", "TI"]], "InlineFormula", ExpressionUUID->
  "087c2752-d298-8349-a00b-013445f5e7df"],
 " change."
}], "Notes",
 CellID->672425218, ExpressionUUID->"0c0133cd-cd03-e942-aea4-11347b8320b8"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["AutomataNetworkToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "4aa9dacc-6e0f-8c4c-8482-34955c7a4c44"],
 " compiles an automata network to a cyclic tag system."
}], "Notes",
 CellID->676441713, ExpressionUUID->"0154440d-a5a1-be4c-9591-9072096f50ec"]
}, Open  ]],

