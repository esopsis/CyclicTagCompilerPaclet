Cell["\<\
Give each automaton together with its state, and get the complete network at \
each step. This automaton gives the NOT of its own state:\
\>", "ExampleText",
 CellID->932463081, ExpressionUUID->"1c427e95-5d4b-1e40-874d-e3140058da99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkRun", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "0", "}"}], " ", "->", " ", "1"}], ",", " ", 
          RowBox[{
