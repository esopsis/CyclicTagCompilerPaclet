  "2ab09551-6513-6646-8885-03d3aa6dc41d"],
 " to the states of the automata ",
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula", ExpressionUUID->
  "06963450-8bc9-b84a-91be-89b652d23ea7"],
