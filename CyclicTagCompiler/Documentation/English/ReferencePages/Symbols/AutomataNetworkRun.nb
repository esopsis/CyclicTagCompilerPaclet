Cell["\<\
Define a Boolean network of three automata. Automaton 1 gives the NOT of \
automaton 3, automaton 2 gives the AND of automata 1 and 3, and automaton 3 \
gives the XOR of automata 1 and 2:\
\>", "ExampleText",
 CellID->839365116, ExpressionUUID->"f554e4cd-d8ca-7249-97a6-5b5e2eca2141"],

Cell[BoxData[
 RowBox[{
  RowBox[{"network", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "0", "}"}], " ", "->", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "1", "}"}], " ", "->", " ", "0"}]}], "}"}], ",", " ", 
       RowBox[{"{", "3", "}"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}], ",", 
         " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"_", ",", " ", "_"}], "}"}], " ", "->", " ", "0"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "3"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->18485487, ExpressionUUID->"d24068eb-fef8-d14e-9a2c-ca4189c2ead3"],

Cell["\<\
Evolve the network for 8 steps, starting with every automaton in state 0:\
\>", "ExampleText",
 CellID->30314358, ExpressionUUID->"687912f0-6cef-f649-9451-cef4cf673803"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkRun", "[", 
  RowBox[{"network", ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", "8"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->900645186, ExpressionUUID->"d53b9d9a-c1d1-2c49-a48c-784cd6ddda73"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->520952359, ExpressionUUID->"88962e23-7a20-5d4a-942a-19234ab62546"]
}, Open  ]],

