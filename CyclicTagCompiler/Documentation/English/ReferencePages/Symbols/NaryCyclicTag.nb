Cell[CellGroupData[{
Cell["NaryCyclicTag", "ObjectName",
 CellID->269475218, ExpressionUUID->"fd81554c-745f-de46-8889-8c5e97da8a66"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "544da4a0-0aa6-e04d-996b-a233ea1d447e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag"], 
   RowBox[{"[", "{"}], 
   StyleBox["rule1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], ",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "72460906-9624-2145-884f-5de641fd5f32"],
 " \[LineSeparator]",
 "gives a list of the tapes in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "29773dde-d210-0f45-9754-8906003023a1"],
 " steps of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "a2dab55b-b20c-8d4c-9b0a-4ee8fc41847c"],
 "-ary cyclic tag system that uses the rules ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula", ExpressionUUID->
  "ebde4ef2-64ad-184e-9c5e-c383f5a6496a"],
 " in turn, starting from the tape ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "3b8a2532-3c5a-0947-8a3d-4621c5daa445"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->"ed63fba3-8238-6047-bfdd-a0fabfdfe1ce"]
}], "Usage",
 CellID->843496109, ExpressionUUID->"b09d1b37-f872-634e-b413-d2f14209e0de"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["NaryCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag"]], 
  "InlineFormula", ExpressionUUID->"01d339d3-c445-7946-a688-6e672d52988b"],
 " is the Wolfram Function Repository function ",
 ButtonBox["NaryCyclicTag",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/FunctionRepository/resources/\
NaryCyclicTag"], None}],
 ". It is retrieved the first time it is used."
}], "Notes",
 CellID->223030244, ExpressionUUID->"aa636c42-5a13-ca4a-adae-0e92f3edc2ba"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "1ea06b60-8586-064f-b0b7-265d11d0ceb0"],
 "-ary cyclic tag system works on a tape, which is a list of the symbols 0, \
1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "dc97cdad-ba97-cc47-8153-27e097e9ce1c"],
 "-1."
}], "Notes",
 CellID->71114830, ExpressionUUID->"9a5d339d-9eee-cb46-98a7-56b71fac3aa1"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula", ExpressionUUID->
  "cbb6c15d-e1bd-9545-b9c4-4911bf96970b"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["w0", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["w1", "TI"], 
   RowBox[{
    RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"1a1a4377-4700-ca42-a0b3-ebb14de10386"],
 " of appendants. Each appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula", ExpressionUUID->
  "a38fc829-d84f-0a4e-a59d-e601a9ac88f9"],
 " is a list of symbols."
}], "Notes",
 CellID->746397807, ExpressionUUID->"4b04c125-7dda-854a-b351-f763aafa7927"],

Cell[TextData[{
 "At each step, the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "93a2a4fc-66ea-3247-8199-c266746d61b3"],
 " is removed from the tape, and the appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula", ExpressionUUID->
  "a0a96b29-80bb-1143-9599-869694088a78"],
 " of the current rule is added to the end of the tape."
}], "Notes",
 CellID->928152345, ExpressionUUID->"81e39b31-86e0-134d-b6ed-ee74f6d25eec"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula", ExpressionUUID->
  "d5903589-f816-4041-a928-709e8b01151c"],
 " are used in turn, one at each step, starting again from ",
 Cell[BoxData[
  StyleBox["rule1", "TI"]], "InlineFormula", ExpressionUUID->
  "cc7bcbfc-b4f3-c74c-836d-e1c1aa0c6977"],
 " after the last one."
}], "Notes",
 CellID->836444955, ExpressionUUID->"2f2a6083-d442-3742-9d4e-37a84e4447a8"],

Cell[TextData[{
 "A rule with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "849f7c40-2c93-404b-89c4-242290825518"],
 " appendants gives appendants for the symbols 0 through ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "3bdcf411-335c-c647-a3e0-143ff1cf642f"],
 "-1. Rules can have different lengths, as long as each rule has an appendant \
for every symbol that is at the start of the tape when the rule is used."
}], "Notes",
 CellID->183476603, ExpressionUUID->"bf1112d8-7d77-4c46-9ac1-7d8667feeff8"],

Cell["\<\
An appendant can be empty. The tape is then one symbol shorter after the step.\
\>", "Notes",
 CellID->888542513, ExpressionUUID->"26ab266d-ae62-224d-813b-1a0718067288"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "9125f570-9aba-4d4d-bae9-4db005f20135"],
 " must be a list of nonnegative integers. It can be empty."
}], "Notes",
 CellID->987842714, ExpressionUUID->"7105f319-ac9e-f040-8f16-e6cb5ea627f4"],

Cell["The following option can be given:", "Notes",
 CellID->704572727, ExpressionUUID->"95cc0567-99fe-9b48-9c7e-8c9ceea264d2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "a0d0c642-6170-1d45-854b-e98e555b573f"], "\"\<IncludeRules\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to give each tape together with the rule that is used on it next\
\>", "TableText", ExpressionUUID->"3dc54444-0545-1242-aa05-74e7843e784f"]}
  }]], "3ColumnTableMod",
 CellID->76960224, ExpressionUUID->"f56cde5e-b2eb-c643-9b69-1167dbd621a6"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeRules\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "718b62ba-103e-194d-b982-4ac266b77b9c"],
 ", each element of the result has the form ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["tape", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "562649cf-e595-9a44-9185-e394d2a5f8a3"],
 ", where ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "2f8ba883-b977-334f-b6fc-32872985d994"],
 " is the rule that is used on ",
 Cell[BoxData[
  StyleBox["tape", "TI"]], "InlineFormula", ExpressionUUID->
  "6072f8d7-ceb5-7e42-833b-e94394b015ab"],
 " next."
}], "Notes",
 CellID->530685495, ExpressionUUID->"b4d1ecc6-d9b0-7545-b70e-cfa721ed48e6"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["NaryCyclicTagToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "b0304fd9-98b9-4342-9452-b483987db0ac"],
 " compiles an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "f38cb12e-d635-8449-9c7a-ea34c1c21442"],
 "-ary cyclic tag system to an ordinary cyclic tag system."
}], "Notes",
 CellID->646262751, ExpressionUUID->"ef3c06ab-7635-c74c-89a5-7591e11fdfea"]
}, Open  ]],

