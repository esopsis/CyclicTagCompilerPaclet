Cell[TextData[{
 "A binary system whose rules have the form ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "}"}], ",", " "}]}], 
   StyleBox["ai", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "ac9050bf-1598-a448-a4ec-592790ae6415"],
 " gives the same result as ",
