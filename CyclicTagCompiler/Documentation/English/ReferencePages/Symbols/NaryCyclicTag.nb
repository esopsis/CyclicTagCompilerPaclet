       RowBox[{"{", "2", "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
      "1", ",", "2", ",", "2", ",", "1", ",", "2", ",", "1", ",", "2"}], 
      "}"}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", "0", "}"}]}], "}"}]},
    {
