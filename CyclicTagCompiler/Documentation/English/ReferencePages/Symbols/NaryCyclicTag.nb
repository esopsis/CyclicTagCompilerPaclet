Cell[CellGroupData[{
Cell["NaryCyclicTag", "ObjectName",
 CellID->874733956, ExpressionUUID->"e24788e1-d8de-df4a-a991-a57ba8cb0ecf"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "8d11a233-0cfd-d54b-9543-1b35604cf811"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag"], 
   RowBox[{"[", "{"}], 
   StyleBox["rule1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], ",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "c157a7a1-b933-c440-9f5f-8f8300292bcc"],
 " \[LineSeparator]",
 "gives a list of the tapes in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "263ae3f4-7b29-2e40-befe-41b88e3b85b7"],
 " steps of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "888ba787-7f79-f94f-9aca-226023c2f47e"],
 "-ary cyclic tag system that uses the rules ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula", ExpressionUUID->
  "6677a327-6835-7548-99c7-0165e91ab8f8"],
 " in turn, starting from the tape ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "0912db72-0c60-9443-8aa4-8e32182103d4"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "e90d074d-8df3-1747-ad66-e35e1321189d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag"], 
   RowBox[{"[", "{"}], 
   StyleBox["rule1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], ",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["prop", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "250e7ede-3802-ed48-8039-e6b28ca57cd8"],
 " \[LineSeparator]",
 "gives the property ",
 Cell[BoxData[
  StyleBox["prop", "TI"]], "InlineFormula", ExpressionUUID->
  "e280a4ee-c330-4c48-b538-c10eb741e366"],
 " for each step of the evolution.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "60b7fdc2-6712-e744-a127-3887ac3106b9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag"], 
   RowBox[{"[", "{"}], 
   StyleBox["rule1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], ",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], 
   RowBox[{",", " ", "{"}], 
   StyleBox["prop1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["prop2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], "]"}]}]], "InlineFormula", 
  ExpressionUUID->"6f6bb8c6-f686-e14c-b31e-4fc5eca2286e"],
 " \[LineSeparator]",
 "gives a list of the properties ",
 Cell[BoxData[
  StyleBox["propi", "TI"]], "InlineFormula", ExpressionUUID->
  "9ff33cd3-d83a-b24a-b6b3-fe5f981eedac"],
 " for each step."
}], "Usage",
 CellID->336398083, ExpressionUUID->"f267c7f0-2b6f-8a4b-86a2-c717079c7bb8"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["NaryCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag"]], 
  "InlineFormula", ExpressionUUID->"c65aa555-b45c-cc48-8be7-b2cdfcb31085"],
 " is the Wolfram Function Repository function ",
 ButtonBox["NaryCyclicTag",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/FunctionRepository/resources/\
NaryCyclicTag"], None}],
 ". It is retrieved the first time it is used."
}], "Notes",
 CellID->521335428, ExpressionUUID->"2f3bd9c4-f134-a448-bc1f-56715acf91c5"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "0cf7f852-8189-2d48-8105-86e81e8914ca"],
 "-ary cyclic tag system works on a tape, which is a list of the symbols 0, \
1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "b83dc7ff-ad9f-da4a-aab5-2bbc0135330b"],
 "-1."
}], "Notes",
 CellID->39283519, ExpressionUUID->"a837c7a0-68ca-894d-a421-7cc2dae34f1d"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula", ExpressionUUID->
  "bf8c7a00-2f48-fa48-b38d-ffa32ce8d909"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["w0", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["w1", "TI"], 
   RowBox[{
    RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"ea9338ca-086d-6240-aef0-138d03db0d7c"],
 " of appendants. Each appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula", ExpressionUUID->
  "73993237-9849-0545-97a6-4eb6bc776454"],
 " is a list of symbols."
}], "Notes",
 CellID->279955860, ExpressionUUID->"f3b111a7-11d1-ce4d-979d-529dc3174727"],

Cell[TextData[{
 "At each step, the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "9374d7df-3ade-cf42-aaf7-8148b6a17628"],
 " is removed from the tape, and the appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula", ExpressionUUID->
  "8165c200-5c6e-0740-b5df-05127bcddbe1"],
 " of the current rule is added to the end of the tape."
}], "Notes",
 CellID->723538001, ExpressionUUID->"27c84fad-9c40-5548-87b1-4676abf19c73"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula", ExpressionUUID->
  "8b65049c-dc6b-2341-99c3-5b9c4d827e73"],
 " are used in turn, one at each step, starting again from ",
 Cell[BoxData[
  StyleBox["rule1", "TI"]], "InlineFormula", ExpressionUUID->
  "a5fba4b8-a10e-da47-9851-d65f0736ec9b"],
 " after the last one."
}], "Notes",
 CellID->614269972, ExpressionUUID->"b83125a4-0ef9-6441-8da1-93b11439757e"],

Cell[TextData[{
 "A rule with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "3d0049e0-83bf-a44a-a644-1d10cc9441b5"],
 " appendants gives appendants for the symbols 0 through ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "01cdd4ce-5de7-1045-aa32-0210ccbf9c70"],
 "-1. Rules can have different lengths, as long as each rule has an appendant \
for every symbol that is at the start of the tape when the rule is used."
}], "Notes",
 CellID->583189011, ExpressionUUID->"c8623b33-8329-1741-927e-5b8870a34820"],

Cell["\<\
An appendant can be empty. The tape is then one symbol shorter after the step.\
\>", "Notes",
 CellID->405725213, ExpressionUUID->"43625f10-6d9d-274d-a035-e160ed4857b0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "b4970714-67cc-124f-80a5-4055d6db9ddc"],
 " must be a list of nonnegative integers. It can be empty."
}], "Notes",
 CellID->552375982, ExpressionUUID->"d31e3fee-1915-d444-a6b3-aeca03bf4323"],

Cell["The following properties can be given:", "Notes",
 CellID->490511496, ExpressionUUID->"b48bf191-aa13-b04b-a36b-af4303bb1bf3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "b5268bb6-dddb-734f-89ca-d699c7705e00"], Cell[
    BoxData["\"\<States\>\""], "TableText", ExpressionUUID->
     "60772c28-40d8-6148-bd8d-890adf813b58"], Cell[
    "the tape at each step (the default)", "TableText", ExpressionUUID->
     "611d15d1-64e5-8e46-875e-3f8ada0ff7fc"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "9c2931ac-74eb-b74a-9672-fa61ea2e9bb9"], Cell[
    BoxData["\"\<Rules\>\""], "TableText", ExpressionUUID->
     "a74773b3-40a2-894d-bb70-b4280d4fb3aa"], Cell[
    "the rule that is used on the tape next, at each step", "TableText", 
     ExpressionUUID->"03d144c0-cc31-484f-ba34-6f621adc8ef7"]}
  }]], "2ColumnTableMod",
 CellID->552290646, ExpressionUUID->"a7cdba92-48cf-994f-8a13-2ea86866a2fb"],

Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", "\"\<States\>\"", 
   RowBox[{",", " "}], "\"\<Rules\>\"", "}"}]], "InlineFormula", 
  ExpressionUUID->"d96ef4f9-bbc9-f444-bdcb-8cda60855453"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["tape", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "8f38affe-ccde-7847-9c50-b68a0317bac3"],
 " at each step."
}], "Notes",
 CellID->674677682, ExpressionUUID->"53de3d85-88a2-2141-9556-e19e92db9c82"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["NaryCyclicTagToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "4033fd9b-605a-674b-908d-c9f734490a79"],
 " compiles an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "7ce81cc3-f227-6349-bba2-103da5d8b3bb"],
 "-ary cyclic tag system to an ordinary cyclic tag system."
}], "Notes",
 CellID->327685484, ExpressionUUID->"8bb7e2cf-4289-0b43-8df8-dde3be6a8e01"]
}, Open  ]],

