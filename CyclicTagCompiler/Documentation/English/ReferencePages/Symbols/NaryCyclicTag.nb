Cell["\<\
Evolve a ternary cyclic tag system with two rules for 10 steps. Tape on the \
left, rule in that part of the cycle on the right:\
\>", "ExampleText",
 CellID->993219903, ExpressionUUID->"292c13f2-1808-8e45-9c76-a0866bef2132"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"NaryCyclicTag", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}], ",", " ", 
        RowBox[{"{", "0", "}"}]}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", "10", ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"\"\<States\>\"", ",", " ", "\"\<Rules\>\""}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->641226358, ExpressionUUID->"4982caea-64c5-7440-b6e4-779e2130e9d4"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "2"}], "}"}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", "1", "}"}], ",", 
