Cell[CellGroupData[{
Cell["AutomataNetworkToObliviousRingMachineRule", "ObjectName",
 CellID->816462333, ExpressionUUID->"529ca35f-817a-c44f-8e1d-f7cb5a5d9c29"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "bccc1d0e-4cbb-3149-94bd-00acefa47943"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkToObliviousRingMachineRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToObliviousRingMachineRule"], "[", 
   StyleBox["network", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "7f390cba-9da7-4944-90b9-efd9d04dd63c"],
 " \[LineSeparator]",
 "gives an oblivious ring machine rule that emulates the automata network ",
 Cell[BoxData[
  StyleBox["network", "TI"]], "InlineFormula", ExpressionUUID->
  "55f3a643-8921-174b-9ba1-b4b2692694c8"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "edc1f544-fe3f-124f-8224-49ec951b566f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AutomataNetworkToObliviousRingMachineRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToObliviousRingMachineRule"], "[", 
   StyleBox["network", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "ba48a8c5-5866-1648-a183-0fd5adaffcab"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "0defd7f0-5fd7-9541-af5c-6b96a7eb4160"],
 " states."
}], "Usage",
 CellID->361162883, ExpressionUUID->"507e674f-ac6b-3a4d-a88a-586b82419c1c"],

Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{"}], 
   StyleBox["rules1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["inputs1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["label1", "TI"], 
   RowBox[{"}", ",", " ", "{"}], 
   StyleBox["rules2", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["inputs2", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["label2", "TI"], 
   RowBox[{
    RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"c197ba33-9949-6f46-bd84-f54e73314183"],
 " of automata, as in ",
 Cell[BoxData[
  ButtonBox["AutomataNetworkRun",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun"]], 
  "InlineFormula", ExpressionUUID->"27165e8c-3d1c-9d40-8fb0-f9b1742f1c9b"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->703472248, ExpressionUUID->"d700cfa3-e41f-c241-99e2-016e8e8e628f"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula", ExpressionUUID->"2df22588-fd40-7149-8b8b-54e48976d2d1"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["x", "TI"], 
   RowBox[{"_", ",", " "}], 
   StyleBox["y", "TI"], 
   RowBox[{
    RowBox[{"_", "}"}], " ", ":>", " "}], 
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{"+", " "}]}], 
   StyleBox["y", "TI"], 
   RowBox[{
    RowBox[{",", " ", "2"}], "]"}]}]], "InlineFormula", ExpressionUUID->
  "b637a2ca-f37d-8a44-815f-30c2b4ddc875"],
 "."
}], "Notes",
 CellID->438958633, ExpressionUUID->"071bb13b-bf66-3e49-91ec-870163947c35"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->314399102, ExpressionUUID->"215179e1-2af2-6c4e-864b-86a542db6f34"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "f5bee610-7c7b-2048-a224-5dfa73f7e5ed"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "5e70f715-5b21-9a4d-a750-0c8eeb1f53a0"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "709ebe18-5201-a54a-9c97-400f3530179e"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "5e4e34a0-661a-4d4a-9455-b74af62979b8"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["x", "TI"], 
   RowBox[{
    RowBox[{"_", "}"}], " ", ":>", " "}], 
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}], "]"}]}]], "InlineFormula", 
  ExpressionUUID->"b0277c8e-e72e-ea4b-8f9f-1c2dbdfba9ec"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "77b10eac-4d3d-f548-abd1-e169d3ed8bf8"],
 " is 2."
}], "Notes",
 CellID->620954575, ExpressionUUID->"5e96acbe-ff92-a644-8679-933fc0c2daa1"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "3d2b2605-d746-6149-89f3-2ac42596c359"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->912302504, ExpressionUUID->"09b98eee-e73d-5b43-9430-1feb58e5dd41"],

Cell["\<\
On the oblivious ring machine tape, each automaton has a block of cells: one \
for each of its inputs, plus extra cells if more automata read its state than \
it has inputs. One step of the network is one pass through the ring machine \
rule, in three phases. First the extra cells of each block get copies of the \
automaton's state. Then the cells are bubble-sorted, so that each automaton's \
input cells hold the states of its inputs. Finally each automaton's rules are \
applied to its input cells, writing its new state into all of them.\
\>", "Notes",
 CellID->569335793, ExpressionUUID->"ba0c9793-c6aa-ee48-88f7-a8a996739284"],

Cell["\<\
The grow and sort phases use function steps that skip, swap or copy cells. \
When fewer automata need extra cells, the grow phase is shorter.\
\>", "Notes",
 CellID->67998794, ExpressionUUID->"e75f6ed3-fa60-6d42-8c57-08296c609f66"]
}, Open  ]],

