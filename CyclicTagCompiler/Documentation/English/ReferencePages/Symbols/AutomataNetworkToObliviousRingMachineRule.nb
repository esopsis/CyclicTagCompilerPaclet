Cell["\<\
An elementary cellular automaton on a cyclic tape is an automata network in \
which each cell reads its neighbors. Emulate rule 30 on 5 cells:\
\>", "ExampleText",
 CellID->900883049, ExpressionUUID->"541997be-ac07-2b44-a440-1f47d97f83a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ring", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "3"}], "]"}], " ", 
         "->", " ", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"30", ",", " ", "2", ",", " ", "8"}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"i", " ", "-", " ", "2"}], ",", " ", "5"}], "]"}], " ", "+",
           " ", "1"}], ",", " ", "i", ",", " ", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"i", ",", " ", "5"}], "]"}], " ", "+", " ", "1"}]}], "}"}],
        ",", " ", "i"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->234395337, ExpressionUUID->"86c21f31-17b2-aa4f-8041-cf28c2e001b2"],

