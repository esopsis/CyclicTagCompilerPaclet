       RowBox[{"{", "x$_", "}"}], "\[RuleDelayed]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"1", "-", "x$"}], ",", "1"}], "]"}]}], "}"}], ",", "1"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"Identity", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x$_", ",", "y$_"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"x$", " ", "y$"}], ",", "2"}], "]"}]}], "}"}], ",", "2"}], 
    "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->858976774, ExpressionUUID->"6977f707-6534-7445-964e-934e3765c4b5"]
}, Open  ]],

