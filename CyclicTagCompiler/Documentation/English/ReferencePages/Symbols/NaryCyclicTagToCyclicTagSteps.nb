   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "b0adf16d-d892-c042-ba60-aa908b6fd2b9"],
 " \[LineSeparator]",
 "gives the number of cyclic tag steps that emulate ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula", ExpressionUUID->
  "84c8350d-1691-6a4f-bb7b-a3278738148e"],
 " steps of an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "67dc61d8-e772-7e44-a202-281d48d828f2"],
 "-ary cyclic tag system with ",
