  }]], "3ColumnTableMod",
 CellID->411602785, ExpressionUUID->"b6bff131-0295-e04e-9da7-2d3cf39ce869"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"27a25180-cd4f-404b-bd98-f465f5c1b019"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["Automatic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Automatic"]}]], "InlineFormula", ExpressionUUID->
  "40045768-b84a-7242-b449-9a4ff1d74786"],
 " uses as few cells as possible."
}], "Notes",
 CellID->74043799, ExpressionUUID->"274feb80-d4ab-7741-88f1-5396681b1a84"]
}, Open  ]],

