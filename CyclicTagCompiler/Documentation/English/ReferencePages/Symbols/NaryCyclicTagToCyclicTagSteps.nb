}], "Usage",
 CellID->423835160, ExpressionUUID->"5169bed2-438b-ec45-a12b-a86d24a245c4"],

Cell[TextData[{
 "Each step of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "847c773b-1354-1d43-b389-4ad55a2b36fd"],
 "-ary system takes one cyclic tag step for each symbol, so ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NaryCyclicTagToCyclicTagSteps",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagSteps"], "[", 
   StyleBox["steps", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "1f6fdb27-3d03-f941-be79-3bdc9ee59d7c"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["steps", "TI"], " ", 
   StyleBox["states", "TI"]}]], "InlineFormula", ExpressionUUID->
  "210d3406-0930-a54b-b735-ecb8ced4a310"],
 "."
}], "Notes",
 CellID->454674479, ExpressionUUID->"fc1cf902-eed5-ba41-b158-8e74b326a49d"],

Cell["The following option can be given:", "Notes",
 CellID->865060223, ExpressionUUID->"197528d9-3b59-c842-83be-b081cbdff4a6"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "391c3c6b-500d-0245-8c03-09d6770f31f9"], "\"\<TargetSystem\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "the kind of cyclic tag system to compile to", "TableText", 
