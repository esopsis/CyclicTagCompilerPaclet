Cell["DecodeCyclicTagToCellularAutomaton", "ObjectName",
 CellID->767289849, ExpressionUUID->"9ad53770-c511-7245-8433-c976d282e09f"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "89860f05-3aea-c340-83a8-4af892e9ebc5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeCyclicTagToCellularAutomaton",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToCellularAutomaton"], "[", 
   StyleBox["history", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "aa585642-dd75-0c47-8ef9-5f25a1b77a5d"],
 " \[LineSeparator]",
 "decodes the cyclic tag evolution ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "56a4de49-f84c-544e-ae3b-ae87d7091366"],
 " to the evolution of a 2-color, range-1 cellular automaton on a tape of \
length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "e3d5ab96-38e0-0a45-ac15-22a11c6a5eb5"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "27057406-2c8d-8b41-bd34-487d02981580"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeCyclicTagToCellularAutomaton",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToCellularAutomaton"], "[", 
   StyleBox["history", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["k", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "01595cdc-71ff-f341-a21f-5aeaba2a9eec"],
 " \[LineSeparator]",
 "decodes ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "7a7a4597-11f4-cb41-b492-da2b7494931a"],
 " for a cellular automaton with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "8e853019-a961-b245-aa66-56516790b560"],
 " colors.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "fae9e8b3-81ad-5644-9c63-3bf0c438de5d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeCyclicTagToCellularAutomaton",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToCellularAutomaton"], "[", 
   StyleBox["history", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["k", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["r", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "808ecb4b-1461-814c-80ff-aa916f97cb41"],
 " \[LineSeparator]",
 "decodes ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "a144129d-41c6-174b-8d48-aaa01a7e0449"],
 " for a cellular automaton with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "75f0ab5d-fed5-504c-9eb3-740459623a59"],
 " colors and range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "7c2af49d-8d35-2948-a5b5-2e70091d3ac3"],
 "."
}], "Usage",
 CellID->140213226, ExpressionUUID->"d4d68334-42b9-b14e-ba92-a509177f0db0"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "4d807878-3f84-f042-9d10-a921125c71e9"],
 " is a list of cyclic tag tapes, one for each step, as given by ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"8a359563-c50a-3949-bd14-fad5a274bcde"],
 "."
}], "Notes",
 CellID->658181680, ExpressionUUID->"c57f9d61-465d-5045-b1f5-f2f7ac1d9054"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "f138f7c9-cd46-6245-b4c9-6b47a87284a3"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "c692297e-dce0-b141-9624-6e20098d4a81"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->758568249, ExpressionUUID->"7d55c774-e664-5a40-a830-6bf332dcff5a"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "5e84299d-0670-1948-a4b4-a400ed245e79"],
 ", the decoded evolution is the evolution of the cellular automaton on a \
cyclic tape."
}], "Notes",
 CellID->994261163, ExpressionUUID->"b03a63af-62f3-0a45-b6d5-8b27bd4f86ee"],

Cell["The following options can be given:", "Notes",
 CellID->122127515, ExpressionUUID->"f1afe2c9-bb19-a34b-8e0a-1b9da83e540a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "d072edbe-e07c-2d41-b7fe-442baf6f3c41"], "\"\<InfiniteSteps\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText", ExpressionUUID->"3a22c025-c662-f74c-b5c5-1ce587de0a6a"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "3f682b33-1f2d-1744-83c1-66592eb6aa7e"], "\"\<TargetSystem\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "the kind of cyclic tag system to compile to", "TableText", 
     ExpressionUUID->"2f220eba-7d94-ef4e-9cff-db977f74a2f8"]}
  }]], "3ColumnTableMod",
 CellID->612779532, ExpressionUUID->"aa9f034d-4256-b546-a177-f42b046b329f"],

Cell[TextData[{
 "Use the same ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "049642da-647c-9944-b655-8e9d53eeee1d"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "ec86e459-ddcd-fe4f-adf1-d47292719726"],
 ", ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "57c1f817-1cfa-4449-88f4-7b43526db4d6"],
 " and option settings as for the rule, initial condition and step count."
}], "Notes",
 CellID->509751031, ExpressionUUID->"111712a4-b6b6-5c4c-b79c-1a9dc472a708"]
}, Open  ]],

