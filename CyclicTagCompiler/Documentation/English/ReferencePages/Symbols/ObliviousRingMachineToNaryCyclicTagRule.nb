Cell["\<\
Compile a ring machine that swaps pairs of symbols, for a tape of 4 cells:\
\>", "ExampleText",
 CellID->901079235, ExpressionUUID->"88cbb2c0-bcc1-f848-82aa-256ce0db0dd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ObliviousRingMachineToNaryCyclicTagRule", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "x"}], "}"}]}], ",", " ", "4"}], "]"}], " ", "//",
   " ", "Short"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->918011647, ExpressionUUID->"007d7853-d15c-a245-907b-4f7ae2de63c6"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "3", "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "2", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "3", ",", "2"}], "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "}"}]}], "}"}], ",", 
    RowBox[{"\[LeftSkeleton]", "7", "\[RightSkeleton]"}], ",", 
