Cell[CellGroupData[{
Cell["ObliviousRingMachineToNaryCyclicTagRule", "ObjectName",
 CellID->184708163, ExpressionUUID->"64b3c743-0717-7c4a-9eaa-d56f5df15abf"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "bbcf9e5a-0ed8-5748-b62d-9432bf3a0a6d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachineToNaryCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToNaryCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "5f8abe6d-b220-4245-9adc-f461086da5ee"],
 " \[LineSeparator]",
 "compiles the oblivious ring machine ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "6008b695-b9d3-1e48-a547-90a079e3db3e"],
 " for a tape of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "7b9959d0-91de-2145-9064-f64f9b8ee481"],
 " to an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "05354d4f-1f65-2c4a-8004-af9c17ed4cd2"],
 "-ary cyclic tag rule.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "d2b243a5-88cf-5c45-8897-84e85cd0fde9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachineToNaryCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToNaryCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeStates", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "250f463a-0331-0543-bea9-4caaa5130ff3"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "9a4a02d6-3a42-6c42-8fe0-1adf24c0fb9e"],
 " tape symbols."
}], "Usage",
 CellID->430790541, ExpressionUUID->"1382ced9-1aec-b94e-b230-a7da005797a5"],

Cell["\<\
An oblivious ring machine has a circular tape and a list of steps that it \
uses in turn, whatever is on the tape. Each step replaces the first few \
symbols of the tape using rules, and then rotates the tape to the left by an \
offset.\
\>", "Notes",
 CellID->499487697, ExpressionUUID->"f5aaf599-112d-9344-a126-aae7dc45c7c1"],

Cell[TextData[{
 "The ring machine ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "a4688728-04bb-dc4c-9bdf-ebe4433ead49"],
 " can have the following forms, as in ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"]], 
  "InlineFormula", ExpressionUUID->"3b5db263-9065-ca45-9219-cc54b35a5e65"],
 ":"
}], "Notes",
 CellID->64185626, ExpressionUUID->"3ea8f6f1-54e1-794a-ba85-cc412cd77b5d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "1f9f44dd-b00f-bd45-ab90-246709979a7c"], Cell[BoxData[
     RowBox[{
      StyleBox["lhs", "TI"], 
      RowBox[{" ", 
       RowBox[{"->", " "}]}], 
      StyleBox["rhs", "TI"]}]], "TableText", ExpressionUUID->
     "a1dea33a-f2c5-8342-be7c-7b10225f5fe9"], Cell[
    "a single rule, used at every step", "TableText", ExpressionUUID->
     "d35ca175-9d8c-5241-b75a-4c7e06725e98"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "6104acb3-5f23-6a46-8882-3b62a7c2d4c7"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["rule1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["rule2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"3c8c3aaf-2504-a845-a968-6dc026191c38"], Cell[
    "a single step that uses whichever rule matches", "TableText", 
     ExpressionUUID->"1f4d3044-4dcf-4a45-b7c9-f3eeb6f0f515"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "5111bef3-d4cf-3743-ab1d-f879d1130322"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["f", "TI"], 
      RowBox[{",", " ", 
       RowBox[{"{", "}"}], ",", " "}], 
      StyleBox["n", "TI"], "}"}]], "TableText", ExpressionUUID->
     "cab92066-169d-6d44-9289-08e96ca0940b"], Cell[TextData[{
     "a step that replaces the first ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "0c135cac-38e2-2e4a-ac4c-5eb77cbc4a1b"],
     " symbols by ",
     Cell[BoxData[
      StyleBox["f", "TI"]], "InlineFormula", ExpressionUUID->
      "056f1c2e-6412-7a48-a2a7-7a42b52ee213"],
     " applied to the list of them"
    }], "TableText", ExpressionUUID->
     "1288d9ec-0c4d-b149-bd5d-7be0dcb58695"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "f4ceaa6e-63b5-e84e-bf7f-ed8e7cfb69a8"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["step", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], "}"}]], "TableText", ExpressionUUID->
     "beb8a779-4d6c-7144-b184-c6d09bb621e4"], Cell[TextData[{
     "a step followed by a rotation of the tape by ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "b53c8dde-17a1-9849-bfd5-0ae5268f9b2f"],
     " cells, instead of 1"
    }], "TableText", ExpressionUUID->
     "efcc0440-bdec-5345-b7f6-3549a6b72f78"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "442c0df1-92f1-a248-b26b-1c2aafb7b43c"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["step1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["step2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"ec88c270-74f9-b94b-aae0-96ca9e1f4225"], Cell[
    "a list of steps used in turn", "TableText", ExpressionUUID->
     "4b94e699-b716-8f4d-ba1b-c985a1cd0afd"]}
  }]], "2ColumnTableMod",
 CellID->881553561, ExpressionUUID->"70672a70-7481-0e45-aefc-8ce31a601662"],

Cell["A window of symbols that no rule matches is left unchanged.", "Notes",
 CellID->372149905, ExpressionUUID->"42da3a2d-9514-3f44-b05f-5dfc0d8651cf"],

Cell["\<\
To be compiled, every step must replace its window by the same number of \
symbols, all the rules of a step must have left-hand sides of the same \
length, and offsets must not be negative.\
\>", "Notes",
 CellID->219445347, ExpressionUUID->"8c145eb0-072c-b042-8944-e926e9d9133c"],

Cell[TextData[{
 "The ring machine uses the symbols from 0 to ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula", ExpressionUUID->
  "67021229-c629-e746-9392-34c5a23c0fe3"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula", ExpressionUUID->
  "7bfd2142-a914-f143-b0c2-6496d5b249ce"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "eb360064-f961-0846-9cc4-af6694cad1f9"],
 " and one more than the largest symbol written explicitly in the rules. \
Symbols computed by a right-hand side such as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}], "]"}]}]], "InlineFormula", 
  ExpressionUUID->"60f374ea-65de-0b45-aa4f-518a9a1046f3"],
 " are not counted, so give ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "342b83ae-3c6e-0749-bb17-053513a64146"],
 " for rules like that. The default value of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "1f27f7a9-23d3-7c43-bd3e-d0d6e651d406"],
 " is 2."
}], "Notes",
 CellID->47645954, ExpressionUUID->"e0f54c52-1ce0-054e-8d8b-b19f07a15bfc"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "fbda81db-965f-5443-bae5-ef03a2176d63"],
 "-ary cyclic tag tape is the ring machine tape itself, so the ring machine's \
initial condition needs no conversion. The ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "debec4c6-81d5-184b-96bf-1a5c8b50465d"],
 "-ary system uses two more symbols, ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula", ExpressionUUID->
  "2367cc08-1626-8e4d-8860-1bc3c39aeac1"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula", ExpressionUUID->
  "1ab64a06-4907-714e-a00b-99d6eeb79d37"],
 "+1, as markers."
}], "Notes",
 CellID->819719427, ExpressionUUID->"e20147dc-21cc-214f-b7e9-024c887a708d"],

Cell[TextData[{
 "Each ring machine step becomes a sequence of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "a7062338-ec3d-3543-bf6d-5a203a11cc94"],
 "-ary rule parts. The first ones read the window one symbol at a time, \
turning each symbol into a delay: its value times a power of ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula", ExpressionUUID->
  "758f7a4b-4548-fd48-b3f9-cb08225a7aeb"],
 ". Then the system skips around the rest of the tape, uses the total delay \
to choose the appendant that writes the replacement, and skips on to where \
the next step starts."
}], "Notes",
 CellID->272569159, ExpressionUUID->"b6e5e3cb-9c7f-9642-9f51-51c8a244c421"],

Cell[TextData[{
 "The compiled rule only works for tapes of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "c0d59ee0-4dc4-ce48-884f-b89e149bb6cf"],
 "."
}], "Notes",
 CellID->788223192, ExpressionUUID->"e73160d1-5b8c-f94c-91c8-db0cd5de26fc"],

Cell[TextData[{
 "Run the compiled system with ",
 Cell[BoxData[
  ButtonBox["NaryCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag"]], 
  "InlineFormula", ExpressionUUID->"646b3e02-d0d4-f34a-a29f-3523c0dc87db"],
 " for the number of steps given by ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachineToNaryCyclicTagSteps",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToNaryCyclicTagSteps"]], "InlineFormula", ExpressionUUID->
  "51c96349-870c-9643-a7b4-21e7aad894d5"],
 ", and decode its evolution with ",
 Cell[BoxData[
  ButtonBox["DecodeNaryCyclicTagToObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeNaryCyclicTagToObliviousRingMachine"]], "InlineFormula", ExpressionUUID->
  "31b0ea72-bffc-3d4d-8638-06f70b766ead"],
 "."
}], "Notes",
 CellID->213438897, ExpressionUUID->"57ceb8a7-f187-e94f-97c8-3fdc72b86f06"]
}, Open  ]],

