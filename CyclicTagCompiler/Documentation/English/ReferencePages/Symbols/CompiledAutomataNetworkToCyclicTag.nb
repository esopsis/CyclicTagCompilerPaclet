Cell["\<\
A network of 3 automata: automaton 1 is the XOR of automata 2 and 3, \
automaton 2 is NOT automaton 1, and automaton 3 is the AND of automata 1 and \
2:\
\>", "ExampleText",
 CellID->814365203, ExpressionUUID->"cc8e8b19-0d58-984d-9624-646f7e697798"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
         RowBox[{"1", " ", "-", " ", "x"}]}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"x", " ", "y"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "3"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->746471978, ExpressionUUID->"08029e05-7dbb-a548-a3a9-1d28bbb78b20"],

Cell["Run it for 6 steps by compiling it to a cyclic tag system:", \
"ExampleText",
 CellID->941678815, ExpressionUUID->"94da745d-5333-e348-b993-f27beee23a4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CompiledAutomataNetworkToCyclicTag", "[", "net", "]"}], "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", "6"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->399955431, ExpressionUUID->"d07cc0d5-a375-f741-ba54-e0b9ee768750"],

Cell[BoxData[
 RowBox[{"{", 
