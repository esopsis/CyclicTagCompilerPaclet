Notebook[{

Cell[CellGroupData[{
Cell["CompiledAutomataNetworkToCyclicTag", "ObjectName",
 CellID->602459539, ExpressionUUID->"0b2d6490-dc3c-3343-88da-97f11bd37049"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "4312ed17-2573-ea4a-b80a-30a6d1442dbf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledAutomataNetworkToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag"], "[", 
   StyleBox["network", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "f72e215f-f573-494c-a492-d0b09c018674"],
 " \[LineSeparator]",
 "gives a function that runs the automata network ",
 Cell[BoxData[
  StyleBox["network", "TI"]], "InlineFormula", ExpressionUUID->
  "d2c3ccb0-9ae6-b545-86d3-c7adf1f3a678"],
 " by compiling it to a cyclic tag system, running that system and decoding \
the result.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "9773c325-7363-4b4a-98f9-178454286fa1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledAutomataNetworkToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag"], "[", 
   StyleBox["network", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["states", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "48963789-044b-8845-95e3-2d1a12ae4aeb"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "c0522e51-7767-fa4c-97fb-5e83187d252d"],
 " states.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "c82ffb45-fef1-e549-bbf3-4f406239e4c6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledAutomataNetworkToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag"], 
   RowBox[{
    RowBox[{"[", "\[Ellipsis]", "]"}], "["}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["steps", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "5055ea63-c43f-c148-bfdc-8f777e2dcaef"],
 " \[LineSeparator]",
 "runs the network from the automaton states ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "d72547eb-c09f-9c45-a39d-e91ab92d79d9"],
 " for ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula", ExpressionUUID->
  "e58b9d66-1c76-5843-996e-b5bc35008763"],
 " steps."
}], "Usage",
 CellID->843433532, ExpressionUUID->"fcd95931-c5ab-584e-ae10-8a508fb6055c"],

Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{"}], 
   StyleBox["rules1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["inputs1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["label1", "TI"], 
   RowBox[{"}", ",", " ", "{"}], 
   StyleBox["rules2", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["inputs2", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["label2", "TI"], 
   RowBox[{
    RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"c5b6aecb-53e3-2c4c-9954-6523c7a78ff1"],
 " of automata, as in ",
 Cell[BoxData[
  ButtonBox["AutomataNetworkRun",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun"]], 
  "InlineFormula", ExpressionUUID->"dbce537e-48ea-6947-a632-721f47aef9ef"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->848568931, ExpressionUUID->"d1aaaa03-b9b6-904b-b83b-0ddb5cd23537"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula", ExpressionUUID->"908037e6-8e76-cb4c-afc6-f736cf41f7cd"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["x", "TI"], 
   RowBox[{"_", ",", " "}], 
   StyleBox["y", "TI"], 
   RowBox[{
    RowBox[{"_", "}"}], " ", ":>", " "}], 
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{"+", " "}]}], 
   StyleBox["y", "TI"], 
   RowBox[{
    RowBox[{",", " ", "2"}], "]"}]}]], "InlineFormula", ExpressionUUID->
  "968da3b8-1b37-4648-b272-ea2cbabd1eb9"],
 "."
}], "Notes",
 CellID->417378987, ExpressionUUID->"01482cc1-917c-9740-8fac-76058ea40924"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->663329928, ExpressionUUID->"e107800d-dd94-804b-b00a-65add16a4122"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "30609e22-6324-574d-91b3-cca136c60016"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "dafbc02d-9d54-184a-b8ed-4d26f8723526"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "28625140-1862-0e48-bf47-cec4a5e586ab"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "05a9fa31-12d5-e242-a890-29b1a309a8f0"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["x", "TI"], 
   RowBox[{
    RowBox[{"_", "}"}], " ", ":>", " "}], 
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}], "]"}]}]], "InlineFormula", 
  ExpressionUUID->"b80514a6-c7c7-1d4e-8af7-3d413a873341"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula", ExpressionUUID->
  "01a1f2e5-788a-004a-9f07-02477dd7f256"],
 " is 2."
}], "Notes",
 CellID->946079855, ExpressionUUID->"92dd53e1-1e09-824a-abd0-c3753e0cc47b"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "09cac0d2-621b-2846-8bc9-1d7fd8e76a06"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->564930259, ExpressionUUID->"27939aa0-4a39-8346-b33c-a6a83958c359"],

Cell[TextData[{
 "The cyclic tag rule is compiled once, when ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledAutomataNetworkToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag"], "[", 
   StyleBox["network", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "1f261a52-cdef-7d4e-a5e9-ee85e523af8e"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "70486b25-f55d-fa4f-9b9d-44993e6f2fff"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula", ExpressionUUID->
  "1d77d43d-5f82-f348-9d21-f8c7b8addb8d"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"d588c822-7a2e-8941-b179-e60feafda22f"],
 ", and decodes its evolution."
}], "Notes",
 CellID->174721962, ExpressionUUID->"a9360f57-7769-be48-972a-7399a20dd026"],

Cell["The following option can be given:", "Notes",
 CellID->579571903, ExpressionUUID->"4ccaa007-217f-8f41-ad23-a0555b2fd9cf"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "246f8f83-ec15-f845-9d79-c5b64e6a8720"], "\"\<Mod6CyclicTag\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
\>", "TableText", ExpressionUUID->"74231505-590f-a640-a93a-fafc298d2374"]}
  }]], "3ColumnTableMod",
 CellID->20814360, ExpressionUUID->"cd10b89b-9d5f-044d-a16c-40802c6fbab5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Mod6CyclicTag\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "6fa74114-c6a7-c44b-85b5-5125a973f932"],
 " compiles with ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"fea10f05-c556-8246-90aa-655493b0f8a5"],
 "."
}], "Notes",
 CellID->635966762, ExpressionUUID->"13365288-2ce7-b84f-8b64-c8475070b037"]
}, Open  ]],

