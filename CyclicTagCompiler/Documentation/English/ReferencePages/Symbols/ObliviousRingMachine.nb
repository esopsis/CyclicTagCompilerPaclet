  StyleBox["stepi", "TI"]], "InlineFormula", ExpressionUUID->
  "0447b506-e4aa-d748-bcb6-317f24729a10"],
 " in turn.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "440811ca-4d10-ff4e-ae9b-d7a123c993ee"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"], "[", 
   StyleBox["step", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "94ecacd4-37f4-be49-8d09-c339a607cbc6"],
 " \[LineSeparator]",
 "uses the single step specification ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula", ExpressionUUID->
  "4641ba0f-c414-7041-aa92-185e2fcfeb6f"],
 " at every step.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "e8641bb0-700d-7542-b847-9689086b9c51"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"], "[", 
