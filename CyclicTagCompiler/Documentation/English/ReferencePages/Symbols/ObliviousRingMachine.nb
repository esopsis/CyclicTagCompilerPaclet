   RowBox[{"{", 
    RowBox[{"\"\<a\>\"", ",", " ", "\"\<b\>\"", ",", " ", "\"\<c\>\""}], 
    "}"}], ",", " ", "4", ",", " ", 
   RowBox[{"\"\<LengthPreserving\>\"", " ", "->", " ", "False"}]}], 
