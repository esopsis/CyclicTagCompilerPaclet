Cell["ObliviousRingMachine", "ObjectName",
 CellID->303952906, ExpressionUUID->"a6d781b6-a956-2f41-bd4a-470567f39bdc"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "d6d10851-09d4-5f4c-9e2b-0fcd6fc0e9d8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"], 
   RowBox[{"[", "{"}], 
   StyleBox["step1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["step2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], ",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "779d6857-eb6b-5748-be83-c099965e4fb9"],
 " \[LineSeparator]",
 "gives a list of the results of ",
