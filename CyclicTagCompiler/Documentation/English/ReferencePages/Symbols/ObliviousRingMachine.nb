 CellID->553128335, ExpressionUUID->"43183678-ebac-1c43-a925-84ba88c524e4"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"]], 
  "InlineFormula", ExpressionUUID->"380152ff-78aa-464c-b98f-89afe1c09d4c"],
 " is the Wolfram Function Repository function ",
 ButtonBox["ObliviousRingMachine",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/FunctionRepository/resources/\
ObliviousRingMachine"], None}],
 ". It is retrieved the first time it is used."
}], "Notes",
 CellID->844611844, ExpressionUUID->"5a2d5c5a-2678-7443-b69b-2e588e32e4ba"],

Cell["\<\
An oblivious ring machine works on a list that is treated as a ring. At each \
step, it rewrites the elements at the start of the list and then rotates the \
list, so that other elements come to the start.\
\>", "Notes",
 CellID->813077164, ExpressionUUID->"f4db97ce-54a4-9a47-b003-89374cebd611"],

Cell["\<\
The machine is called oblivious because the sequence of rules and rotations \
is fixed in advance. It does not depend on the elements of the list.\
\>", "Notes",
 CellID->227248352, ExpressionUUID->"55398b85-4486-9942-ba86-959d6a3b675a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["stepi", "TI"]], "InlineFormula", ExpressionUUID->
  "712ce653-6f26-f14b-8341-b42b10385bf6"],
 " are used in order, starting again from ",
 Cell[BoxData[
  StyleBox["step1", "TI"]], "InlineFormula", ExpressionUUID->
  "212d1aa7-ee3d-9043-9fa4-17fe47003415"],
 " after the last one."
}], "Notes",
 CellID->717161868, ExpressionUUID->"646b4ec6-a1f2-dd4b-a5a1-53e038652cf7"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["stepi", "TI"]], "InlineFormula", ExpressionUUID->
  "b584e2d7-6d82-5741-aa28-da4e6754d67e"],
 " can have the following forms:"
}], "Notes",
 CellID->835598758, ExpressionUUID->"ae295717-0f4e-a146-b6de-b795e415250d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "8777c1a6-e8f4-e343-a00b-7917e908dfd7"], Cell[BoxData[
     RowBox[{
      StyleBox["lhs", "TI"], 
      RowBox[{" ", 
       RowBox[{":>", " "}]}], 
      StyleBox["rhs", "TI"]}]], "TableText", ExpressionUUID->
     "523aec59-1339-064c-b979-fe88ea59673f"], Cell[TextData[{
     "replace the elements at the start of the list that match ",
     Cell[BoxData[
      StyleBox["lhs", "TI"]], "InlineFormula", ExpressionUUID->
      "9295ddcd-c928-3b47-af2e-d8a209c80b4b"],
     " with the elements of ",
     Cell[BoxData[
      StyleBox["rhs", "TI"]], "InlineFormula", ExpressionUUID->
      "bff61d4f-98c5-0b49-bf11-eaa642941a1a"],
     ", then rotate the list one position to the left"
    }], "TableText", ExpressionUUID->
     "c85a9e95-88bc-a246-b4a7-d5c5ba80e89c"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "3f75a87a-315d-1e44-8da6-df47f1bcb7d9"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["lhs1", "TI"], 
      RowBox[{" ", 
       RowBox[{":>", " "}]}], 
      StyleBox["rhs1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["lhs2", "TI"], 
      RowBox[{" ", 
       RowBox[{":>", " "}]}], 
      StyleBox["rhs2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"df9c09b5-f27e-2b48-81df-275d112082bf"], Cell["\<\
use the first rule that matches, then rotate the list one position to the left\
\>", "TableText", ExpressionUUID->"f3062363-57cd-c345-982d-f5b22767a6cd"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "125f6f74-cc14-114b-9ca4-f90a2b42f938"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["f", "TI"], 
      RowBox[{",", " ", 
       RowBox[{"{", "}"}], ",", " "}], 
      StyleBox["n", "TI"], "}"}]], "TableText", ExpressionUUID->
     "e6a07758-44c8-8c44-a1b3-b3e479bc15a5"], Cell[TextData[{
     "replace the first ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "fe7f707c-0a78-2048-86cb-815905dab30e"],
     " elements with the result of applying ",
     Cell[BoxData[
      StyleBox["f", "TI"]], "InlineFormula", ExpressionUUID->
      "c09a8ab0-60f5-1645-b6ef-1b3c1e35d27e"],
     " to a list of them, then rotate one position to the left"
    }], "TableText", ExpressionUUID->
     "d7c3fc45-07d5-744d-a895-07034c46169d"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "e54a160d-e040-454c-b70a-0d9255285609"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["rules", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], "}"}]], "TableText", ExpressionUUID->
     "60f5bb85-5443-ac43-b0eb-2690b3ee5264"], Cell[TextData[{
     "use ",
     Cell[BoxData[
      StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
      "82a7c5ce-120a-b44b-b651-8bb17192cb61"],
     ", given as a single rule, a list of rules or ",
     Cell[BoxData[
      RowBox[{"{", 
       StyleBox["f", "TI"], 
       RowBox[{",", " ", 
        RowBox[{"{", "}"}], ",", " "}], 
       StyleBox["n", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
      "538fb3f4-d73f-3841-8eae-0fb8563f803f"],
     ", then rotate ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "54316ac5-57a1-2547-9fa2-f47517057156"],
     " positions to the left"
    }], "TableText", ExpressionUUID->"91b36b29-ae9b-4f4a-a1ce-ba259af0cd3b"]}
  }]], "2ColumnTableMod",
 CellID->776731504, ExpressionUUID->"1cc67368-9ef9-e748-8289-ca713c4dafb4"],

Cell[TextData[{
 "A list of rules given as the first argument is a single step, which uses \
the first rule that matches. To use the rules one at a time in turn, give \
each one its own list, as in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{"}], 
   StyleBox["lhs1", "TI"], 
   RowBox[{" ", 
    RowBox[{":>", " "}]}], 
   StyleBox["rhs1", "TI"], 
   RowBox[{"}", ",", " ", "{"}], 
   StyleBox["lhs2", "TI"], 
   RowBox[{" ", 
    RowBox[{":>", " "}]}], 
   StyleBox["rhs2", "TI"], 
   RowBox[{
    RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"7fea0711-a4fa-184c-8a45-d7a36faedb2e"],
 "."
}], "Notes",
 CellID->503724010, ExpressionUUID->"c089b9ca-f5b9-0542-9624-b9157a607579"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["lhsi", "TI"]], "InlineFormula", ExpressionUUID->
  "6db414d2-fbc3-5549-b423-5c584877c242"],
 " must be an explicit list. Each ",
 Cell[BoxData[
  StyleBox["rhsi", "TI"]], "InlineFormula", ExpressionUUID->
  "faa3943f-6b8d-bc44-82fd-028d38b54d4b"],
 " can be any expression that gives a list when it is evaluated. Rules can be \
given with ",
 Cell[BoxData[
  ButtonBox["Rule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Rule"]], "InlineFormula", ExpressionUUID->
  "966291fe-861a-8742-9a6a-181c930c782a"],
 " or ",
 Cell[BoxData[
  ButtonBox["RuleDelayed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/RuleDelayed"]], "InlineFormula", ExpressionUUID->
  "e0369277-eca6-f04a-bd2b-44b50619e57a"],
 "."
}], "Notes",
 CellID->490046043, ExpressionUUID->"527bcb86-b944-e14a-8794-6770cd72a3eb"],

Cell["\<\
If none of the rules match, the elements are not changed, but the list is \
still rotated.\
\>", "Notes",
 CellID->681008507, ExpressionUUID->"f2a867d5-38a4-6144-ae33-43ee63f5df9e"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "2a4c7fc5-030d-c44d-84e0-952ec5c038ca"],
 " rotates the list to the right. With ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "76c153fd-afa9-a446-a079-6933c472fc35"],
 " = 0, the list is not rotated."
}], "Notes",
 CellID->283168815, ExpressionUUID->"f9e4c560-1d21-0747-b4b5-2eeac6370cf4"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["f", "TI"], 
   RowBox[{",", " ", 
    RowBox[{"{", "}"}], ",", " "}], 
   StyleBox["n", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "0a0bca84-61c3-a94b-82cd-18e4b11f4988"],
 ", ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula", ExpressionUUID->
  "626ce988-5730-c146-acec-88158dceaaac"],
 " must return a list. The ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula", ExpressionUUID->
  "0f8a9a47-52d9-4f40-a48a-21b5c1ee439e"],
 " can also be given as an integer, which does not change the result."
}], "Notes",
 CellID->288242459, ExpressionUUID->"91b5f930-14a9-d347-a854-9524502314c6"],

Cell["The rules can change the length of the list.", "Notes",
 CellID->316063417, ExpressionUUID->"df2a9d58-1016-6941-9acf-881c29bf7bde"],

Cell[TextData[{
 "The elements of ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "08ffc6ed-49ce-454d-a476-a1253bb90ae4"],
 " can be any expressions."
}], "Notes",
 CellID->797711827, ExpressionUUID->"8593eb05-611d-194b-b378-8a0fbefe2476"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"], "[", 
   StyleBox["steps", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "5688e68f-a947-be4d-9b7a-6b5f0a334ebe"],
 " gives a list of length ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "7322c21f-9e00-124b-a1c3-444b2be80f7f"],
 "+1 whose first element is ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "5f0fad42-80bf-f44a-97c8-9b8a7ea95974"],
 "."
}], "Notes",
 CellID->787255654, ExpressionUUID->"d991035e-c15d-3c41-9167-92f633dc93ce"],

Cell["The following properties can be given:", "Notes",
 CellID->269157274, ExpressionUUID->"51781056-b693-514d-9c95-d70f184810e7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "a8e421b1-6e2b-cc49-be92-892c38621a0b"], Cell[
    BoxData["\"\<States\>\""], "TableText", ExpressionUUID->
     "e8d7b8a0-bd9e-9043-8c7f-4f6e7ccc1ab1"], Cell[
    "the list at each step (the default)", "TableText", ExpressionUUID->
     "a12f5b71-b5f8-c24d-a5bc-3554e15fa762"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "5029b48b-35b8-bf4a-aba1-225855d00e56"], Cell[
    BoxData["\"\<Rules\>\""], "TableText", ExpressionUUID->
     "23d42bc7-bbdb-9f49-a479-412d520e4d28"], Cell["\<\
the step specification that is applied to the list next, at each step\
\>", "TableText", ExpressionUUID->"ee4f1dc7-4205-2049-8a21-02a928c71850"]}
  }]], "2ColumnTableMod",
 CellID->517531026, ExpressionUUID->"7cd559d6-e2e2-9142-aca0-614734f2dc41"],

Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", "\"\<States\>\"", 
   RowBox[{",", " "}], "\"\<Rules\>\"", "}"}]], "InlineFormula", 
  ExpressionUUID->"934c607c-07e8-fe40-8f02-11f9038fba3e"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["list", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["step", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "5007953c-5ccc-a749-82f7-cc81eca618fd"],
 " at each step."
}], "Notes",
 CellID->251411682, ExpressionUUID->"3df47715-c360-fa45-8d7d-f8ee9cbab870"],

Cell["The following option can be given:", "Notes",
 CellID->457481787, ExpressionUUID->"78567d51-9291-eb40-8af7-f9a2d71b18ad"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "fbb6e11c-5ae5-c24d-9521-273fedf26555"], "\"\<LengthPreserving\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether the rules are meant to keep the length of the list the same (not \
currently used)\
\>", "TableText", ExpressionUUID->"61218cfe-8f61-d540-85d6-d9f7ae8bdc05"]}
  }]], "3ColumnTableMod",
 CellID->939663294, ExpressionUUID->"4dd1ea09-5402-ef4c-928e-669f9eb3333d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ObliviousRingMachineToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "dc8b9aef-2fb7-3b48-8f4c-223e38ade0b9"],
 " compiles an oblivious ring machine that keeps the length of the list the \
same to a cyclic tag system."
}], "Notes",
 CellID->162789467, ExpressionUUID->"bf320ba7-653e-1d4f-9d39-712bcbaad73e"]
}, Open  ]],

