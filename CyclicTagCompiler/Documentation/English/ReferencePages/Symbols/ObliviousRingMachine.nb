Notebook[{

Cell[CellGroupData[{
Cell["ObliviousRingMachine", "ObjectName",
 CellID->598742745, ExpressionUUID->"1910932b-ef23-bb48-a018-2823f5ad8e6d"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "19e7960e-ce93-284b-a114-c1eacdf2f73a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"], 
   RowBox[{"[", "{"}], 
   StyleBox["step1", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["step2", "TI"], 
   RowBox[{
    RowBox[{
     RowBox[{",", " ", "\[Ellipsis]"}], "}"}], ",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "48744087-29f4-d547-9f5f-53e5eae83f08"],
 " \[LineSeparator]",
 "gives a list of the results of ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "362e0301-ab56-d748-9550-7ac96faa10e2"],
 " steps of an oblivious ring machine that starts from the list ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "beb7dfba-029c-9345-bb7f-d267d3635f5c"],
 " and uses the step specifications ",
 Cell[BoxData[
  StyleBox["stepi", "TI"]], "InlineFormula", ExpressionUUID->
  "c17a4240-9109-9f43-bb85-082d8842a04f"],
 " in turn.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "23dd30cf-0b0b-3744-bd81-ffa2a90de390"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"], "[", 
   StyleBox["step", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "cbce9fe2-1d62-084e-ba16-d631f80f86f8"],
 " \[LineSeparator]",
 "uses the single step specification ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula", ExpressionUUID->
  "ecb8e0ee-b978-ed4e-a556-aa92c5dc4c96"],
 " at every step."
}], "Usage",
 CellID->701094568, ExpressionUUID->"0ae99052-5eaa-ba46-b748-aace9b5058af"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"]], 
  "InlineFormula", ExpressionUUID->"1f7c6e50-2228-c940-b41e-3a37955bd98a"],
 " is the Wolfram Function Repository function ",
 ButtonBox["ObliviousRingMachine",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/FunctionRepository/resources/\
ObliviousRingMachine"], None}],
 ". It is retrieved the first time it is used."
}], "Notes",
 CellID->406500649, ExpressionUUID->"e72e063a-ddd8-bb45-8011-c2ad494b7dba"],

Cell["\<\
An oblivious ring machine works on a list that is treated as a ring. At each \
step, it rewrites the elements at the start of the list and then rotates the \
list, so that other elements come to the start.\
\>", "Notes",
 CellID->80207865, ExpressionUUID->"bf03d878-3c11-2f4d-8c67-72f2a9e94a02"],

Cell["\<\
The machine is called oblivious because the sequence of rules and rotations \
is fixed in advance. It does not depend on the elements of the list.\
\>", "Notes",
 CellID->203326357, ExpressionUUID->"34d2a7d9-03ac-ae44-b939-97a305100b4e"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["stepi", "TI"]], "InlineFormula", ExpressionUUID->
  "53a6a2c1-4cac-3947-978a-dc5a55f6925b"],
 " are used in order, starting again from ",
 Cell[BoxData[
  StyleBox["step1", "TI"]], "InlineFormula", ExpressionUUID->
  "8d4059fb-36c7-9a41-8bd5-54b5f39ae883"],
 " after the last one."
}], "Notes",
 CellID->927771835, ExpressionUUID->"c059ca4a-955d-2f42-92c2-a3c63bea1447"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["stepi", "TI"]], "InlineFormula", ExpressionUUID->
  "87d43a83-8119-3c41-bb83-dd20d6814c65"],
 " can have the following forms:"
}], "Notes",
 CellID->579108117, ExpressionUUID->"084d50e2-f7e7-394c-92ba-7fff8e129909"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "bf9561a3-c415-ce43-837f-c5883bd6a3f5"], Cell[BoxData[
     RowBox[{
      StyleBox["lhs", "TI"], 
      RowBox[{" ", 
       RowBox[{":>", " "}]}], 
      StyleBox["rhs", "TI"]}]], "TableText", ExpressionUUID->
     "e36b055c-0165-404f-b155-90e0d128bd3e"], Cell[TextData[{
     "replace the elements at the start of the list that match ",
     Cell[BoxData[
      StyleBox["lhs", "TI"]], "InlineFormula", ExpressionUUID->
      "dca40bc9-39f7-1343-a5b4-79f0b619f065"],
     " with the elements of ",
     Cell[BoxData[
      StyleBox["rhs", "TI"]], "InlineFormula", ExpressionUUID->
      "e594c0f3-36d1-fa47-827f-f5cc1f564672"],
     ", then rotate the list one position to the left"
    }], "TableText", ExpressionUUID->
     "1aed3a9a-7efa-5d4d-80c1-e4ddc0a7a095"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "0c1aa69b-bdad-2b4e-a20e-4741c2af255c"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["lhs1", "TI"], 
      RowBox[{" ", 
       RowBox[{":>", " "}]}], 
      StyleBox["rhs1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["lhs2", "TI"], 
      RowBox[{" ", 
       RowBox[{":>", " "}]}], 
      StyleBox["rhs2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"2a247cae-a402-0542-b4ad-00fe38f65e67"], Cell["\<\
use the first rule that matches, then rotate the list one position to the left\
\>", "TableText", ExpressionUUID->"eb1a8e21-7c97-8349-accb-80028ea14e70"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "0ab7cae1-a65c-ea40-9704-5208be1ffb15"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["f", "TI"], 
      RowBox[{",", " ", 
       RowBox[{"{", "}"}], ",", " "}], 
      StyleBox["n", "TI"], "}"}]], "TableText", ExpressionUUID->
     "6cb73bcd-d02b-fc4e-9100-de917d5ba1d2"], Cell[TextData[{
     "replace the first ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "deffb074-caca-484a-af85-c503124b4649"],
     " elements with the result of applying ",
     Cell[BoxData[
      StyleBox["f", "TI"]], "InlineFormula", ExpressionUUID->
      "cfc711bb-b5f6-0e47-860b-2e0314f41c6e"],
     " to a list of them, then rotate one position to the left"
    }], "TableText", ExpressionUUID->
     "bc89b0f0-ce53-3a43-8f2d-cd75e88f43b5"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "0e7eed9e-5cde-2947-9308-770d9dc3b641"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["rules", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], "}"}]], "TableText", ExpressionUUID->
     "550e0847-942f-aa4a-97fa-6ab801a7dba9"], Cell[TextData[{
     "use ",
     Cell[BoxData[
      StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
      "5f057394-4317-af49-9cc7-5d79cf8ca8fa"],
     ", given as a single rule, a list of rules or ",
     Cell[BoxData[
      RowBox[{"{", 
       StyleBox["f", "TI"], 
       RowBox[{",", " ", 
        RowBox[{"{", "}"}], ",", " "}], 
       StyleBox["n", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
      "303e6cc2-8c2c-e940-9a4a-83fa8814a74a"],
     ", then rotate ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "6bf11199-02cc-9143-ab5e-ef51dbb366b6"],
     " positions to the left"
    }], "TableText", ExpressionUUID->"90fd28b5-de91-754c-995d-3404fe63f515"]}
  }]], "2ColumnTableMod",
 CellID->845086394, ExpressionUUID->"034c2769-7058-634f-9b08-b47398a1dd2f"],

Cell[TextData[{
 "A list of rules given as the first argument is a single step, which uses \
the first rule that matches. To use the rules one at a time in turn, give \
each one its own list, as in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{"}], 
   StyleBox["lhs1", "TI"], 
   RowBox[{" ", 
    RowBox[{":>", " "}]}], 
   StyleBox["rhs1", "TI"], 
   RowBox[{"}", ",", " ", "{"}], 
   StyleBox["lhs2", "TI"], 
   RowBox[{" ", 
    RowBox[{":>", " "}]}], 
   StyleBox["rhs2", "TI"], 
   RowBox[{
    RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]], "InlineFormula", 
  ExpressionUUID->"2bf37cdc-f133-664a-8af1-b9e987efc99d"],
 "."
}], "Notes",
 CellID->428604010, ExpressionUUID->"d2f858ff-47bf-1b4f-8578-0243bb8f4478"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["lhsi", "TI"]], "InlineFormula", ExpressionUUID->
  "657ac79a-2bdf-8b40-a30a-397a59c0ac3e"],
 " must be an explicit list. Each ",
 Cell[BoxData[
  StyleBox["rhsi", "TI"]], "InlineFormula", ExpressionUUID->
  "71544dd5-2e72-d740-a677-7429e4fb4d52"],
 " can be any expression that gives a list when it is evaluated. Rules can be \
given with ",
 Cell[BoxData[
  ButtonBox["Rule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Rule"]], "InlineFormula", ExpressionUUID->
  "6ef45d6b-03d9-c44c-b880-ee76f8183cdf"],
 " or ",
 Cell[BoxData[
  ButtonBox["RuleDelayed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/RuleDelayed"]], "InlineFormula", ExpressionUUID->
  "67378f78-fe3c-b045-b866-9c772d1b60da"],
 "."
}], "Notes",
 CellID->661946391, ExpressionUUID->"8c939212-7620-bb4c-821f-2ab1dc17e79d"],

Cell["\<\
If none of the rules match, the elements are not changed, but the list is \
still rotated.\
\>", "Notes",
 CellID->444454167, ExpressionUUID->"97bc7f9b-b862-4043-9e74-7c05d43b604a"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "5471ae7e-63e7-5444-a70b-b7b07ce49f04"],
 " rotates the list to the right. With ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "73bd762e-4a2c-004c-93a0-50d3a4ea38a2"],
 " = 0, the list is not rotated."
}], "Notes",
 CellID->790945370, ExpressionUUID->"b620ec03-ebc3-b545-84e5-32143cb01004"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["f", "TI"], 
   RowBox[{",", " ", 
    RowBox[{"{", "}"}], ",", " "}], 
   StyleBox["n", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "06642bae-6a12-e74f-8979-fb0e072b2b3a"],
 ", ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula", ExpressionUUID->
  "bfd68d40-03f3-5c47-a648-367b2b0577cf"],
 " must return a list. The ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula", ExpressionUUID->
  "0216fd89-bec3-5540-89d3-dee7f297198a"],
 " can also be given as an integer, which does not change the result."
}], "Notes",
 CellID->852317730, ExpressionUUID->"073e9a5e-eee5-6a46-b87f-e850a122cd67"],

Cell["The rules can change the length of the list.", "Notes",
 CellID->233504404, ExpressionUUID->"df8c7de2-3044-294e-ae14-c3a765391826"],

Cell[TextData[{
 "The elements of ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "7ec5634e-6c5c-d540-b4a2-e81814668e0a"],
 " can be any expressions."
}], "Notes",
 CellID->175576939, ExpressionUUID->"7840d779-82cb-f447-9b64-989fe8bfaec7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachine",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"], "[", 
   StyleBox["steps", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "295495c3-ca83-f549-a825-68bca64adce5"],
 " gives a list of length ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "42d45954-24b8-4540-bbb2-9bd2fe7c8eb6"],
 "+1 whose first element is ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "3c86ccf2-0799-f745-b74e-e6d8678bf337"],
 "."
}], "Notes",
 CellID->17467715, ExpressionUUID->"dfcd306d-74ad-b447-87a7-5b4a3cccff36"],

Cell["The following options can be given:", "Notes",
 CellID->251705400, ExpressionUUID->"2b5d8831-1d0f-2d46-803c-6a28768b57be"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "2bc34e4f-9f1e-324d-ad98-2a926d6bbf86"], "\"\<IncludeRules\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to give each list together with the step specification that is \
applied to it next\
\>", "TableText", ExpressionUUID->"dad04d6d-b380-034b-aca4-d54df0d8c5f3"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "d5600b76-34f2-d749-8998-65e6f65dcec0"], "\"\<LengthPreserving\>\"", 
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"], Cell["\<\
whether the rules are meant to keep the length of the list the same (not \
currently used)\
\>", "TableText", ExpressionUUID->"acc70b55-3c82-5348-977a-d4da35c4a0fb"]}
  }]], "3ColumnTableMod",
 CellID->970487455, ExpressionUUID->"13bfd785-5c5d-dd46-8277-db965f94eb77"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeRules\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "b2954d41-88dd-fa4e-93a6-27d4a4415b75"],
 ", each element of the result has the form ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["list", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "cea11133-1317-554e-8f61-25ec27f8aeb7"],
 ", where ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "399da4fa-56b0-0448-bb96-f30065fbab2a"],
 " is the step that is applied to ",
 Cell[BoxData[
  StyleBox["list", "TI"]], "InlineFormula", ExpressionUUID->
  "63cac726-277a-3048-a7a8-65493e12b923"],
 " next."
}], "Notes",
 CellID->549968945, ExpressionUUID->"0723b941-f7dd-8946-8f2c-500aeb6b6487"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ObliviousRingMachineToCyclicTagRule",
   BaseStyle->"Link",
