Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Tape\>\"", ",", " ", "\"\<Rule\>\""}], "}"}], "]"}], "[", 
    RowBox[{"ObliviousRingMachine", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
            RowBox[{"{", 
             RowBox[{"y", ",", " ", "x"}], "}"}]}], "}"}], ",", " ", "2"}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
          RowBox[{"{", "x", "}"}]}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
       "}"}], ",", " ", "7", ",", " ", 
      RowBox[{"\"\<IncludeRules\>\"", " ", "->", " ", "True"}]}], "]"}], 
    "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->302013044, ExpressionUUID->"cce5a52d-7a67-7840-97d2-2386817cf402"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Tape\"\>", "\<\"Rule\"\>"},
    {
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", "y_"}], "}"}], "\[RuleDelayed]", 
         RowBox[{"{", 
          RowBox[{"y", ",", "x"}], "}"}]}], "}"}], ",", "2"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "5", ",", "2", ",", "1"}], "}"}], 
     RowBox[{"{", 
