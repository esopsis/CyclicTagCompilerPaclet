             RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
             RowBox[{"{", "x", "}"}]}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"Range", "[", "n", "]"}], ",", " ", "1000"}], "]"}]}], "}"}],
      ",", " ", 
