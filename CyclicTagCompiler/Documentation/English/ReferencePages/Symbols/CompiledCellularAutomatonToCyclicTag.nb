Cell["CompiledCellularAutomatonToCyclicTag", "ObjectName",
 CellID->966582584, ExpressionUUID->"15862b7d-413c-1349-80fa-f3c458bfb3a6"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "7997c740-f843-5d48-9dc7-ac24532d17f0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledCellularAutomatonToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "37476a72-51b2-2041-9100-80f9f71f3e22"],
 " \[LineSeparator]",
 "gives a function that runs the cellular automaton ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "f9bd7c63-da20-734f-8f48-40ca7766f705"],
 " on a tape of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "68ac3c55-921d-a440-9cdc-761411f4e1cc"],
 " by compiling it to a cyclic tag system, running that system and decoding \
the result.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "2d65b6a3-8b47-7b48-a772-6bc31fbbf27e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledCellularAutomatonToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeStates", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "a8b111b0-aec6-0340-ad44-68ce1ffe335e"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "11b7e60d-39ae-104a-a43f-c80eb1e7cb3c"],
 " tape symbols.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "8ce2daff-82dc-e94a-9275-35f7651dec14"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledCellularAutomatonToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag"], 
   RowBox[{
    RowBox[{"[", "\[Ellipsis]", "]"}], "["}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["steps", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "a61f79e0-b635-6e43-8f7e-f06b2dd00f0a"],
 " \[LineSeparator]",
 "runs the cellular automaton from ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "3f311baf-b058-4341-aaf0-99df9492365a"],
 " for ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula", ExpressionUUID->
  "2acdabc8-a0b9-fe46-9bf4-aee713fb676a"],
 " steps."
}], "Usage",
 CellID->504335179, ExpressionUUID->"d82a2fd5-a1c8-904e-9de2-3a5f56412a5f"],

Cell[TextData[{
 "The cellular automaton ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "11b3f493-67f3-c649-a8bd-aa95a30842c4"],
 " can have the following forms:"
}], "Notes",
 CellID->895353267, ExpressionUUID->"d72cb37b-56a2-f14b-9549-e413cfa99889"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "92473e98-f71a-1348-9271-aa0cd073c8f9"], Cell[BoxData[
     StyleBox["n", "TI"]], "TableText", ExpressionUUID->
     "7d42f331-73f8-694e-a892-46cc573df9bc"], Cell[TextData[{
     "the elementary cellular automaton with rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "4c694299-3c5a-3144-b251-38796ef5c4b3"],
     " (2 colors, range 1)"
    }], "TableText", ExpressionUUID->
     "e5710383-75b0-2b4c-9be6-7ab14ec95f0b"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "e874afdc-e845-b745-99a5-f292f7091ecf"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["n", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], "}"}]], "TableText", ExpressionUUID->
     "06cd6882-30ec-7840-8bc1-06fe997efbb2"], Cell[TextData[{
     "rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "900e0bd4-df57-4c46-8df7-9cc9a8536f3e"],
     " with ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "4ee661c5-a3a4-0b45-adb5-3b88488b7b61"],
     " colors and range 1"
    }], "TableText", ExpressionUUID->
     "d36512e3-7938-6044-a516-0e6cfe5b3ef8"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "fdb39db2-33e0-dc42-8721-d38dce772af0"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["n", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["r", "TI"], "}"}]], "TableText", ExpressionUUID->
     "558e93a1-d3de-9647-8fc3-838e81bf72f9"], Cell[TextData[{
     "rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "61bdd0df-f4f0-d04d-aea4-b7b9064bc6a4"],
     " with ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "3b5ee292-6fdb-d444-bd70-a0b77da5e13d"],
     " colors and range ",
     Cell[BoxData[
      StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
      "f2c1da37-1f43-ec42-a67c-71a7fe6c5f4b"]
    }], "TableText", ExpressionUUID->
     "4570019d-182d-aa47-b0ea-8eca12af67f9"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "4059b721-fe63-434e-af2f-87ed7f0b1557"], Cell[BoxData[
     RowBox[{
      RowBox[{"{", "{"}], 
      StyleBox["c1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["c2", "TI"], 
      RowBox[{
       RowBox[{
        RowBox[{",", " ", "\[Ellipsis]"}], "}"}], " ", "->", " "}], 
      StyleBox["c", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"cc9ff76d-9443-844e-8277-2b4da3fdec4c"], Cell[TextData[{
     "explicit rules giving the new color ",
     Cell[BoxData[
      StyleBox["c", "TI"]], "InlineFormula", ExpressionUUID->
      "e34f6f55-5fbd-dd4a-9a8a-6703d22bd539"],
     " of a cell from the colors of its neighborhood"
    }], "TableText", ExpressionUUID->"58b9ed6d-8635-4e47-bf9c-8ca0c3dc975f"]}
  }]], "2ColumnTableMod",
 CellID->953322606, ExpressionUUID->"ce449054-3106-2443-8246-3e553b11faf6"],

Cell[TextData[{
 "Rule numbers are as in ",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula", 
  ExpressionUUID->"3a6b80ab-3bc1-3a49-b3d5-33b53d77a9e7"],
 ". The range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "5d818d72-899d-af45-bca2-12a0484f5b69"],
 " can be a positive integer or half-integer; a cell's neighborhood has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "a330d1e1-5f7c-ef4e-af52-a637ae3c75bf"],
 " + 1 cells."
}], "Notes",
 CellID->100621534, ExpressionUUID->"b17f3da4-0514-554e-910e-b98ab76e4ecc"],

Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->480994756, ExpressionUUID->"fad3d3fe-2d47-a841-81fe-229ec2d3d7e4"],

Cell[TextData[{
 "The cyclic tag rule is compiled once, when ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompiledCellularAutomatonToCyclicTag",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "c496df82-3c5e-ed4c-935a-a89fcf86acda"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "dc60c855-2b32-764b-9caa-f49d514a5c6a"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula", ExpressionUUID->
  "5be96964-e83a-d644-8da6-5adc13621d99"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"c54a3483-5069-bd45-b37d-1ac7a01ddbe5"],
 ", and decodes its evolution."
}], "Notes",
 CellID->908366149, ExpressionUUID->"6464dd8c-2e4e-d047-b3d4-691b801e777d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "e6b4d935-8a9d-3644-b737-c6671a131065"],
 " must have ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "1cf18c0f-1975-9240-bc0e-a5cf29e97bad"],
 " cells."
}], "Notes",
 CellID->90235160, ExpressionUUID->"d286a3f0-e5e9-b349-ae32-399c7a14e692"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "a1ae1639-455e-3f4a-a30a-16a6e8fb804f"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "4efc0007-5e65-b242-b3bc-4d2a5b1e8ea9"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->568462282, ExpressionUUID->"6c0cc218-e60e-c34e-ae1a-dc558eba46b7"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "c0beeefa-3a5d-0349-a320-0ec4fb09ab12"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "a3619d79-6ff3-404f-af94-d05063f081cc"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "e2cb490f-0ab1-d14d-b2ed-4ae520065cc3"],
 " cells, as given by ",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula", 
  ExpressionUUID->"8965bf6a-978c-c54a-9d4a-0b4f4e2424f4"],
 ", for any number of steps."
}], "Notes",
 CellID->174878822, ExpressionUUID->"b6cc7267-1c4f-7649-aee7-a6ce40f9ced7"],

Cell["The following options can be given:", "Notes",
 CellID->724639951, ExpressionUUID->"99c09d0c-1059-294c-9f03-521669618b23"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "3fa54b8f-c40e-ed43-b52d-955c2e7e2419"], "\"\<InfiniteSteps\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText", ExpressionUUID->"da220ec4-aaee-3d43-901f-0e7316a77eef"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "c00f8211-05e0-d849-961c-867b9704ac10"], "\"\<Mod6CyclicTag\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
\>", "TableText", ExpressionUUID->"82513e0c-25c5-3a4c-828d-118d5da4b2e2"]}
  }]], "3ColumnTableMod",
 CellID->247337540, ExpressionUUID->"b32f97f3-a52b-8842-a36e-e9bc6b8065c3"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Mod6CyclicTag\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "8f04b15a-952a-1b42-99d8-9cc1f4a498a4"],
 " compiles with ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"704d1871-d1dc-1746-8bf5-fab56d624c69"],
 "."
}], "Notes",
 CellID->186814081, ExpressionUUID->"f17083d7-a577-fc43-b2f9-a2473af987ac"]
}, Open  ]],

