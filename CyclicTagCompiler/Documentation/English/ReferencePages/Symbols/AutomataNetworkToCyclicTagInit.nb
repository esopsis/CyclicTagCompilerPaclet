Cell["Encode the states of a network of 3 automata:", "ExampleText",
 CellID->694269768, ExpressionUUID->"e461d277-726c-b347-814d-18bd305b9506"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
         RowBox[{"1", " ", "-", " ", "x"}]}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"x", " ", "y"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "3"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->364394021, ExpressionUUID->"fa268c2e-48f2-8043-b9a4-8124fae9f3db"],

