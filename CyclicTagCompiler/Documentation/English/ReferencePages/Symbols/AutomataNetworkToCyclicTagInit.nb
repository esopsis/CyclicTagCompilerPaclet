Cell["\<\
Encode the states of a network with 3 states; give the number of states:\
\>", "ExampleText",
 CellID->58749749, ExpressionUUID->"7125dccb-0755-b146-8878-b97f6d2bab50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net3", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "3"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",", " ", "1", ",",
            " ", "2", ",", " ", "2", ",", " ", "1", ",", " ", "0", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",",
            " ", "0", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "1"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "2"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "1", ",", " ", "2", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "2", "}"}], " ", "->", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "1", "}"}], " ", "->", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "0", "}"}], " ", "->", " ", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}], ",", " ", "3"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->682471619, ExpressionUUID->"281542e4-780d-514e-8da7-b39e839215fd"],

