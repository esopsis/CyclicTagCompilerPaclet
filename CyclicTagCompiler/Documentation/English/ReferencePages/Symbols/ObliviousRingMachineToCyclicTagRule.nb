Cell[CellGroupData[{
Cell["ObliviousRingMachineToCyclicTagRule", "ObjectName",
 CellID->773869678, ExpressionUUID->"dd21bf68-203b-174d-b151-93174e6b06c2"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "651c78fc-9cd4-804c-affe-b94a7f110abd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachineToCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "fad0c4d8-6eee-e64c-a46c-e272bc3702d4"],
 " \[LineSeparator]",
 "compiles the oblivious ring machine ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "42da39ce-2ff2-4741-a332-09decc52ae80"],
 " for a tape of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "9b47dcec-bcda-4040-bad0-cb44162cf2e0"],
 " to a cyclic tag rule.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "e70f9e8d-42b4-1649-a2ae-a0d2c8d911c3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachineToCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeStates", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "f690d387-b5a6-4740-9a0b-31c859755749"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "ae036a20-aa88-df4c-9757-0c4b8c60965a"],
 " tape symbols."
}], "Usage",
 CellID->165746789, ExpressionUUID->"558dc64e-07f0-6b4c-89ec-35b698353361"],

Cell["\<\
An oblivious ring machine has a circular tape and a list of steps that it \
uses in turn, whatever is on the tape. Each step replaces the first few \
symbols of the tape using rules, and then rotates the tape to the left by an \
offset.\
\>", "Notes",
 CellID->90681241, ExpressionUUID->"10721ec0-c6a0-3946-81b8-d270d4f83df5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachineToCyclicTagRule",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeStates", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "1340b06b-43cc-5249-9324-3a86f5e2b7d1"],
 " compiles the ring machine to an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "00fe8a87-787f-ce4e-800f-283f1168398b"],
 "-ary cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachineToNaryCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToNaryCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "a1dda86b-e3db-1f41-a5d9-8493995fd593"],
 " and then to a cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["NaryCyclicTagToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "0436d366-2b7a-7641-beeb-11e9d050604d"],
 "."
}], "Notes",
 CellID->335408267, ExpressionUUID->"e362a809-a616-4540-9333-742b22e30a0e"],

Cell[TextData[{
 "The ring machine ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "77d1ac03-4650-c142-819e-17f0a68ebfb3"],
 " can have the following forms, as in ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"]], 
  "InlineFormula", ExpressionUUID->"f8c1f188-2c68-1346-91ce-8d8d6a8950a1"],
 ":"
}], "Notes",
 CellID->38112220, ExpressionUUID->"ce87ff7c-039b-3046-a1bb-02583281877a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "c079f9a5-5826-e543-a8bf-2c1d8fd205b1"], Cell[BoxData[
     RowBox[{
      StyleBox["lhs", "TI"], 
      RowBox[{" ", 
       RowBox[{"->", " "}]}], 
      StyleBox["rhs", "TI"]}]], "TableText", ExpressionUUID->
     "4f0ba6fe-047c-1046-9075-2a2501fcce56"], Cell[
    "a single rule, used at every step", "TableText", ExpressionUUID->
     "c259079a-7358-9d4a-939f-269a6fd94c95"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "d4984eae-7b66-164f-9103-31cda81449b0"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["rule1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["rule2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"a5cfa27d-bf27-5349-a676-facd70da4c0f"], Cell[
    "a single step that uses whichever rule matches", "TableText", 
     ExpressionUUID->"ce9ccb59-291a-a047-9c8a-1f58451681e7"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "088971ca-057b-e14a-afdb-380d3a2bb340"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["f", "TI"], 
      RowBox[{",", " ", 
       RowBox[{"{", "}"}], ",", " "}], 
      StyleBox["n", "TI"], "}"}]], "TableText", ExpressionUUID->
     "c525097b-eda3-f841-a272-73a3781757af"], Cell[TextData[{
     "a step that replaces the first ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "0ef70d28-e3ef-2c4b-a077-daaf2df6ca62"],
     " symbols by ",
     Cell[BoxData[
      StyleBox["f", "TI"]], "InlineFormula", ExpressionUUID->
      "a1934d5c-e2f6-ff4a-bc26-d730842d233f"],
     " applied to the list of them"
    }], "TableText", ExpressionUUID->
     "0a5a1ff0-821d-9742-845f-1c88ed959f99"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "15f16684-bf8d-c149-92c8-e0f619171489"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["step", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], "}"}]], "TableText", ExpressionUUID->
     "16a62526-f94d-8e43-9a8f-524922c4a9f0"], Cell[TextData[{
     "a step followed by a rotation of the tape by ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "2a1aa8b7-697b-9345-98d8-0a14bc5f8769"],
     " cells, instead of 1"
    }], "TableText", ExpressionUUID->
     "80abfd67-e664-8c40-8fdf-e6a2e456625b"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "7d2b0318-ecaf-954c-bb23-6c0377570530"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["step1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["step2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"0b5123cb-a15d-5c46-9a6a-f0a0ec846901"], Cell[
    "a list of steps used in turn", "TableText", ExpressionUUID->
     "fef00072-b529-d94c-a81a-1da9062982d3"]}
  }]], "2ColumnTableMod",
 CellID->484159051, ExpressionUUID->"d0b0f73f-20c3-be4e-b69b-6abd015cf913"],

Cell["A window of symbols that no rule matches is left unchanged.", "Notes",
 CellID->13507354, ExpressionUUID->"fc2441ac-d192-f142-8b53-938a1ac35ab3"],

Cell["\<\
To be compiled, every step must replace its window by the same number of \
symbols, all the rules of a step must have left-hand sides of the same \
length, and offsets must not be negative.\
\>", "Notes",
 CellID->274010169, ExpressionUUID->"54592590-e11e-2542-ab72-1158f137f0f2"],

Cell[TextData[{
 "The ring machine uses the symbols from 0 to ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula", ExpressionUUID->
  "f01895c8-c579-2547-a2ff-95590f6a1817"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula", ExpressionUUID->
  "5ce479e3-74da-5043-a431-7a2e4eff6edb"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "a49c2c2a-81e1-f247-8d9a-abb3851a6b92"],
 " and one more than the largest symbol written explicitly in the rules. \
Symbols computed by a right-hand side such as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mod",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Mod"], "[", 
   StyleBox["x", "TI"], 
   RowBox[{" ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}], "]"}]}]], "InlineFormula", 
  ExpressionUUID->"3026e0be-68f2-144a-a529-8a5aa0d77684"],
 " are not counted, so give ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "5e73216c-85bc-974c-a2f3-03b6c3771679"],
 " for rules like that. The default value of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "c87cd011-ce2c-644f-98ed-9f8ab7030dbf"],
 " is 2."
}], "Notes",
 CellID->787543564, ExpressionUUID->"9693f64d-871c-b641-a5bb-14172e3b3050"],

Cell[TextData[{
 "The compiled rule only works for tapes of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "83ff7633-8e45-964a-97e8-5b9a662d9dab"],
 "."
}], "Notes",
 CellID->607957227, ExpressionUUID->"4c37014d-c711-3a45-b969-5aef921fd874"],

Cell[TextData[{
 "Run the cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
  "InlineFormula", ExpressionUUID->"1895a2a6-1d10-d44a-8642-2f62412890b4"],
 ", starting from ",
 Cell[BoxData[
