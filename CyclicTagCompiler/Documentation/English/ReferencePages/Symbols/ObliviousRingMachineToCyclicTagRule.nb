  "868be864-6818-d842-8a7c-340417be495c"],
 " for ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ObliviousRingMachineToCyclicTagSteps",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagSteps"], "[", 
   StyleBox["t", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeStates", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "a09dacf3-b77a-2f4c-ac7b-1235165d3234"],
 " steps, and decode its evolution with ",
 Cell[BoxData[
  ButtonBox["DecodeCyclicTagToObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToObliviousRingMachine"]], "InlineFormula", ExpressionUUID->
  "a507c55e-e7b8-dd4b-bc9b-4208953b1741"],
 "."
}], "Notes",
 CellID->712829769, ExpressionUUID->"793cf4cb-0982-6543-8103-d5ee0724549d"],

Cell["The following option can be given:", "Notes",
 CellID->441332887, ExpressionUUID->"f631d887-9828-bf46-88d7-a7279c739a8c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "44b316a9-2cb2-7f45-a551-4f3ca1b4f833"], "\"\<TargetSystem\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "the kind of cyclic tag system to compile to", "TableText", 
     ExpressionUUID->"47ed2301-c78b-744b-935e-8d1e1fe6cb2a"]}
  }]], "3ColumnTableMod",
 CellID->180962356, ExpressionUUID->"2db4da02-970f-e04a-9f6f-b4c6861f27ea"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"cac63aed-f441-8845-9aed-2d2ad87d1558"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["Automatic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Automatic"]}]], "InlineFormula", ExpressionUUID->
  "1fb5a35b-bca5-f94e-9192-2646d6ca6783"],
 " uses as few cells as possible."
}], "Notes",
 CellID->336841787, ExpressionUUID->"aa1a6b41-82bf-ce4d-9cc0-8e5d6b8453c3"],

Cell[TextData[{
 "The rule, initial condition, step count and decoding of one compilation \
must all use the same number of symbols and the same ",
 Cell[BoxData["\"\<TargetSystem\>\""], "InlineFormula", ExpressionUUID->
  "8ef5a688-673a-124f-9628-9ab61db22e76"],
 " setting."
}], "Notes",
 CellID->626997659, ExpressionUUID->"42dcb73e-56d5-8e43-a89a-98acb03e929f"]
}, Open  ]],

