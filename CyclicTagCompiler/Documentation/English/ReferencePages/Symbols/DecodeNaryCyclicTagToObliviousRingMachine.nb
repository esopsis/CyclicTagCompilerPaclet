Cell["\<\
The tapes at which a ring machine step ends are the ring machine's tapes, so \
decoding keeps just those.\
\>", "Notes",
 CellID->211028077, ExpressionUUID->"109b1abd-e9aa-654f-b6f0-1bf9db125a30"],

Cell[TextData[{
 "The tape length is taken from the first tape in ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "90e37311-684f-ac4d-948f-c2cb82760dd4"],
 ". Give the same ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "6fa7b371-10da-e945-9c3c-525bfb2d80ea"],
 " as to ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachineToNaryCyclicTagRule",
   BaseStyle->"Link",
