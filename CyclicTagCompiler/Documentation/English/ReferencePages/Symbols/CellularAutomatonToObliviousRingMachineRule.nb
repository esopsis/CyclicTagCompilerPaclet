Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "7bf3b66c-c553-8947-9be3-820d27825d17"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CellularAutomatonToObliviousRingMachineRule",
