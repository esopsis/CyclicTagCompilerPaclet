  "8a1e0b29-eb4d-f443-96fd-eac478e4902d"],
 " \[LineSeparator]",
 "uses at least ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "bc5ada46-57da-8141-8994-7264c049ec7b"],
 " tape symbols."
}], "Usage",
 CellID->576003804, ExpressionUUID->"1a30b8f4-aea3-ce42-ac5b-e8150aa12bd3"],

Cell[TextData[{
 "The cellular automaton ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "09c9af27-9235-5e40-9f36-2803382fdd38"],
 " can have the following forms:"
}], "Notes",
 CellID->261750759, ExpressionUUID->"9c2f8633-8fd0-554d-8a04-71bb4268c0e2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "90c64116-bbd6-cc43-b1e8-f3b754da9c9d"], Cell[BoxData[
     StyleBox["n", "TI"]], "TableText", ExpressionUUID->
     "d511b988-94d9-0d47-8aba-b8bcdf7b5b3d"], Cell[TextData[{
     "the elementary cellular automaton with rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "8add2a27-c2f3-9549-82e7-3fb504cd6d95"],
     " (2 colors, range 1)"
    }], "TableText", ExpressionUUID->
     "1a77c44b-1039-5d48-87d0-ab40ad365069"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "9dfb69a2-d793-104b-839d-bd2c02f06eb6"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["n", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], "}"}]], "TableText", ExpressionUUID->
     "1ee9a9a5-a396-b648-9bb8-5051c1fd7985"], Cell[TextData[{
     "rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "51699dc1-17ef-2543-81a3-de56e5ac754e"],
     " with ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "41378be3-1cc4-7b4d-b609-95e0a80a6c8a"],
     " colors and range 1"
    }], "TableText", ExpressionUUID->
     "5621405a-697f-4e47-b380-1a0db432c7d6"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "ba4e9124-83b4-3b48-b1e0-3ba1868931c5"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["n", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["r", "TI"], "}"}]], "TableText", ExpressionUUID->
     "be4943a2-7ad5-334f-8504-06dc0eec491e"], Cell[TextData[{
     "rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "e4a10f61-b2c6-d348-9d9a-8a7464b9d7e0"],
     " with ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "379a3639-4d55-594f-8435-a64a55c352d9"],
     " colors and range ",
     Cell[BoxData[
      StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
      "0322c024-49bf-964d-90cb-70bfa05e4b73"]
    }], "TableText", ExpressionUUID->
     "6f148a81-e516-5146-8dca-0b5e9f4e4bf5"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "939b10d5-63f3-3947-ad2b-9c5c9b47d383"], Cell[BoxData[
     RowBox[{
      RowBox[{"{", "{"}], 
      StyleBox["c1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["c2", "TI"], 
      RowBox[{
       RowBox[{
        RowBox[{",", " ", "\[Ellipsis]"}], "}"}], " ", "->", " "}], 
      StyleBox["c", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"ee60d8ed-a3d2-544f-bffa-c25386d1a2c4"], Cell[TextData[{
     "explicit rules giving the new color ",
     Cell[BoxData[
      StyleBox["c", "TI"]], "InlineFormula", ExpressionUUID->
      "ff61455a-425e-8140-b7a2-1fef4c65a5ec"],
     " of a cell from the colors of its neighborhood"
    }], "TableText", ExpressionUUID->"91c23656-be95-404c-a616-f0e8b4d7b994"]}
  }]], "2ColumnTableMod",
 CellID->732882098, ExpressionUUID->"c69d0905-f18e-3a41-beb9-2da8dc6b933a"],

Cell[TextData[{
 "Rule numbers are as in ",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula", 
  ExpressionUUID->"7a4b000e-2701-4e48-8997-62c614736154"],
 ". The range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "d029f40e-7322-cd43-9bf9-b40ea76aa20d"],
 " can be a positive integer or half-integer; a cell's neighborhood has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "5a9f9186-d36b-5d45-8260-048aa6201292"],
 " + 1 cells."
}], "Notes",
 CellID->580663496, ExpressionUUID->"aa8fa7d6-1eb2-0440-b3a9-426c9cc058dd"],

Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->106419818, ExpressionUUID->"1a0b2c81-4b10-ce48-9da3-f5a69c4d9938"],

Cell[TextData[{
 "The ring machine sweeps along the tape. At each step it reads a \
neighborhood, writes the cell's new color into the first cell of the \
neighborhood, and moves on by one cell. After a sweep of the whole tape, the \
new row of the cellular automaton is on the tape, shifted by ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "cc6b2f59-1c70-3040-bd77-705569fe9e1d"],
 " cells."
}], "Notes",
 CellID->949888204, ExpressionUUID->"ede3f209-31a0-ff42-9534-7949aed6133b"],

Cell[TextData[{
 "By default, the ring machine rule is a single step and does not depend on \
",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "ef37e03e-c963-914c-b4eb-d278ea63aa72"],
 "."
}], "Notes",
 CellID->719714773, ExpressionUUID->"23546192-a43c-1449-8987-c1e43fe953ff"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "7fde5762-03ef-8a49-b9d7-74c2b1554363"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "ddff9bb3-e3fb-2740-9958-407c40ff31d9"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->70910718, ExpressionUUID->"094bb3df-815a-8c4f-82f1-34cc1795f0aa"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "2d22921d-a7ec-694c-bd9c-2409f720fccf"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "b2b14557-4b6b-3644-b015-80af5109359b"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "c50a7bce-668b-664a-8557-5f1584cd1a70"],
 " cells, as given by ",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula", 
  ExpressionUUID->"54b97a9b-f2b9-3a42-9d02-62483fd8734b"],
 ", for any number of steps."
}], "Notes",
 CellID->153579744, ExpressionUUID->"b43f31ef-3157-f841-bd13-7969764402e2"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "2b1115b7-f1f9-2c44-9dee-1d753346e90e"],
 ", ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "c2479e37-1079-2c4f-a544-33902dc558b9"],
 " must be given. The ring machine rule then has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "e7c7ce35-6329-ff41-8523-bb99ebb41c69"],
 " steps that copy the colors of the wrapped-around cells, followed by ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "455fcee4-df37-424e-b199-7debccf01da4"],
 " steps that update the cells."
}], "Notes",
 CellID->892160944, ExpressionUUID->"1068384b-fa50-b441-9a7a-3021beaa7095"],

Cell["The following option can be given:", "Notes",
 CellID->347061856, ExpressionUUID->"d5e03916-d390-b54f-92ad-90043a6fd16a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "d41ebf5c-8e0f-324b-ac9c-1c73b22327be"], "\"\<InfiniteSteps\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText", ExpressionUUID->"b310f8b7-7215-7e4e-9116-67d887f22e09"]}
  }]], "3ColumnTableMod",
 CellID->17362922, ExpressionUUID->"4faa49b0-ad4f-614d-8b16-d5ce6944aa95"],

Cell[TextData[{
 "Use the same ",
 Cell[BoxData["\"\<InfiniteSteps\>\""], "InlineFormula", ExpressionUUID->
  "ab4938b6-eaa3-4241-847b-013754aa7168"],
 " setting for the initial condition, step count and decoding."
}], "Notes",
 CellID->284766770, ExpressionUUID->"1e04b00c-d0cc-6d43-be7f-e53f1094eb2f"]
}, Open  ]],

