CellularAutomatonToObliviousRingMachineRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "b4bf1354-1020-2440-8d15-a1a5da04d01b"],
 " \[LineSeparator]",
 "gives a rule for a tape of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "2708e151-3254-c94a-90d0-6567e1f3fc20"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "32b41579-44b3-8742-982a-a2fb7097520a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CellularAutomatonToObliviousRingMachineRule",
