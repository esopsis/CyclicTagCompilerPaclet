 "."
}], "Usage",
 CellID->565564582, ExpressionUUID->"7d21360a-070f-f742-8249-6c7b88b37904"],

Cell[TextData[{
 "Each step of the cellular automaton is one sweep of the ring machine around \
its tape, so by default ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["CellularAutomatonToObliviousRingMachineSteps",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToObliviousRingMachineSteps"], "[", 
   StyleBox["steps", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "66bf62bc-b0a7-c64a-a1ec-6d8d053317bc"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["steps", "TI"], " ", 
   StyleBox["tapeLength", "TI"]}]], "InlineFormula", ExpressionUUID->
  "5ad7d29a-b3a1-804d-86ea-e2da5a800c32"],
 "."
}], "Notes",
 CellID->730017395, ExpressionUUID->"a07236c1-dce6-9241-a2c5-7e8b4fe4f916"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "ac5896a8-2c3b-7a4f-a12f-8ad19a746622"],
 ", the tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "5be74cff-dab4-ce45-b6f0-7b821e6cc007"],
 " more cells, and each sweep has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "1382c9da-7981-8146-b2d0-7a32f5c4e1e9"],
 " more steps."
}], "Notes",
 CellID->739205006, ExpressionUUID->"5df5c65c-e47d-b542-a91c-9f01779ac9ae"],

