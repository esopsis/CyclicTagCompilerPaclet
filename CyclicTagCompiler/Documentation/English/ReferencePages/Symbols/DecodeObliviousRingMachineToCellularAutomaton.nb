Notebook[{

Cell[CellGroupData[{
Cell["DecodeObliviousRingMachineToCellularAutomaton", "ObjectName",
 CellID->880805567, ExpressionUUID->"4d2d7a28-bf79-6442-8179-e5e9ea35d26d"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "f37daa1a-b069-134c-a016-c72265bac1c4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeObliviousRingMachineToCellularAutomaton",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeObliviousRingMachineToCellularAutomaton"], "[", 
   StyleBox["history", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "f3e8bb90-041b-4d45-9c5d-68c9506c2238"],
 " \[LineSeparator]",
 "decodes the oblivious ring machine evolution ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "93638ff6-3bd6-3c44-8a57-a0c09eda8abd"],
 " to the evolution of the range-1 cellular automaton it emulates.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "79754373-cc70-df43-8859-c70479953726"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DecodeObliviousRingMachineToCellularAutomaton",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeObliviousRingMachineToCellularAutomaton"], "[", 
   StyleBox["history", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["r", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "36f95145-35cd-8041-a065-d22df3883e51"],
 " \[LineSeparator]",
 "decodes ",
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "991a5352-c8d7-8b43-a5b9-d90aa7dd15d7"],
 " for a cellular automaton of range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "2bc68033-1032-bd40-ac5a-e7634b41880c"],
 "."
}], "Usage",
 CellID->61804522, ExpressionUUID->"1dfe37f2-42a8-9d4d-80af-fc1dbbfd7798"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula", ExpressionUUID->
  "8178d7c0-9dfd-b248-8042-8068d48f776a"],
 " is a list of ring machine tapes, one for each step, as given by ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachine",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine"]], 
  "InlineFormula", ExpressionUUID->"294cd22d-112c-564e-8ad8-a6c6f19328e7"],
 ". A cellular automaton step ends after each sweep of the tape."
}], "Notes",
 CellID->82542479, ExpressionUUID->"fecdeda3-64d3-af4a-acb7-64783030dc7a"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "303bdfac-3eb8-f940-a0b9-853d32fc846c"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "93a53243-56ff-334c-a109-bd7c646d0a31"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->272689928, ExpressionUUID->"29b63f07-f6b2-6e46-bfea-bf57618a5ad1"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "adbeee4a-a928-c241-931b-73d62bf4fc5e"],
 ", decoding drops the 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "38406d5d-fbad-5240-b63c-b3f055aa558a"],
 " extra cells and undoes the shift of each sweep, so the result is the \
cellular automaton evolution on a cyclic tape."
}], "Notes",
 CellID->645753504, ExpressionUUID->"ab6c61aa-2a42-164e-9ff2-054f92af8a69"],

Cell["The following option can be given:", "Notes",
 CellID->262775758, ExpressionUUID->"0f4e6fb0-8e93-9c48-95e8-b2c94c0ed587"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "f152ce01-c610-7248-ac8a-87ef763f1212"], "\"\<InfiniteSteps\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText", ExpressionUUID->"39556148-b4ea-c240-a730-6b53f343f882"]}
  }]], "3ColumnTableMod",
 CellID->700483334, ExpressionUUID->"80bcd568-3332-ff4a-90ff-a6676e5d47b4"]
}, Open  ]],

