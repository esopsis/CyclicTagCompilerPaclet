Cell["\<\
Decode the evolution of a ring machine running rule 30 on 7 cells:\
\>", "ExampleText",
 CellID->426730523, ExpressionUUID->"1b04c3df-d663-8248-93e1-0ad8f95961ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"history", " ", "=", " ", 
   RowBox[{"ObliviousRingMachine", "[", 
    RowBox[{
     RowBox[{"CellularAutomatonToObliviousRingMachineRule", "[", "30", "]"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", 
       " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"CellularAutomatonToObliviousRingMachineSteps", "[", 
      RowBox[{"3", ",", " ", "7"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->709150380, ExpressionUUID->"2a728eed-b4d5-0e43-9c40-b3312397e01a"],

