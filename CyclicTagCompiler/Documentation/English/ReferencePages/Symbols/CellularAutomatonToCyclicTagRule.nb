Cell["\<\
Rule numbers and explicit rules give the same cyclic tag system:\
\>", "ExampleText",
 CellID->647588408, ExpressionUUID->"352ecd67-f382-1045-a49e-a2360fd971ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
   RowBox[{"30", ",", " ", "6"}], "]"}], " ", "===", " ", 
  RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"30", ",", " ", "2", ",", " ", "1"}], "}"}], ",", " ", "6"}], 
   "]"}], " ", "===", " ", 
  RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
   RowBox[{
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "3"}], "]"}], " ", "->",
       " ", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"30", ",", " ", "2", ",", " ", "8"}], "]"}]}], "]"}], ",", " ",
     "6"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
