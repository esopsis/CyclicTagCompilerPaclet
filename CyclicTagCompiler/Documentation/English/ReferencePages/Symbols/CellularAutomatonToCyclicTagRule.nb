 " tape symbols."
}], "Usage",
 CellID->322657025, ExpressionUUID->"1fc2f2cc-94e6-6d45-ad91-a66b76ed1c0c"],

Cell[TextData[{
 "The cellular automaton ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "82aea129-7215-ed4a-a9a5-cd6dd6f02feb"],
 " can have the following forms:"
}], "Notes",
 CellID->808254407, ExpressionUUID->"72d720d0-285e-7f43-b249-4e7b31927a4e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "dd775eb3-5632-534f-bddd-570924324c6e"], Cell[BoxData[
     StyleBox["n", "TI"]], "TableText", ExpressionUUID->
     "57636819-451e-124d-82e9-419673c9bfce"], Cell[TextData[{
     "the elementary cellular automaton with rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "810dc7f6-a0d0-2b4a-a966-1942e2fcf48c"],
     " (2 colors, range 1)"
    }], "TableText", ExpressionUUID->
     "2e67fbce-fc03-4448-9de5-a317789a2f47"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "30a05666-0eaa-964e-aa2e-2db449305c4b"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["n", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], "}"}]], "TableText", ExpressionUUID->
     "7ac7df54-ed25-c94f-b865-2bfe28799ff8"], Cell[TextData[{
     "rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "4277e1cb-3c47-3d4a-8b9f-c61b951dfc50"],
     " with ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "f9db177e-b684-1c41-8105-382cae068ca4"],
     " colors and range 1"
    }], "TableText", ExpressionUUID->
     "56b21944-0aad-264e-b56b-2416c3b75786"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "730a13e7-7305-7340-8296-a6e4eb3c1941"], Cell[BoxData[
     RowBox[{"{", 
      StyleBox["n", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["k", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["r", "TI"], "}"}]], "TableText", ExpressionUUID->
     "ea663f94-43fe-b44b-bd4a-50f072009cbe"], Cell[TextData[{
     "rule number ",
     Cell[BoxData[
      StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
      "175cf437-0414-bc46-be74-afaaa6f78c2f"],
     " with ",
     Cell[BoxData[
      StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
      "3afd753e-9300-9a44-aeea-91a840d29af0"],
     " colors and range ",
     Cell[BoxData[
      StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
      "38b2516b-74a7-0041-8144-8694eac2ddef"]
    }], "TableText", ExpressionUUID->
     "469db2d2-3982-524c-8996-504b0234a881"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "59c6cfd1-0559-2442-8222-62c4ee619459"], Cell[BoxData[
     RowBox[{
      RowBox[{"{", "{"}], 
      StyleBox["c1", "TI"], 
      RowBox[{",", " "}], 
      StyleBox["c2", "TI"], 
      RowBox[{
       RowBox[{
        RowBox[{",", " ", "\[Ellipsis]"}], "}"}], " ", "->", " "}], 
      StyleBox["c", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]], "TableText", 
     ExpressionUUID->"5baf0937-09e7-e043-8f4f-b4ecd4ac4e68"], Cell[TextData[{
     "explicit rules giving the new color ",
     Cell[BoxData[
      StyleBox["c", "TI"]], "InlineFormula", ExpressionUUID->
      "cbe69083-99ed-5e42-b515-fc412f993348"],
     " of a cell from the colors of its neighborhood"
    }], "TableText", ExpressionUUID->"c8a37d0d-86f0-6448-a527-55f5f749cd86"]}
  }]], "2ColumnTableMod",
 CellID->585142592, ExpressionUUID->"2592cfb6-1787-1147-b13e-9fcd8af43bda"],

Cell[TextData[{
 "Rule numbers are as in ",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula", 
  ExpressionUUID->"a143fec0-287b-4542-91ee-3ace0f88f4e7"],
 ". The range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "58e8eb19-e11f-c540-9788-3f550d502792"],
 " can be a positive integer or half-integer; a cell's neighborhood has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "f175e8c3-5d9e-7d4a-9493-9ca3adfd1831"],
 " + 1 cells."
}], "Notes",
 CellID->654761556, ExpressionUUID->"70fc6b86-2125-7149-aef0-b587b718d36d"],

Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->806738471, ExpressionUUID->"66a065d9-704a-334e-88e3-603c2ebef4d8"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CellularAutomatonToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "e5ad616f-b019-4949-9d3c-66ade3fb489b"],
 " compiles the cellular automaton to an oblivious ring machine with ",
 Cell[BoxData[
  ButtonBox["CellularAutomatonToObliviousRingMachineRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToObliviousRingMachineRule"]], "InlineFormula", 
  ExpressionUUID->"41b66f80-5ab3-a446-9e6b-66e83c3d7079"],
 ", and that to a cyclic tag system with ",
 Cell[BoxData[
  ButtonBox["ObliviousRingMachineToCyclicTagRule",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule"]], "InlineFormula", ExpressionUUID->
  "901858f7-adfb-9146-92d8-4ad9feb9f0df"],
 "."
}], "Notes",
 CellID->186350175, ExpressionUUID->"e9bab50d-1205-e344-9dc4-327edeaae47d"],

Cell[TextData[{
 "The number of colors used is the largest of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula", ExpressionUUID->
  "16cd5cfb-eb83-0c42-8c17-26ac5ac4f621"],
 " and the number of colors of ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula", ExpressionUUID->
  "05559b23-6f78-6b42-913a-5b43168a3f6e"],
 ". Give that number as ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula", ExpressionUUID->
  "0eaf3991-3d1a-7545-88a4-246097e8b65e"],
 " to ",
 Cell[BoxData[
  ButtonBox["CellularAutomatonToCyclicTagInit",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagInit"]], "InlineFormula", ExpressionUUID->
  "034d60dc-73b8-9b47-9bc1-bff30835aaea"],
 ", ",
 Cell[BoxData[
  ButtonBox["CellularAutomatonToCyclicTagSteps",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagSteps"]], "InlineFormula", ExpressionUUID->
  "01491f93-4619-884a-8908-21bf85ba2b93"],
 " and ",
 Cell[BoxData[
  ButtonBox["DecodeCyclicTagToCellularAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToCellularAutomaton"]], "InlineFormula", ExpressionUUID->
  "5250ed52-7e45-154f-abc4-5f21b49d98d6"],
 ", along with the range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "e1d89991-bcae-c145-a1af-e21dba7bcd8a"],
 "."
}], "Notes",
 CellID->441483679, ExpressionUUID->"d2616090-a59c-f746-9e7d-c4309feddc84"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "524dcc0d-9bce-2b48-b3d2-751de7dd5863"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "4b996f7e-c5d6-4e40-9264-68e1f06ff9ab"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->874619473, ExpressionUUID->"9cb0b23a-ecaa-6c40-90bd-eee182e1562e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "2e9347e2-06a7-4f43-9617-09bfd18d5032"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "19b1ad40-36bd-2244-9c4d-cf5b2bc97f5b"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula", ExpressionUUID->
  "f9d37bfa-44c1-0c4e-8af9-4a93905ea0f9"],
 " cells, as given by ",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula", 
  ExpressionUUID->"db80c5a3-05de-e242-98cd-1000c30b97f9"],
 ", for any number of steps."
}], "Notes",
 CellID->868046238, ExpressionUUID->"d2319c3d-9d34-3b44-bc14-d2346e604840"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CompiledCellularAutomatonToCyclicTag",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag"]], "InlineFormula", ExpressionUUID->
  "5395c610-37b5-6142-918c-c41a22755168"],
 " compiles a cellular automaton and returns a function that runs it as a \
cyclic tag system."
}], "Notes",
 CellID->91467062, ExpressionUUID->"0dc858ad-708f-f045-9b81-370ab3282044"],

Cell["The following options can be given:", "Notes",
 CellID->312287515, ExpressionUUID->"38446faf-3bd9-8a4b-b249-f1157cebb4b7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "9f79276e-b563-ab48-8afa-1263b95ed207"], "\"\<InfiniteSteps\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText", ExpressionUUID->"15db4363-f0c3-754f-9bc7-5839be7b7792"]},
   {Cell["      ", "ModInfo", ExpressionUUID->
     "9be14768-5836-e24e-85df-50ef923c2715"], "\"\<TargetSystem\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Automatic"], Cell[
    "the kind of cyclic tag system to compile to", "TableText", 
     ExpressionUUID->"04c3b235-8d00-2a46-9c46-7d51137ef1fb"]}
  }]], "3ColumnTableMod",
 CellID->58756779, ExpressionUUID->"6b4c7aaa-e02a-7643-aab1-809695a39252"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"375873c5-a8bf-1444-96d5-a05ac99a642c"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["Automatic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Automatic"]}]], "InlineFormula", ExpressionUUID->
  "5f9eac0f-3aaa-f448-b3a5-100d18f0bdfb"],
 " uses as few cells as possible."
}], "Notes",
 CellID->293989439, ExpressionUUID->"78587139-fa55-814d-872e-5886cf8c8365"],

Cell["\<\
Use the same option settings for the initial condition, step count and \
decoding.\
\>", "Notes",
 CellID->274885413, ExpressionUUID->"27f0958c-df1c-1242-b8f0-46a145e5e34f"]
}, Open  ]],

