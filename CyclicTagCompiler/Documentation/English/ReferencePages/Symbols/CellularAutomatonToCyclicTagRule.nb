CellularAutomatonToCyclicTagRule"], "[", 
   StyleBox["rule", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["tapeLength", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "d5a3eb66-5057-5440-942a-e7151b03c3d4"],
 " \[LineSeparator]",
 "compiles the cellular automaton ",
