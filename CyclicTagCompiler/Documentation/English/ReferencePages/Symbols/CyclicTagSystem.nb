 " supports the following properties (which can be supplied as the argument \
",
 Cell[BoxData[
  StyleBox["prop", "TI"]], "InlineFormula", ExpressionUUID->
  "446f683d-1e0a-ac48-b546-4bfb321a5f8c"],
 "):"
}], "Notes",
 CellID->801516232, ExpressionUUID->"71d4a468-109c-8241-8501-4f1f30ddf6ab"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "8884da6e-84f6-c845-8cb7-c5a5d26af61f"], Cell[
