       " ", "200"}], "]"}]}], ",", " ", 
   RowBox[{"Filling", " ", "->", " ", "Axis"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->984593155, ExpressionUUID->"cf78981b-90b0-e64f-8365-75249ebc1c82"],

