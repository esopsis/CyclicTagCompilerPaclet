Cell["\<\
Plot how tape length changes across the evolution of the same cyclic tag \
system (which in this case demonstrates that the system eventually halts):\
\>", "ExampleText",
 CellID->64538561, ExpressionUUID->"332b7a92-f265-a441-ae0b-2393c04e6e46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListStepPlot", "[", 
  RowBox[{
   RowBox[{"Length", " ", "/@", " ", 
    RowBox[{"CyclicTagSystem", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", "0", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
