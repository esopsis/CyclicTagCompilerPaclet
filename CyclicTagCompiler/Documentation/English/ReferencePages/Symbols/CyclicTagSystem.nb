 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "83331c2b-382e-6140-82ab-7bb8ed4f25c3"],
 ", using cyclic tag system ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
  "3486c9ac-8b0a-8b46-8d29-e8bdd77a872b"],
 " over ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "2942a420-f25e-9649-ad42-0edc312d26db"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "dcf4dc84-ed86-7542-a2a9-2ec2bbd38b17"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CyclicTagSystem",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"], "[", 
   StyleBox["rules", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "90b302e9-5db5-954b-845d-3c7e486f803f"],
 " \[LineSeparator]",
 "gives the result of evolving ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "e0b3642a-3724-5541-b3bd-f0e7c3c45e51"],
 " for one step.",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "08fbb57b-7913-8e41-86c1-45b422d62c9a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CyclicTagSystem",
    BaseStyle->"Link",
    ButtonData->
