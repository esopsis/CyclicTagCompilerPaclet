Cell[CellGroupData[{
Cell["CyclicTagSystem", "ObjectName",
 CellID->749126848, ExpressionUUID->"fa4bb25b-1386-184e-a977-3876a5f1bc01"],

Cell[TextData[{
 Cell["   ", "ModInfo", ExpressionUUID->
  "0c0c8652-dff5-af43-ad47-417f8a761ec9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CyclicTagSystem",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"], "[", 
   StyleBox["rules", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "df544840-0ecf-3448-8da5-0c8dbda69cc4"],
 " \[LineSeparator]",
 "gives the list of tapes in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula", ExpressionUUID->
  "e378f0f1-b84c-7543-a2f4-1856f16654f8"],
 " steps of the cyclic tag system with the blocks ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
  "3ef67653-e913-164a-b393-ec5b940cbd6b"],
 ", starting from the tape ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "2c9f1160-d732-9749-9028-c69913e3fe7b"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "fe3a135c-240d-9e45-9d8d-e1014896f9f8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CyclicTagSystem",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"], "[", 
   StyleBox["rules", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["t", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["prop", "TI"], "]"}]], "InlineFormula", ExpressionUUID->
  "16d6ad25-df35-684c-951f-f07706a58b17"],
 " \[LineSeparator]",
 "gives the property ",
 Cell[BoxData[
  StyleBox["prop", "TI"]], "InlineFormula", ExpressionUUID->
  "e9f118c9-3e0f-3549-b166-bc7d81a204a4"],
 " at each step, where ",
 Cell[BoxData[
  StyleBox["prop", "TI"]], "InlineFormula", ExpressionUUID->
  "27b1095a-3729-1a4f-95c7-6ec61d635bce"],
 " is ",
 Cell[BoxData["\"\<States\>\""], "InlineFormula", ExpressionUUID->
  "659c5aa6-efe8-9740-95bb-02556cee4508"],
 " or ",
 Cell[BoxData["\"\<Rules\>\""], "InlineFormula", ExpressionUUID->
  "95ec9621-7a57-eb4c-9d3e-9b3d076727b0"],
 ".",
 "\n",
 Cell["   ", "ModInfo", ExpressionUUID->
  "045c0049-37ec-e543-8870-9fc3bdc9b06f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CyclicTagSystem",
    BaseStyle->"Link",
    ButtonData->
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"], "[", 
   StyleBox["rules", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["init", "TI"], 
