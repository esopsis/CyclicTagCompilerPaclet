  }]], "2ColumnTableMod",
 CellID->727873288, ExpressionUUID->"4dde004c-e3ec-1346-962c-6b04b3c2b9f7"],

Cell["The following option can be given:", "Notes",
 CellID->641494907, ExpressionUUID->"80c49024-49b8-9a43-b03a-9a88f6f02fd9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo", ExpressionUUID->
     "ec999efc-025d-f74d-b2bb-8772567d61ba"], "\"\<IncludeRules\>\"", 
    ButtonBox["False",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/False"], Cell[TextData[{
     "whether to give each tape together with the block at the front of ",
     Cell[BoxData[
      StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
      "64aa85cb-5742-db48-9071-a7dd83557c8d"]
    }], "TableText", ExpressionUUID->"c3b67777-ea5d-6d4b-961f-edd147270150"]}
  }]], "3ColumnTableMod",
 CellID->348260009, ExpressionUUID->"fc313fb4-5a8e-3948-8acc-b4cf1edc62d3"],

Cell[TextData[{
 "With the default setting ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeRules\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["False",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/False"]}]], "InlineFormula", ExpressionUUID->
  "ecd4b511-7c07-384c-a540-fdaf5078c905"],
 ", each state is given as a tape. With ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeRules\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "3240accc-bd69-574a-a099-6f676defb00b"],
 ", each state is given as ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["tape", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["block", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "8a295bd5-dee5-9f43-bf53-07fbd5fd55a5"],
 ", where ",
 Cell[BoxData[
  StyleBox["block", "TI"]], "InlineFormula", ExpressionUUID->
  "a1ca8a8a-51da-cb40-b537-9b0382380934"],
 " is the block at the front of ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
  "18e586df-d83a-f546-a36c-546623530585"],
 " at that step, which is the block added to the end of the tape if the first \
element of ",
 Cell[BoxData[
  StyleBox["tape", "TI"]], "InlineFormula", ExpressionUUID->
  "21f14692-6844-0f49-9e5e-54b25eafa68c"],
 " is 1."
}], "Notes",
 CellID->458835917, ExpressionUUID->"fa50f671-ccb8-9e4e-914d-d66b4cf051b9"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<IncludeRules\>\""], "InlineFormula", ExpressionUUID->
  "d13d5323-a600-ee47-aff5-e44a9e60d8e0"],
 " option has no effect on the ",
 Cell[BoxData["\"\<Lengths\>\""], "InlineFormula", ExpressionUUID->
  "0e86f01b-2969-6a4e-860b-07dae19387db"],
 " property."
}], "Notes",
 CellID->363483202, ExpressionUUID->"ca0f5d51-78dc-7242-823a-b2d809d64cba"],

