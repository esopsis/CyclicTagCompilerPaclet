Cell[TextData[{
 "In a step of evolution in a cyclic tag system, the first element of the \
tape is deleted. If the first element was 0, no elements are added to the end \
of the tape. If the first element was 1, then the first block in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
  "2cb7a798-83b4-5c49-b0b8-bb7a55bb9b01"],
 " is added to the end of the tape. At every evolution step, the blocks in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
  "979c2a9f-a871-5449-8079-363049269415"],
 " are rotated left one step so that the first block goes to the end of ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
  "b653d8bf-c397-9743-a866-7ec8820b1234"],
 "."
}], "Notes",
 CellID->88300010, ExpressionUUID->"dbaefb06-9330-d943-9d8c-654c779a0b08"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula", ExpressionUUID->
  "bfbfa2a1-085b-0a43-a485-079be46bba0d"],
 " should be given as a list, where each element is a list specifying a block \
of digits to be added to the end of the tape, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", "0", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}]], 
  "InlineFormula", ExpressionUUID->"adb8518a-66d7-974d-af5c-8ad269417aa6"],
 "."
}], "Notes",
 CellID->328108744, ExpressionUUID->"a6f6fa2e-83c8-2642-9f44-66b99be0a0bb"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula", ExpressionUUID->
  "412beedf-f3ba-b94e-9166-e1b5581185de"],
 " should be given as a list that specifies the initial tape configuration, \
such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]], 
  "InlineFormula", ExpressionUUID->"48921175-3b2a-0d42-9cbb-23fc8a5845d3"],
 "."
}], "Notes",
 CellID->350927690, ExpressionUUID->"1bfc4cce-9041-ae4a-bf14-036c76041858"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CyclicTagSystem",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem"]], 
