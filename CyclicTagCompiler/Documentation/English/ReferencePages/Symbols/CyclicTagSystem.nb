Cell["\<\
Visualize the successive tape states in the evolution of a slightly more \
complicated cyclic tag system:\
\>", "ExampleText",
 CellID->131526373, ExpressionUUID->"3b04fa0d-0369-ad44-98ef-f296f3a9fa7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArrayPlot", "[", 
  RowBox[{"PadRight", "[", 
   RowBox[{
    RowBox[{"CyclicTagSystem", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
