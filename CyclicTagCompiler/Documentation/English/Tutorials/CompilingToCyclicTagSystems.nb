Cell[CellGroupData[{

Cell["A rule with 3 colors and range 1/2:", "MathCaption",
 CellID->260566032, ExpressionUUID->"c8652110-1ede-2f4b-99f4-59050de2f513"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1234", ",", " ", "3", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", "7", ",", " ", 
     RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", "True"}]}], "]"}], "[", 
   
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "0", ",", " ", "1", ",", " ", "2", ",", " ", "0", ",", " ", "0", ",", 
      " ", "1", ",", " ", "0"}], "}"}], ",", " ", "4"}], "]"}], " ", "===", 
  " ", 
  RowBox[{"CellularAutomaton", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1234", ",", " ", "3", ",", " ", 
      RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
     "0", ",", " ", "1", ",", " ", "2", ",", " ", "0", ",", " ", "0", ",", 
      " ", "1", ",", " ", "0"}], "}"}], ",", " ", "4"}], "]"}]}]], "Input",
 CellLabel->"In[5]:=",
