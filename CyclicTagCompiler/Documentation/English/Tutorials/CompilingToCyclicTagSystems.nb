   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "0", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->910193886, ExpressionUUID->"e4bd329c-2fb1-5c44-a4cf-b77c3a3515c9"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "To compile an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "85333647-1376-954d-a809-f56bf1119448"],
 "-ary cyclic tag system to a cyclic tag system, each symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "2818734e-0341-ba4a-9060-48273f4244bd"],
 " becomes a block of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "22600d8d-d26b-b548-a3ef-b31cb10feeea"],
 " cells that are all 0 except for a 1 at position ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula", ExpressionUUID->
  "de7006d3-95a0-4d44-8399-54e24a81b629"],
 "+1, and each rule part becomes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "da7ad76c-a5ac-024f-98ef-9ce3d4e6c1c9"],
 " appendants, one for each symbol. Only the 1 in a block makes the cyclic \
tag system append anything, and it does so exactly when the appendant for the \
block's symbol is current. So ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "55ee951e-91b7-ce46-b77a-80aeb88304cc"],
 " cyclic tag steps emulate one ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula", ExpressionUUID->
  "9e9698ee-e1e0-0c4f-8744-74f1931cc04e"],
 "-ary step."
}], "Text",
 CellID->619584675, ExpressionUUID->"ad8d9ac7-4f3c-3447-9c25-abb51d8c1207"],

