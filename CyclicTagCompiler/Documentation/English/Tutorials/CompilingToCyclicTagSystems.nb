Cell[CellGroupData[{

Cell["Cellular Automata", "Section",
 CellID->601377700, ExpressionUUID->"4ccdbd12-e9b5-5846-bac1-fa0ea7e21954"],

Cell[CellGroupData[{

Cell["\<\
An oblivious ring machine can emulate a cellular automaton on a finite cyclic \
tape by sweeping along the tape. At each step it reads a neighborhood, writes \
the new color of the cell at its center into the first cell of the \
neighborhood, and moves on by one cell:\
\>", "Text",
 CellID->863003076, ExpressionUUID->"380e2e8f-56b4-ca4e-a43c-a9b3788d9397"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CellularAutomatonToObliviousRingMachineRule", "[", "110", 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->372450554, ExpressionUUID->"6babbea3-9872-0f45-8a48-281dbd2108e0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->108117850, ExpressionUUID->"f17b16ce-8c25-b345-85c9-3f29e3dc8072"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "After a sweep of the whole tape, the new row of the cellular automaton is \
on the tape, shifted by the range of the rule. But the cells near the end of \
the tape see neighbors that have already been updated, so only the cells \
whose neighborhoods stayed inside the tape are reliable, 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "429d142a-bb6f-fc46-afd5-a45c880af777"],
 " fewer at each step. This is what the compilation gives by default:"
}], "Text",
 CellID->976322935, ExpressionUUID->"a199b2f8-398c-b84c-86fa-05d992c8c0c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"110", ",", " ", "9"}], "]"}], "[", 
   RowBox[{
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "5"}], "]"}], " ", "//",
   " ", "Column"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->785825157, ExpressionUUID->"3f60fec8-8cfa-bc4b-9372-eee9e36eb429"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "0", ",", "0", ",", "1", ",", "0", ",", "0", ",", 
       "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
      "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}]},
    {
     RowBox[{"{", "1", "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->"Out[2]=",
 CellID->799594873, ExpressionUUID->"7f109dba-dc57-eb49-b8b7-6cfa7dd9a642"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], 
   ButtonBox["True",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/True"]}]], "InlineFormula", ExpressionUUID->
  "1c21d04d-d277-a648-aec6-e4bff63d1a47"],
 ", the ring machine tape gets 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "725ca864-ce0e-3a4f-9e3e-b3f8e815181d"],
 " extra cells, and before each sweep the machine copies the first 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula", ExpressionUUID->
  "57f60d4f-20bd-e744-b747-fe7158b1aaf1"],
 " cells into them. The neighborhoods at the end of the sweep then wrap \
around into old colors, and the compiled system emulates the cellular \
automaton on a cyclic tape for any number of steps:"
}], "Text",
 CellID->612890879, ExpressionUUID->"f5af490f-8cd7-ab4b-b4dc-7e49fa819821"],

