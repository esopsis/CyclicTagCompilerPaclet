Cell[CellGroupData[{

Cell["Automata Networks", "Section",
 CellID->611966894, ExpressionUUID->"f81693f6-885b-7143-a604-66c95097fa2e"],

Cell[TextData[{
 "An automata network is a list of automata ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["rules", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["inputs", "TI"], 
   RowBox[{",", " "}], 
   StyleBox["label", "TI"], "}"}]], "InlineFormula", ExpressionUUID->
  "878dc98d-99a3-864c-a6d2-f6b4a3e5672b"],
 ". At each step all automata update at once, each applying its rules to the \
states of its inputs. ",
 Cell[BoxData[
  ButtonBox["AutomataNetworkRun",
   BaseStyle->"Link",
   ButtonData->
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun"]], 
  "InlineFormula", ExpressionUUID->"fd5b690a-cc6b-b94b-8815-789e95e12239"],
 " runs automata networks:"
}], "Text",
 CellID->613702652, ExpressionUUID->"e4b18677-4603-044b-88cc-5513a1796de5"],

Cell[CellGroupData[{

Cell["A network of 3 automata with 3 states:", "MathCaption",
 CellID->493951475, ExpressionUUID->"45b76277-8609-8745-b4e4-83165e829dba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "3"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",", " ", "1", ",",
            " ", "2", ",", " ", "2", ",", " ", "1", ",", " ", "0", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",",
            " ", "0", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "1"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "2"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "1", ",", " ", "2", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "2", "}"}], " ", "->", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "1", "}"}], " ", "->", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "0", "}"}], " ", "->", " ", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}], ",", " ", "3"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->178967235, ExpressionUUID->"60099d69-3479-b047-a68e-6e87f27b9815"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkRun", "[", 
  RowBox[{"net", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->793597778, ExpressionUUID->"e2be794b-88e8-a841-8eb0-fdfd769f8846"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->192146418, ExpressionUUID->"af24dc34-b267-7e42-b960-f123be817e0d"]
}, Open  ]]
}, Open  ]],

Cell["\<\
On the oblivious ring machine tape, each automaton has a block of cells: one \
for each of its inputs, plus extra cells if more automata read its state than \
it has inputs. Each network step is one pass through the ring machine rule, \
in three phases:\
\>", "Text",
 CellID->555678078, ExpressionUUID->"885e03ad-84cd-4347-a89d-d8ab76926453"],

Cell["\<\
grow: fill the extra cells of each block with copies of the automaton's state\
\
\>", "Item",
 CellID->272319002, ExpressionUUID->"18b4d2e4-7850-ca4b-b373-5c8a2bcf50f1"],

Cell["\<\
sort: bubble-sort the cells by swapping or skipping neighbors, so that each \
automaton's input cells hold the states of its inputs\
\>", "Item",
 CellID->562356427, ExpressionUUID->"854aa469-47aa-de4d-baa0-fb1bb551079e"],

Cell["\<\
apply: apply each automaton's rules to its input cells, writing its new state \
into all of them\
\>", "Item",
 CellID->563234749, ExpressionUUID->"0b3d268a-df69-9d4b-a746-e3a992984a13"],

Cell[CellGroupData[{

Cell["\<\
Automaton 2 is read by 2 automata but has 1 input, so it gets an extra cell:\
\>", "MathCaption",
 CellID->200860385, ExpressionUUID->"0a722cbb-2a4f-4345-a0d8-dec95c43f9ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkToObliviousRingMachineInit", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "net"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->337382418, ExpressionUUID->"64e854cb-2911-3743-9665-19ffbee8e0f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "0", ",", "0"}],
   "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->419060780, ExpressionUUID->"62324823-76ef-e44d-9a4d-574d72d532b7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Run the network as a cyclic tag system:", "MathCaption",
 CellID->181597273, ExpressionUUID->"48803a45-70ae-1e4b-83b0-6d7c901e2def"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CompiledAutomataNetworkToCyclicTag", "[", 
   RowBox[{"net", ",", " ", "3"}], "]"}], "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->797390995, ExpressionUUID->"11d08938-5ca3-504b-82ed-dddda8a87775"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->822051473, ExpressionUUID->"e8d84967-30f0-7946-9460-1fae2ee37487"]
}, Open  ]]
}, Open  ]],

Cell["\<\
Since a cellular automaton on a cyclic tape is an automata network in which \
each cell reads its neighbors, this gives a second way to compile cellular \
automata, and one that also works for other kinds of wiring.\
\>", "Text",
 CellID->206498190, ExpressionUUID->"dc731723-06e4-4a4b-b030-84230412d456"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rule 110", "Section",
 CellID->173401426, ExpressionUUID->"56361225-afa0-084a-93d6-cadd30ddca55"],

Cell[CellGroupData[{

Cell[TextData[{
 "Matthew Cook's construction emulates cyclic tag systems in rule 110 when \
their number of appendants is a multiple of 6. ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", 
   RowBox[{" ", 
    RowBox[{"->", " "}]}], "\"\<Rule110\>\""}]], "InlineFormula", 
  ExpressionUUID->"76fd4991-80d9-0b47-9ee7-19682c8b719d"],
 " rounds the size of every symbol's block up to a multiple of 6, which makes \
the number of appendants a multiple of 6. The compiled functions have the \
option ",
 Cell[BoxData["\"\<Mod6CyclicTag\>\""], "InlineFormula", ExpressionUUID->
  "c7098525-634c-e240-817c-5a0f38a9137d"],
 " for this:"
}], "Text",
 CellID->405983159, ExpressionUUID->"8a9de902-8650-dd46-9e7a-cbed0515da55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"30", ",", " ", "9"}], "]"}], ",", " ", 
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"30", ",", " ", "9", ",", " ", 
      RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->389782504, ExpressionUUID->"9daba228-15b8-5f41-9cd5-90cee5191911"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"120", ",", "180"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->638848494, ExpressionUUID->"74849ccc-dfc2-ca4c-9114-7f675dee29a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"30", ",", " ", "9", ",", " ", 
     RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<Mod6CyclicTag\>\"", " ", "->", " ", "True"}]}], "]"}], "[", 
   
   RowBox[{
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "4"}], "]"}], " ", "===",
   " ", 
  RowBox[{"CellularAutomaton", "[", 
   RowBox[{"30", ",", " ", 
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "4"}], "]"}]}]], "Input",\

 CellLabel->"In[2]:=",
 CellID->305360880, ExpressionUUID->"350388c3-384a-4848-9fa2-5684a9e7ff6b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",
 CellID->599077929, ExpressionUUID->"86d57508-3c3f-5d4e-ae08-b8c6d0c99b21"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Limitations", "Section",
 CellID->646402629, ExpressionUUID->"5a91f76d-f45b-2544-9d4e-b72165eca4af"],

Cell["\<\
Only finite systems can be compiled: cellular automata on cyclic tapes of a \
given length, and finite automata networks.\
\>", "Item",
 CellID->51305288, ExpressionUUID->"4c5a99c0-684b-9a4f-90f9-5248aa6957d4"],

Cell["\<\
Oblivious ring machine steps must replace their window by the same number of \
symbols, read windows of the same size in each step, and only rotate the tape \
forward.\
\>", "Item",
 CellID->485182430, ExpressionUUID->"35185e14-0b42-ea4b-b3ea-d65f962175f2"],

Cell["\<\
Symbols or states that rules compute rather than write explicitly are not \
counted automatically; give the number of symbols or states for such rules.\
\>", "Item",
 CellID->806171566, ExpressionUUID->"14c7c442-ad67-8649-8cb0-310c8212d7b1"],

Cell[CellGroupData[{

Cell["\<\
The compiled cyclic tag systems are large, and grow with the tape length, the \
number of colors and the range:\
\>", "Item",
 CellID->63741478, ExpressionUUID->"9497633b-28aa-e64f-bf74-0b4d1d9b28cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"110", ",", " ", "n"}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "4", ",", " ", "12", ",", " ", "2"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->825897897, ExpressionUUID->"794ed9e8-9983-a341-9531-e50600900d70"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"80", ",", "96", ",", "112", ",", "128", ",", "144"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->812078781, ExpressionUUID->"5888c879-2920-4345-a3b5-35438060ef5e"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

