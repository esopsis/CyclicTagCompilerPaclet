Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["rules1", "TI"]}], ",", " ", 
   StyleBox["inputs1", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label1", "TI"], 
    RowBox[{"}", ",", " ", "{"}], 
    StyleBox["rules2", "TI"]}], ",", " ", 
   StyleBox["inputs2", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label2", "TI"], 
    RowBox[{
     RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "340a6867-16ed-ec45-a00c-f5a402e6c6c7"],
 " of automata, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c8547249-34a3-f141-bce5-7fe069848fb9"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->848568931,ExpressionUUID->"34e0ed22-d2b2-f242-8aae-76d8a0a4ec4d"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "baa1a78c-2339-4441-91d5-8eb563d7adb1"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], "_"}], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["y", "TI"], 
      RowBox[{"_", "}"}]}], " ", ":>", " ", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Mod"]], "paclet:ref/Mod"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      RowBox[{
       StyleBox["x", "TI"], " ", "+", " ", 
       RowBox[{
        StyleBox["y", "TI"], 
        RowBox[{
         RowBox[{",", " ", "2"}], "]"}]}]}]}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b47e0b32-ddb6-8f48-b386-f782df83ad2a"],
 "."
}], "Notes",
 CellID->417378987,ExpressionUUID->"a0cb1aaf-5a1b-5846-82fd-ea19bc2d66cc"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->663329928,ExpressionUUID->"be6b3aa6-9af6-254f-9391-3c04ebe23bb7"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f5f436c8-018f-6947-84cf-13cb5d68bed7"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a2b9717c-e7d2-d64a-a59a-9cda74e2f76a"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "68b61383-e8a8-0c49-9e63-5aae13642f07"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "37387c8a-f11e-9d43-ac87-393620035f6c"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], 
     RowBox[{"_", "}"}]}], " ", ":>", " ", 
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Mod"]], "paclet:ref/Mod"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     RowBox[{
      StyleBox["x", "TI"], " ", 
      RowBox[{
       RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a12eb066-4b16-ce4e-a60a-9a6690f17639"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "957a1c94-7198-4b48-884a-9057aead0c3c"],
 " is 2."
}], "Notes",
 CellID->946079855,ExpressionUUID->"4064f451-1310-6b48-97d1-ed32036e5976"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "babe85a4-dc4d-b14d-93ef-39d8b6024e90"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->564930259,ExpressionUUID->"f3483042-523c-cf4f-b734-ebba1f973cda"],

Cell[TextData[{
 "The cyclic tag rule is compiled once, when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CompiledAutomataNetworkToCyclicTag"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["network", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "231d8713-7049-9149-ba84-381dd5262c01"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "620d6958-2b53-274d-ad6b-5d536f354773"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3760b498-0c0a-0f4d-ba56-dd2d593c2392"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a7ea3616-a424-574b-b1b8-c835cab14731"],
 ", and decodes its evolution."
}], "Notes",
 CellID->174721962,ExpressionUUID->"c7c7367a-7838-b548-8981-c7fe7a8f6cbd"],

Cell["The following option can be given:", "Notes",
 CellID->579571903,ExpressionUUID->"62d88eaf-bd09-f149-a7cc-6f428a4b0c64"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "8a1982a9-68fb-6141-93b4-4665f787e703"], "\"\<Mod6CyclicTag\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
\>", "TableText",ExpressionUUID->"6ecfdf9c-5fdf-5a43-ad39-c9d877fbbcc2"]}
