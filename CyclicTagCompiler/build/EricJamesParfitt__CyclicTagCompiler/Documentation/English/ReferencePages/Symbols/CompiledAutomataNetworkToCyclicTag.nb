Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["rules1", "TI"]}], ",", " ", 
   StyleBox["inputs1", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label1", "TI"], 
    RowBox[{"}", ",", " ", "{"}], 
    StyleBox["rules2", "TI"]}], ",", " ", 
   StyleBox["inputs2", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label2", "TI"], 
    RowBox[{
     RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ebcd4b0-bf49-4ef3-ab73-7a180ec3a289"],
 " of automata, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2a76883-3e34-4adf-b5e4-998435f18339"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->848568931,ExpressionUUID->"d0955f1b-8e07-4a91-9cc5-93b1ab291cb3"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef81badf-5038-4a02-b3b1-7683c4c17ece"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], "_"}], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["y", "TI"], 
      RowBox[{"_", "}"}]}], " ", ":>", " ", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Mod"]], "paclet:ref/Mod"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      RowBox[{
       StyleBox["x", "TI"], " ", "+", " ", 
       RowBox[{
        StyleBox["y", "TI"], 
        RowBox[{
         RowBox[{",", " ", "2"}], "]"}]}]}]}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c17fcfc4-4389-4417-99e7-7fcad5dec7d7"],
 "."
}], "Notes",
 CellID->417378987,ExpressionUUID->"90b86660-8700-4d3d-bf21-f055dfcc68bf"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->663329928,ExpressionUUID->"2c671944-b601-4742-a33f-14f3ea1b1567"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d05895a8-c3ab-455b-bbef-19bcdd5a3097"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88308fd7-9fe4-4406-9f62-4ef12839594a"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1fe4e4a-bda9-455b-9dd6-8b2bf26e7b9f"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aeb3c16d-8f8a-479f-bdd7-65825d30aa2f"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], 
     RowBox[{"_", "}"}]}], " ", ":>", " ", 
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Mod"]], "paclet:ref/Mod"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     RowBox[{
      StyleBox["x", "TI"], " ", 
      RowBox[{
       RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ad325f03-640a-4e77-9261-b287b282b5a2"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7fa74093-8d01-446c-84b1-c991fd06dab8"],
 " is 2."
}], "Notes",
 CellID->946079855,ExpressionUUID->"510ae4f3-6d40-46c7-979a-8a22a3e7bb2d"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "af00ef3a-b363-434c-9b43-c0ddc4d430d0"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->564930259,ExpressionUUID->"67f9b175-208d-4d2d-841e-ec6ecbb7e4e3"],

Cell[TextData[{
 "The cyclic tag rule is compiled once, when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CompiledAutomataNetworkToCyclicTag"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["network", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29e15de2-ae8f-41d6-a0df-40ad94b6fe98"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9b355e6-8487-4c9a-82f3-abbd21442574"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "28683ef0-180f-4792-94f5-149cf8d253d7"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "65456d1f-23ef-4f33-bfe0-7333af7ba0e4"],
 ", and decodes its evolution."
}], "Notes",
 CellID->174721962,ExpressionUUID->"ea0c2249-02ba-41ab-bb3b-3134a4c837ad"],

Cell["The following option can be given:", "Notes",
 CellID->579571903,ExpressionUUID->"885138b4-ca0c-4505-bce9-18deb280c784"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "c49f72b0-485c-41f1-bc5c-6e8b97b856c1"], "\"\<Mod6CyclicTag\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
\>", "TableText",ExpressionUUID->"0fc256d7-4426-4946-b86a-9fab242e64bc"]}
