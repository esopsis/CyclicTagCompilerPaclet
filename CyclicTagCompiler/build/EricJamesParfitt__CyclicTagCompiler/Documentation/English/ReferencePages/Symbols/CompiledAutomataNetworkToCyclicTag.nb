Cell["\<\
A network of 3 automata: automaton 1 is the XOR of automata 2 and 3, \
automaton 2 is NOT automaton 1, and automaton 3 is the AND of automata 1 and \
2:\
\>", "ExampleText",
 CellID->814365203,ExpressionUUID->"dc5ccc67-6e3a-4d80-9c68-b5d3b676a2d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
         RowBox[{"1", " ", "-", " ", "x"}]}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"x", " ", "y"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "3"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellProlog:>Needs["EricJamesParfitt`CyclicTagCompiler`"],
 CellLabel->"In[1]:=",
 CellID->746471978,ExpressionUUID->"81cb8120-71f4-4cdc-b2db-cbceb6b0cff7"],

