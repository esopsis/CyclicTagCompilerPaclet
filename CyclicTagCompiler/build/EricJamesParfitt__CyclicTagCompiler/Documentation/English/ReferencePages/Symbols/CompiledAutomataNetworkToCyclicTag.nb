Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["rules1", "TI"]}], ",", " ", 
   StyleBox["inputs1", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label1", "TI"], 
    RowBox[{"}", ",", " ", "{"}], 
    StyleBox["rules2", "TI"]}], ",", " ", 
   StyleBox["inputs2", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label2", "TI"], 
    RowBox[{
     RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5aaffbac-1841-ef4a-b712-0a3e952d9db7"],
 " of automata, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7ed1b177-a8da-3f41-8d88-1b8109380b12"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->848568931,ExpressionUUID->"0be7e155-69e6-2f45-81a2-d98c7c64ae40"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f13ef249-aa5c-884d-a63d-af81eeb3436a"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], "_"}], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["y", "TI"], 
      RowBox[{"_", "}"}]}], " ", ":>", " ", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Mod"]], "paclet:ref/Mod"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      RowBox[{
       StyleBox["x", "TI"], " ", "+", " ", 
       RowBox[{
        StyleBox["y", "TI"], 
        RowBox[{
         RowBox[{",", " ", "2"}], "]"}]}]}]}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47f316c0-188e-fa4b-9d8b-0bfae7463041"],
 "."
}], "Notes",
 CellID->417378987,ExpressionUUID->"cfd8c1bd-4bb2-3641-bbdf-d32a08a0c6ae"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->663329928,ExpressionUUID->"9cc3d9f0-7655-2141-b96d-f29895a33172"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "62c2f437-04f5-5a47-aec5-b6d6612dbfd4"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1b1f7c59-c55b-5544-9242-6ae7bbec9f76"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "be9dae75-bfcb-0a47-8ece-a1bdd1be42cd"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "307b044c-4749-1d40-a75a-a33985cda2f3"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], 
     RowBox[{"_", "}"}]}], " ", ":>", " ", 
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Mod"]], "paclet:ref/Mod"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     RowBox[{
      StyleBox["x", "TI"], " ", 
      RowBox[{
       RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9f3fc6bd-4a55-9d42-b2b4-3e532c0315f0"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7dcbd691-a054-d44a-9730-cfacf014c3b2"],
 " is 2."
}], "Notes",
 CellID->946079855,ExpressionUUID->"806fd761-012a-8f4c-b39c-b346a2d122e3"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "61db4ff1-c3ea-1844-bd56-48c73c454ed4"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->564930259,ExpressionUUID->"46fa0b22-c5d1-a946-a9a8-c294032d4d43"],

Cell[TextData[{
 "The cyclic tag rule is compiled once, when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CompiledAutomataNetworkToCyclicTag"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["network", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "32722b17-91a8-dc4d-9605-c6919373899b"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4ee199b0-222f-2048-a049-621deb2dfb3e"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ccc5794c-d37e-8a47-b7b9-513bccfadbdb"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee5f0da9-49b0-f947-9195-d938ab1f2d17"],
 ", and decodes its evolution."
}], "Notes",
 CellID->174721962,ExpressionUUID->"d7627260-6a33-5b4a-87ca-d83d9bb9b0f3"],

Cell["The following option can be given:", "Notes",
 CellID->579571903,ExpressionUUID->"067a0a45-6018-c048-86ff-846d984aa0df"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "6dc564ed-79a5-9d4f-bd1b-e8c6af4a7754"], "\"\<Mod6CyclicTag\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
