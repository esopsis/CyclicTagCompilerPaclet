Cell["\<\
An oblivious ring machine has a circular tape and a list of steps that it \
uses in turn, whatever is on the tape. Each step replaces the first few \
symbols of the tape using rules, and then rotates the tape to the left by an \
offset.\
\>", "Notes",
 CellID->499487697,ExpressionUUID->"9194b21b-d15e-e245-96c4-fa548b2d1344"],

Cell[TextData[{
 "The ring machine ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "103066a5-cca6-fa43-a660-f040cc418143"],
 " can have the following forms, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachine"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a232ca85-e07b-1644-91d5-dc52da45533e"],
 ":"
}], "Notes",
 CellID->64185626,ExpressionUUID->"931fe02b-8f05-104b-86bc-f973c0453be4"],

