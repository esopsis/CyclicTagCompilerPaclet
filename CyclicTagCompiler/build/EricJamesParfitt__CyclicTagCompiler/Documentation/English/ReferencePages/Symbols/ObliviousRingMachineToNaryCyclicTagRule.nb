Cell["A window of symbols that no rule matches is left unchanged.", "Notes",
 CellID->372149905,ExpressionUUID->"ee94207b-680a-994f-9a8b-93bbf4e5d2ce"],

Cell["\<\
To be compiled, every step must replace its window by the same number of \
symbols, all the rules of a step must have left-hand sides of the same \
length, and offsets must not be negative.\
\>", "Notes",
 CellID->219445347,ExpressionUUID->"8dc7b387-377f-d04e-9855-f76eae166bf6"],

Cell[TextData[{
 "The ring machine uses the symbols from 0 to ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "333a4f60-7ee7-424d-adac-be9aabd17828"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6536426-d765-274b-85db-bca41d2e291c"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "53045331-bb3a-3748-9d60-6babdb8515e6"],
 " and one more than the largest symbol written explicitly in the rules. \
Symbols computed by a right-hand side such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Mod"]], "paclet:ref/Mod"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["x", "TI"], " ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "994ee19a-6f62-cf46-aa93-72b28564b022"],
 " are not counted, so give ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "23ce6111-d5c8-2b4c-8f39-781f738f8177"],
 " for rules like that. The default value of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8be70703-47e1-0d44-b7b7-8e4e2b52ad79"],
 " is 2."
}], "Notes",
 CellID->47645954,ExpressionUUID->"d2239523-2edf-5148-bd45-2ccb4b0a3379"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9476529a-4ae9-0142-9d07-6f48f9bbe222"],
 "-ary cyclic tag tape is the ring machine tape itself, so the ring machine's \
initial condition needs no conversion. The ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d96b43d8-8903-bd48-a25c-e83a3413be02"],
 "-ary system uses two more symbols, ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "da34f94d-5853-5d45-8a99-ba26fc2464ab"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3f20b9e2-48bc-574e-bc41-56ad1f557778"],
 "+1, as markers."
}], "Notes",
 CellID->819719427,ExpressionUUID->"560e1c28-de6b-1c48-8874-a3d2f62eef36"],

Cell[TextData[{
 "Each ring machine step becomes a sequence of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e697fc35-bc94-5546-a8e9-974acab1fab5"],
 "-ary rule parts. The first ones read the window one symbol at a time, \
turning each symbol into a delay: its value times a power of ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6744fa40-c639-9449-84da-2e4c57837291"],
 ". A symbol 0 adds no delay, and only the delay of the last symbol read ends \
with the marker that triggers the replacement. Then the system skips around \
the rest of the tape, uses the total delay to choose the appendant that \
writes the replacement, and skips on to where the next step starts."
}], "Notes",
 CellID->272569159,ExpressionUUID->"cfa89eff-6bb6-3345-b4f6-9fd931a35e2f"],

Cell[TextData[{
 "The compiled rule only works for tapes of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cf8b321e-39e0-cc41-87b2-5da87162272f"],
 "."
}], "Notes",
 CellID->788223192,ExpressionUUID->"44126934-4627-ac4a-ae7f-75d33e7d4db2"],

