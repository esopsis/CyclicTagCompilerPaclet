Cell["A window of symbols that no rule matches is left unchanged.", "Notes",
 CellID->372149905,ExpressionUUID->"386a5e62-32c2-b442-b679-750a5999dda2"],

Cell["\<\
To be compiled, every step must replace its window by the same number of \
symbols, all the rules of a step must have left-hand sides of the same \
length, and offsets must not be negative.\
\>", "Notes",
 CellID->219445347,ExpressionUUID->"0b4f20ee-70b0-f14e-b477-5baac3f1fe4c"],

Cell[TextData[{
 "The ring machine uses the symbols from 0 to ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a7bd94f-515b-cc45-a1ab-3807a8f2b021"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d40f8a3d-09f6-5041-9293-dab807a12bcf"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9914b210-35c6-d542-95e9-f06c2f7a95fd"],
 " and one more than the largest symbol written explicitly in the rules. \
Symbols computed by a right-hand side such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Mod"]], "paclet:ref/Mod"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["x", "TI"], " ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "737396f6-644e-ba4e-9024-8475fc075f80"],
 " are not counted, so give ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1e220c98-83f2-a345-952b-7daa03ebee0c"],
 " for rules like that. The default value of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "374b0db9-86ea-684d-a06f-94421d0cea5f"],
 " is 2."
}], "Notes",
 CellID->47645954,ExpressionUUID->"57ae2a27-48bc-9543-8ae3-700ef6537623"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "425a360d-b074-b844-a0f6-33839c04bbdf"],
 "-ary cyclic tag tape is the ring machine tape itself, so the ring machine's \
initial condition needs no conversion. The ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc36693b-35ec-6d46-a7bd-76d9d18eaffb"],
 "-ary system uses two more symbols, ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4188bbce-333a-9841-b145-e690eec1c272"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41ba55bf-ce3a-ac44-9a0f-ef3358d38085"],
 "+1, as markers."
}], "Notes",
 CellID->819719427,ExpressionUUID->"0d8131bb-de90-074e-b351-04511f72b5a3"],

Cell[TextData[{
 "Each ring machine step becomes a sequence of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "738e7b85-1d52-5249-8f43-d272ceee37b1"],
 "-ary rule parts. The first ones read the window one symbol at a time, \
turning each symbol into a delay: its value times a power of ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e76e9ff7-8f09-0247-b31c-d3e8b7471969"],
 ". Then the system skips around the rest of the tape, uses the total delay \
to choose the appendant that writes the replacement, and skips on to where \
the next step starts."
}], "Notes",
 CellID->272569159,ExpressionUUID->"d6af25dd-cb06-3e48-bfd7-fc9069091ccc"],

Cell[TextData[{
 "The compiled rule only works for tapes of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d80addbf-3548-5a49-a9a1-9437b76e847f"],
 "."
}], "Notes",
 CellID->788223192,ExpressionUUID->"8f513f7b-091b-a14c-9567-da2017d9f63a"],

