Cell["\<\
An oblivious ring machine has a circular tape and a list of steps that it \
uses in turn, whatever is on the tape. Each step replaces the first few \
symbols of the tape using rules, and then rotates the tape to the left by an \
offset.\
\>", "Notes",
 CellID->90681241,ExpressionUUID->"82fc6702-4cf6-a749-9e00-e0746637f93e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ObliviousRingMachineToCyclicTagRule"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rule", "TI"], ",", " ", 
    StyleBox["tapeLength", "TI"], ",", " ", 
    StyleBox["tapeStates", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b31735b2-70e2-2d4f-9eec-024ec341e99c"],
 " compiles the ring machine to an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82572a37-8882-d042-accd-a89103bb8ffb"],
 "-ary cyclic tag system with ",
