     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rule", "TI"], ",", " ", 
    StyleBox["tapeLength", "TI"], ",", " ", 
    StyleBox["tapeStates", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7771464d-88b6-478e-816a-99a74aa8c7d7"],
 " compiles the ring machine to an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4fc8000-d9b9-4184-b422-f67f5bc58f1d"],
