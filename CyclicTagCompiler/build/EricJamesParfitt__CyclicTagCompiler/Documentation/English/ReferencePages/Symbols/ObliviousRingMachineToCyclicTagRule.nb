 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTagToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6f9dd01-a562-0a4f-8259-beb08e5b9d12"],
 "."
}], "Notes",
 CellID->335408267,ExpressionUUID->"3d082360-1f21-8b48-b939-1deaeefcb9f6"],

