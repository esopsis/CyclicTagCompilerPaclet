 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTagToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "864a6594-ac53-4a28-8774-a58d80e0a213"],
 "."
}], "Notes",
 CellID->335408267,ExpressionUUID->"b55379c4-bdfb-4a55-a0d1-bdca8665c1f9"],

