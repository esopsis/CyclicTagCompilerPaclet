Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d62d526b-807e-ae46-9499-8c503e8e2fa3"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["Automatic"]], "paclet:ref/Automatic"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9ea5f36b-fcc0-f14f-b496-aaaa7cae7b11"],
 " uses as few cells as possible."
}], "Notes",
 CellID->336841787,ExpressionUUID->"451cad85-eaa6-0a49-a6e5-b1bf4a315fdb"],

Cell[TextData[{
 "The rule, initial condition, step count and decoding of one compilation \
must all use the same number of symbols and the same ",
 Cell[BoxData["\"\<TargetSystem\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf15dedd-b889-db42-816d-2c08ccd1b9e7"],
 " setting."
}], "Notes",
 CellID->626997659,ExpressionUUID->"ca60dbdc-edae-8447-a39f-9f30598653cd"]
}, Closed]],

