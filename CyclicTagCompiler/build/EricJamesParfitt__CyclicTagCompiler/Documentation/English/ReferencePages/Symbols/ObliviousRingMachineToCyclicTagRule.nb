 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTagToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cb6c0481-9942-784b-92d3-6077d6e0008b"],
 "."
}], "Notes",
 CellID->335408267,ExpressionUUID->"594ed8cb-b934-0448-b7f1-adcce18793a8"],

