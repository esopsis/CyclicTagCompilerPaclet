Cell["A window of symbols that no rule matches is left unchanged.", "Notes",
 CellID->13507354,ExpressionUUID->"28255590-76f3-4439-a865-41cb298d95ff"],

Cell["\<\
To be compiled, every step must replace its window by the same number of \
symbols, all the rules of a step must have left-hand sides of the same \
length, and offsets must not be negative.\
\>", "Notes",
 CellID->274010169,ExpressionUUID->"7ff9d4f6-2347-4650-9c53-159e415f67e6"],

Cell[TextData[{
 "The ring machine uses the symbols from 0 to ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3a2ccfc9-f05c-495c-8dcb-fe4478ff7cff"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "909c33a7-bcfa-43a1-8b48-205f0e320a6f"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5511da2f-b035-4836-91f4-709c9eaaf9c1"],
 " and one more than the largest symbol written explicitly in the rules. \
Symbols computed by a right-hand side such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Mod"]], "paclet:ref/Mod"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["x", "TI"], " ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1b54cf6f-68e5-493a-83a6-abdbeb89c01d"],
 " are not counted, so give ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7902e215-2ffb-4fc2-85b2-4c09782b6d58"],
 " for rules like that. The default value of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "225a8750-3314-4590-a9cb-cb869c97cb55"],
 " is 2."
}], "Notes",
 CellID->787543564,ExpressionUUID->"de494a61-e62d-4178-8b36-6d1fb89d8bba"],

Cell[TextData[{
 "The compiled rule only works for tapes of length ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f9674e21-c2e4-4aa6-b333-652e2b627408"],
 "."
}], "Notes",
 CellID->607957227,ExpressionUUID->"7765eecc-3da9-4b99-974c-0b82cae6b33a"],

Cell[TextData[{
 "Run the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "144e8274-aefc-463e-b55a-3ba2ec9680eb"],
 ", starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ObliviousRingMachineToCyclicTagInit"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagInit", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["rule", "TI"], ",", " ", 
    StyleBox["tapeStates", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b8c2994c-f6af-46be-8880-4e81f54ece84"],
 " for ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ObliviousRingMachineToCyclicTagSteps"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["rule", "TI"], ",", " ", 
    StyleBox["tapeLength", "TI"], ",", " ", 
    StyleBox["tapeStates", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ecc8904-3afa-4191-a04a-1e49129b6c14"],
 " steps, and decode its evolution with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToObliviousRingMachine"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToObliviousRingMachine", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ba97684-8f22-4e24-8b6c-25e43b9c296b"],
 "."
}], "Notes",
 CellID->712829769,ExpressionUUID->"9e38893c-d813-42f3-8151-86d92e1fb53b"],

Cell["The following options can be given:", "Notes",
 CellID->441332887,ExpressionUUID->"5c9aa1f3-3e19-4e2d-a66d-0b7769efc08b"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "0197d334-38bb-497a-87b1-cb813d66d97b"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "472c423a-f827-428d-ae6b-defa1477e4ec"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "d41f79eb-bc43-4fdc-8bb1-f5c89d41a8b4"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "da70d52c-c657-4a46-b414-5bb93b13d225"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->180962356,ExpressionUUID->"0f350818-71ec-4f51-ab55-ef136cf9f38a"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "279c0dd5-0cf3-455f-ba4d-492b75817037"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["Automatic"]], "paclet:ref/Automatic"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "69e79d29-13ed-4386-9b90-9eac355a233c"],
 " uses as few cells as possible."
}], "Notes",
 CellID->336841787,ExpressionUUID->"9d0cbceb-41b9-479e-bc97-9fb6726d5d8f"],

Cell[TextData[{
 "The rule, initial condition, step count and decoding of one compilation \
must all use the same number of symbols and the same ",
 Cell[BoxData["\"\<TargetSystem\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bbd2182a-2685-4981-9577-9b7cca5142ce"],
 " setting."
}], "Notes",
 CellID->626997659,ExpressionUUID->"17f4bcfe-2324-4caf-b459-975662fbb3ba"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "636f955a-eeea-4b1b-a319-31fabc757649"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a2ff288-abd9-489a-b008-b90e3a21cb6c"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100070,ExpressionUUID->"aedc2b72-a23b-4be7-9292-7134f2161f09"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ed1342ce-4289-41b9-9949-4cde314b17f6"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100077,ExpressionUUID->"d637df88-c62f-4f34-aad1-d0bc13b29625"],

Cell[TextData[{
 "No other setting is implemented yet. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachineToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d99a40a5-1023-4cb3-9688-da6a250fbf29"],
 " stays unevaluated when it is given any other value, rather than quietly \
compiling something else."
}], "Notes",
 CellID->707100084,ExpressionUUID->"5222f60d-e20e-475e-b71f-710b801c45da"]
}, Closed]],

