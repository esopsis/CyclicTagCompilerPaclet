Cell["A window of symbols that no rule matches is left unchanged.", "Notes",
 CellID->13507354,ExpressionUUID->"688abd08-17a1-374c-a401-c19bbe6f8eb2"],

Cell["\<\
To be compiled, every step must replace its window by the same number of \
symbols, all the rules of a step must have left-hand sides of the same \
length, and offsets must not be negative.\
\>", "Notes",
 CellID->274010169,ExpressionUUID->"00235814-fd39-6046-b1bf-3e163c2bc3d9"],

Cell[TextData[{
 "The ring machine uses the symbols from 0 to ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5ca96b9c-d145-be46-8e24-88c80cc8475a"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3bc87e2a-18a5-004d-ae03-1088cef8b057"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "85a0ca9d-38b2-5d48-b051-e013ed84aa66"],
 " and one more than the largest symbol written explicitly in the rules. \
Symbols computed by a right-hand side such as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Mod"]], "paclet:ref/Mod"},
    "RefLink",
    BaseStyle->{"InlineFormula"}], "[", 
   RowBox[{
    StyleBox["x", "TI"], " ", 
    RowBox[{
     RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15bd5ed7-179c-0a47-90c6-fcc5a091c713"],
 " are not counted, so give ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "40d87799-6f91-4d4f-af3a-b5b1d85678ff"],
 " for rules like that. The default value of ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5379bea9-81ee-cf4b-91fd-2373ecf30eba"],
 " is 2."
}], "Notes",
 CellID->787543564,ExpressionUUID->"55a45d5d-689f-d24d-bb60-6ff2c677d679"],

Cell[TextData[{
 "The compiled rule only works for tapes of length ",
