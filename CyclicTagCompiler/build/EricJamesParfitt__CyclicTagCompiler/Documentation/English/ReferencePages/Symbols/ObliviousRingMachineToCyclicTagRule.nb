  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47558215-71b4-714b-9430-56f78a58999f"],
 "."
}], "Notes",
 CellID->607957227,ExpressionUUID->"82c8d04e-f0a6-604e-9e41-ba5ef35b1c40"],

