Cell[TextData[{
 "Rule numbers are as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "27e62dbc-f299-6a4d-babf-b019da979960"],
 ". The range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a131b67a-90ca-194f-b317-0e1bbd3846ec"],
 " can be a positive integer or half-integer; a cell's neighborhood has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "159f6b7d-630e-c04e-bc1c-b8f83d426820"],
 " + 1 cells."
}], "Notes",
 CellID->100621534,ExpressionUUID->"bb0e45c6-8573-4f43-88a0-50d2e47cd27f"],

Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->480994756,ExpressionUUID->"6c8bc035-f491-9946-a984-2a7c8327da08"],

Cell[TextData[{
 "The cyclic tag rule is compiled once, when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CompiledCellularAutomatonToCyclicTag"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rule", "TI"], ",", " ", 
    StyleBox["tapeLength", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "38997cc6-ebfe-f945-9c41-d343f9970fa6"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c800a9bf-6453-6e49-b7d3-b807fc986766"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15d731b0-9212-164c-b777-6873a20c2671"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee9a9994-27d7-1b4a-a56d-36a0e7787ff7"],
 ", and decodes its evolution."
}], "Notes",
 CellID->908366149,ExpressionUUID->"6b48039d-4c5f-0546-a78f-8bcbcb0d777e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "24e47509-5b9c-7d42-9d22-6fb4232aed32"],
 " must have ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c3c70e28-ee04-4c40-9e81-d4ceb594525a"],
 " cells."
}], "Notes",
 CellID->90235160,ExpressionUUID->"ca96dea6-958b-ce4f-980f-5e464e133090"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f2914bc1-fbb3-2041-a74f-dda1ef1b6512"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f8d10e6-bf79-f146-95e0-02f85171d6a0"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->568462282,ExpressionUUID->"c99ffdfe-5146-d243-86dc-3b721093b2ba"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4ab5e164-18b4-6c4b-82f2-1bd1fe1d4f1a"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4f9fc651-ea7b-8b49-b02d-80083295d990"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "25a72e30-7a5e-5446-84f4-e868168995d2"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c6b082d2-78ea-c044-8ea8-11f7f4cd7b2a"],
 ", for any number of steps."
}], "Notes",
 CellID->174878822,ExpressionUUID->"e38cec4a-e64f-2f4e-ab99-533c77877654"],

Cell["The following options can be given:", "Notes",
 CellID->724639951,ExpressionUUID->"5432a701-a465-e049-8000-6a63acdc6f9a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "2dac1c01-44f2-2143-bf3e-280a3dd3da4a"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"b6216c7d-27fa-1746-a212-75d7f450d696"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "1a2017f6-b728-7c45-a5b7-1e423bd3f68e"], "\"\<Mod6CyclicTag\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
\>", "TableText",ExpressionUUID->"cbb4a665-bc9a-1e4b-8809-98cb3448d815"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->247337540,ExpressionUUID->"aee85a50-6dcc-9f48-ac19-3062b2b0ca7a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Mod6CyclicTag\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90b71c9d-d349-b645-aa97-ac09fdf41fc9"],
 " compiles with ",
