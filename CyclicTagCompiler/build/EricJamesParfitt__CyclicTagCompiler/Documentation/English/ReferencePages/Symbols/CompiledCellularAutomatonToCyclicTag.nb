Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->480994756,ExpressionUUID->"ffa2f0f0-bd9d-4575-9502-0b71368794fd"],

Cell[TextData[{
 "The cyclic tag rule is compiled once, when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CompiledCellularAutomatonToCyclicTag"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rule", "TI"], ",", " ", 
    StyleBox["tapeLength", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "294038d7-5dd2-4b0f-b112-d44b4b014ac0"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "59843405-11c1-46bd-8724-685068e8a2ee"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "acd6e9c6-d42d-490a-adc0-47d63c8d449d"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "182c1ec9-15ef-427d-90ab-1b7de9947b64"],
 ", and decodes its evolution."
}], "Notes",
 CellID->908366149,ExpressionUUID->"23d01eeb-ce77-4e13-b134-e6c1027e4ddf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "abde92da-495a-499c-8e20-0d808b3d60ac"],
 " must have ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7258d200-e388-4b9e-bf28-f8929b44904a"],
 " cells."
}], "Notes",
 CellID->90235160,ExpressionUUID->"8c1e8bab-03c8-43ef-ab4c-cb0a127cb874"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8d0a3513-0b57-4072-92b6-e8445fe38a2b"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "28e29cdb-e305-414e-a456-1ad5f4254a76"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->568462282,ExpressionUUID->"ac1dca08-330b-49d7-a73d-5eb807a5181f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a099a740-1f4c-4f75-a8cc-11de52d744b1"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "44eedd1e-0433-4105-925f-4e8fb99f239b"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3959af11-12d6-460c-9a61-f62febccedf5"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1f280113-7ecf-4561-aeae-7984f715d132"],
 ", for any number of steps."
}], "Notes",
 CellID->174878822,ExpressionUUID->"2b57f701-ee5e-4bc1-8e8e-1868382f7e2b"],

Cell["The following options can be given:", "Notes",
 CellID->724639951,ExpressionUUID->"acafd109-443c-4262-9432-c7b368d27679"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "80eeedfa-1294-4d3e-b4a4-048f1b16b775"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"af8a8fa5-5976-4c13-bf95-b0b9bd08f7c0"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "e2f9cafe-407a-46e5-9235-37e896fbfe77"], "\"\<Mod6CyclicTag\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
\>", "TableText",ExpressionUUID->"b88cb529-db2f-4cb9-8a20-cc6706d63592"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->247337540,ExpressionUUID->"c9316080-882c-43a5-917f-1c4247fb6d30"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Mod6CyclicTag\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "496b9cef-daff-4c81-8c06-ee0438281b8e"],
 " compiles with ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c95e5e24-a6c2-4b54-91ee-e1e2f20893ce"],
 "."
}], "Notes",
 CellID->186814081,ExpressionUUID->"5f4bf922-5678-4f48-bf6e-06fb1855a2ba"]
}, Closed]],

