  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eba3cc5b-85be-b840-9abf-e5d8366a82f6"],
 "."
}], "Notes",
 CellID->186814081,ExpressionUUID->"544a9738-fba0-8b48-a4c0-8b5ec044adcf"]
}, Closed]],

