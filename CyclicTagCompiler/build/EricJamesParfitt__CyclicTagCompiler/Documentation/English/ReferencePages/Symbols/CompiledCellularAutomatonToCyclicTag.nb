Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"30", ",", " ", "7"}], "]"}], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", 
      " ", "0", ",", " ", "0"}], "}"}], ",", " ", "3"}], "]"}], " ", "===", 
  " ", 
  RowBox[{"DecodeCyclicTagToCellularAutomaton", "[", 
   RowBox[{
    RowBox[{"CyclicTagSystem", "[", 
