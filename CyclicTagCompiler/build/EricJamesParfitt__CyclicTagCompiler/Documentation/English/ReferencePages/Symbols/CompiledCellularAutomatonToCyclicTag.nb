  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b46f8485-c1c2-324c-9e76-d2bb917b5bc1"],
 " is evaluated. The function it gives compiles ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "74364072-91ea-c345-820d-454f9c07729e"],
 " and ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b43e48ed-530a-1844-a753-5586b07ec408"],
 ", runs the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9308fd6-8700-8a4d-ae47-f6e367e983f2"],
 ", and decodes its evolution."
}], "Notes",
 CellID->908366149,ExpressionUUID->"db669c7b-c75b-9b40-8dd6-deb466c39cb5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "252a549e-1fbb-c645-abb8-300b0a3be9fa"],
 " must have ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dff44969-05dd-8443-ba10-34a26e2272e5"],
 " cells."
}], "Notes",
 CellID->90235160,ExpressionUUID->"466f52e3-12b0-0245-895b-ef736a7fe268"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2a94750-272b-d647-9f48-d6784dc240d6"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "49542133-a078-f940-b18a-507aea87125d"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->568462282,ExpressionUUID->"de9ee956-49d4-7345-853f-7d7c8184715d"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4da02479-bfc8-3b42-b72a-eab0f45075c3"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "36ab1bef-bbc9-cb46-9b93-15c38f16e1b2"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b82a9893-0ebe-8a4c-a0da-182311610f1e"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "463fa98e-3acd-8840-93bb-330b5ec1b26b"],
 ", for any number of steps."
}], "Notes",
 CellID->174878822,ExpressionUUID->"f85d92bb-a7cb-6345-a86d-d9565fa810c6"],

Cell["The following options can be given:", "Notes",
 CellID->724639951,ExpressionUUID->"e9078020-8d84-f448-832d-c36f65944f5e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "1e41798a-54fc-f044-96ac-bfdd79965b6b"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"09deee02-b968-cb42-bf0d-aa5e3adadc39"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "078bda7b-f7a7-024d-b4e2-197fd7ccacc9"], "\"\<Mod6CyclicTag\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the number of cyclic tag appendants must be a multiple of 6\
\>", "TableText",ExpressionUUID->"5bff91cb-f267-fa46-ba00-ee53c7a2b043"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->247337540,ExpressionUUID->"60add538-d6df-8848-8ece-c1f8c184558e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Mod6CyclicTag\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50f682d1-e384-3542-848f-f9e8597b65a6"],
 " compiles with ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "765efeea-a046-2340-b016-ca9f1464e77a"],
 "."
}], "Notes",
 CellID->186814081,ExpressionUUID->"f78d3b1a-811e-6347-b0d7-ede2b4eab606"]
}, Closed]],

