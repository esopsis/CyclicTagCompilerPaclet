 ". Give that number as ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f8ba1a3-f0a5-7944-b2e2-3ebe01a02e1a"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToCyclicTagInit"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagInit", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3a398184-bcee-1049-bdbc-c64b286ae069"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToCyclicTagSteps"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6a6b31c6-0633-7145-9789-20a687d668e5"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToCellularAutomaton"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToCellularAutomaton", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "14e562fd-3904-1748-8f9d-8dd15a5989f0"],
 ", along with the range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ed8e987e-4744-fa42-b514-149d6ccd2998"],
 "."
}], "Notes",
 CellID->441483679,ExpressionUUID->"99a913f6-ac20-7f40-a752-4a6309e4398c"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9774321f-53f5-7e41-be9f-41791b86c963"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2296943a-f090-b743-8b59-759edce0a99b"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->874619473,ExpressionUUID->"60440d1c-0f56-6d4d-82e8-364d5caa8ebe"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "968d0bf3-eda4-5942-9ec0-86704898b134"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5830845f-b900-3440-ac65-5f7a6b176327"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bb051865-5e52-0f41-bed0-9687d00f17ea"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3675c2bd-8960-d342-8713-db0c278765a3"],
 ", for any number of steps."
}], "Notes",
 CellID->868046238,ExpressionUUID->"bebed5bb-778d-f644-93e2-ea030e64d38d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CompiledCellularAutomatonToCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2d1cd6f3-0621-3440-9ce3-5c443423cd7a"],
 " compiles a cellular automaton and returns a function that runs it as a \
cyclic tag system."
}], "Notes",
 CellID->91467062,ExpressionUUID->"98b4a553-feab-fe4b-b25c-0f247de81bc0"],

Cell["The following options can be given:", "Notes",
 CellID->312287515,ExpressionUUID->"70b229a6-dcdf-1c4f-a132-d1676a748b69"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "299186ae-7c31-6d41-b021-ad68125785ca"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"97e40305-1a38-7446-b039-e60bd2082f6f"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "7db29e10-1415-be44-b842-4271133dabef"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "c943d4f8-fe58-8b4b-9bbd-b0bbf3ab4a3b"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->58756779,ExpressionUUID->"5f94cd98-02eb-c643-969f-57d55713918d"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf23330a-1f7a-1a47-b0fa-38cd96efda39"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["Automatic"]], "paclet:ref/Automatic"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f4c6df1-8586-e742-a6a5-c39e6a95e033"],
 " uses as few cells as possible."
}], "Notes",
 CellID->293989439,ExpressionUUID->"8413d8bb-d787-274b-9e70-c8ad8bbf2253"],

Cell["\<\
Use the same option settings for the initial condition, step count and \
decoding.\
\>", "Notes",
 CellID->274885413,ExpressionUUID->"be07274e-50b9-4346-a02f-ce10f1be451e"]
}, Closed]],

