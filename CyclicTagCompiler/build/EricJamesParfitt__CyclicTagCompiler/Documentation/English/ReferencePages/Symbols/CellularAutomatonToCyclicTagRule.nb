  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "022d0e11-b03a-4486-b5aa-2430ae3040c1"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToCyclicTagInit"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagInit", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3016c9d0-7624-4452-8f9c-44a43f0aca71"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToCyclicTagSteps"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "25b9b94d-1e74-4f72-b1bf-70a5fb7b0897"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToCellularAutomaton"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToCellularAutomaton", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "13b08e17-c8c2-4e00-ba53-82e90cd72bd2"],
 ", along with the range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "55631e97-b897-4834-8c79-db6f92eddfdc"],
 "."
}], "Notes",
 CellID->441483679,ExpressionUUID->"351d0935-8011-4545-8dc4-0a9bb4d5472f"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "631817c2-cf50-40b3-8003-d51b59879770"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae62720f-dd5f-46a5-8bf5-662aeb26f04f"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->874619473,ExpressionUUID->"ba773a4b-f39e-4a12-9e2c-1598f15b4802"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b6db414-0a6a-4934-a466-78399a88b388"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fd9babfa-4648-4dad-8620-a246fd366299"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "528da168-ff9f-446e-a70d-2929246a2eaa"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "da090955-ef9b-4cfc-9fc6-9fc4b64e163b"],
 ", for any number of steps."
}], "Notes",
 CellID->868046238,ExpressionUUID->"cf382140-44fd-4a0b-83c6-59ed0b9df026"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CompiledCellularAutomatonToCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledCellularAutomatonToCyclicTag", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c51bdc4c-cfbe-497f-9624-2a5f6ccfe822"],
 " compiles a cellular automaton and returns a function that runs it as a \
cyclic tag system."
}], "Notes",
 CellID->91467062,ExpressionUUID->"adc7d833-5341-401d-aeeb-b8be1cd4adc8"],

Cell["The following options can be given:", "Notes",
 CellID->312287515,ExpressionUUID->"a82bd177-e588-4492-a398-c75064a7eb7e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "303cbddf-8f93-41f1-ab56-ef320371d539"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"07982804-7ce8-42d8-991b-8959df2126be"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "5c204f0e-1154-4c58-b256-2a0125da9b03"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "9a7cf01c-7d21-430c-89dd-b583c30a6540"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "1bc53d09-6523-4b7c-a8bc-09e7eabf3e91"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "570915dd-6098-4905-b60a-bb9ca9c3def9"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True}}}},
 CellID->58756779,ExpressionUUID->"4cbf519e-0008-47e4-9468-fe5b12e8cbc4"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c40c1420-1eeb-4296-86c2-504514c1503e"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["Automatic"]], "paclet:ref/Automatic"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47b75455-d955-4136-9b49-ba5319f7bfc3"],
 " uses as few cells as possible."
}], "Notes",
 CellID->293989439,ExpressionUUID->"1cb23d4a-8b30-477f-9b95-ef0c72741863"],

Cell["\<\
Use the same option settings for the initial condition, step count and \
decoding.\
\>", "Notes",
 CellID->274885413,ExpressionUUID->"fad49150-ed0c-4b05-8129-565f67c3bfe8"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "521e581d-bfa3-48d5-ba87-6b9df9ed4eb3"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "486882d6-ddfd-4daf-bdae-26d126649f9a"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100133,ExpressionUUID->"59b72257-a107-403e-b1ef-7b7d70e81ec7"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5e82ac64-f69c-421e-a889-1f2ad5d65f7d"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100140,ExpressionUUID->"e8086980-fec6-41cc-94ce-a0d36240dd0a"],

Cell[TextData[{
 "No other setting is implemented yet. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c0f63bfc-08bb-414e-8410-581cd97e775b"],
 " stays unevaluated when it is given any other value, rather than quietly \
compiling something else."
}], "Notes",
 CellID->707100147,ExpressionUUID->"107ed4b5-36b6-45ff-b299-41fa6c170d82"]
}, Closed]],

