Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["rules1", "TI"]}], ",", " ", 
   StyleBox["inputs1", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label1", "TI"], 
    RowBox[{"}", ",", " ", "{"}], 
    StyleBox["rules2", "TI"]}], ",", " ", 
   StyleBox["inputs2", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label2", "TI"], 
    RowBox[{
     RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eb478789-9c85-4658-a066-eb92bd352834"],
 " of automata, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "73dca0e0-9348-4890-8f4e-8593d8715b68"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->56931960,ExpressionUUID->"f6c205cd-9804-4c21-8296-f1704d06b9ba"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c21ae435-4a3c-4077-a4bb-73ffd1ba85be"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], "_"}], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["y", "TI"], 
      RowBox[{"_", "}"}]}], " ", ":>", " ", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Mod"]], "paclet:ref/Mod"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      RowBox[{
       StyleBox["x", "TI"], " ", "+", " ", 
       RowBox[{
        StyleBox["y", "TI"], 
        RowBox[{
         RowBox[{",", " ", "2"}], "]"}]}]}]}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "594568a2-c256-4402-b5df-ce1bb81bdcd8"],
 "."
}], "Notes",
 CellID->7034549,ExpressionUUID->"cb81ccb1-1706-42a7-af65-f64f6bb9ec95"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->727242809,ExpressionUUID->"d73ba0b1-cc33-462f-9af9-f09fd0dc7c00"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6a4c5e19-e3ec-4432-98ae-bf36e0f2a742"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83acc175-1cab-4ea2-ae4b-4a4e5b1a3b9f"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6540281-a6d6-4011-b3ae-4a76ac59ad42"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "582d6572-966d-4c1a-a47e-ce3f20d86ed3"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], 
     RowBox[{"_", "}"}]}], " ", ":>", " ", 
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Mod"]], "paclet:ref/Mod"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     RowBox[{
      StyleBox["x", "TI"], " ", 
      RowBox[{
       RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "357f6cb1-1f7f-4f3e-b139-fd7490d31a11"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1732dc63-8c72-4c43-b7fb-0b040a1509d8"],
 " is 2."
}], "Notes",
 CellID->604155449,ExpressionUUID->"f9764b72-6f3d-430d-bb4b-a51e13721d4a"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ef9f200-4c13-4904-88eb-9fc2991446db"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->916940783,ExpressionUUID->"d73af495-370a-4083-a7c2-5365bbb9c8ae"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa9214d2-0c4a-4f6b-95a5-30bbcb26c4a3"],
 " compiles the network to an oblivious ring machine with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkToObliviousRingMachineRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToObliviousRingMachineRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a73e24fe-48ed-4362-b8ec-35ba25c48554"],
 ", and that to a cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachineToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b3bcb733-99d7-43fa-993d-855a18caf531"],
 "."
}], "Notes",
 CellID->78500321,ExpressionUUID->"3bdd71b0-86df-4d02-8795-1f981d514d22"],

Cell[TextData[{
 "Run the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8558ffda-d550-4870-b09a-9d8a4ed640cd"],
 ", starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AutomataNetworkToCyclicTagInit"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagInit", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["network", "TI"], ",", " ", 
    StyleBox["states", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aaf65f1c-32c8-470d-b2db-109879cf13d5"],
 " for ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AutomataNetworkToCyclicTagSteps"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["network", "TI"], ",", " ", 
    StyleBox["states", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82a165f1-2694-4ead-a001-83320f3155f9"],
 " steps, and decode its evolution with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToAutomataNetwork"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToAutomataNetwork", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3006fcb8-24b0-41b8-a1b7-9a4348befd59"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CompiledAutomataNetworkToCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CompiledAutomataNetworkToCyclicTag", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5e2255da-5023-4608-9e46-caf08131eb48"],
 " does all of this."
}], "Notes",
 CellID->146613073,ExpressionUUID->"0c720605-e329-4289-baed-3c6b4976597a"],

Cell["The following options can be given:", "Notes",
 CellID->623592424,ExpressionUUID->"11740b26-e5af-442e-aa54-593e0d590cc7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "fc3794c8-79d7-4213-a0c1-acc1064c5178"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "c2b56872-7f1c-48bb-b9e2-0928e969d843"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "1713e6a7-09e0-4e01-8ff4-6bdb0ecdf513"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "6678dd47-72d7-4d40-8833-ed37aaded29a"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->263528891,ExpressionUUID->"7e942584-979e-4e38-aa8e-ad5222c80b1c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "389e3bfb-0633-4ccf-aeae-1edc3d6744d8"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["Automatic"]], "paclet:ref/Automatic"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "185cd879-cb4a-4e20-8ec5-15e62775648f"],
 " uses as few cells as possible."
}], "Notes",
 CellID->32354045,ExpressionUUID->"ba497c35-fb32-4dfe-b29e-004fa2eb3588"],

Cell[TextData[{
 "Use the same ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebb5f1c1-d3b4-4844-a74f-a58b01a13a52"],
 " and option settings for the rule, initial condition, step count and \
decoding."
}], "Notes",
 CellID->647436844,ExpressionUUID->"db3c9475-afae-4418-9565-9473c3a96aae"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "acf9a257-c61c-4323-90ef-164158a23001"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c062da5b-63bc-4f69-a715-55ed3c4e51ad"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100196,ExpressionUUID->"1c1662e8-9f65-4e04-9e10-a4245bdff545"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77839bd9-cb4f-4255-8793-0f3195653d5d"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100203,ExpressionUUID->"dbf5941f-0ade-4ea4-bbaa-41bc7ebdbae8"],

Cell[TextData[{
 "No other setting is implemented yet. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5356b4ed-91f6-467a-ae2f-c4fd0c51dc47"],
 " stays unevaluated when it is given any other value, rather than quietly \
compiling something else."
}], "Notes",
 CellID->707100210,ExpressionUUID->"7919ec24-d9bb-471f-a705-7103aab590a2"]
}, Closed]],

