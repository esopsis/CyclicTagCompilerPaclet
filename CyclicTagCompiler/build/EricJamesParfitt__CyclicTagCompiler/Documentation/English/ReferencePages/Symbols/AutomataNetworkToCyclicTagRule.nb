Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["rules1", "TI"]}], ",", " ", 
   StyleBox["inputs1", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label1", "TI"], 
    RowBox[{"}", ",", " ", "{"}], 
    StyleBox["rules2", "TI"]}], ",", " ", 
   StyleBox["inputs2", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label2", "TI"], 
    RowBox[{
     RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0e4b3619-9bab-0943-8386-9bf98017eec9"],
 " of automata, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "679884dc-6c95-4f4b-8c2d-a0e80347a162"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->56931960,ExpressionUUID->"594dff7b-2c1f-4843-8963-c8401483c7bf"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ca94c52e-6f7f-8c4d-b795-62210d17d15f"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], "_"}], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["y", "TI"], 
      RowBox[{"_", "}"}]}], " ", ":>", " ", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Mod"]], "paclet:ref/Mod"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      RowBox[{
       StyleBox["x", "TI"], " ", "+", " ", 
       RowBox[{
        StyleBox["y", "TI"], 
        RowBox[{
         RowBox[{",", " ", "2"}], "]"}]}]}]}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bdafc90a-5eb6-f44a-81e7-09ef357280a2"],
 "."
}], "Notes",
 CellID->7034549,ExpressionUUID->"53297a66-0985-a847-bb7b-468077388a35"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->727242809,ExpressionUUID->"35494548-1ccf-bd4c-9463-5fc26a0c107d"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72ab27f4-6301-e044-96cb-cd9dfcde9aba"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5baf947e-e4ff-0641-b6e1-da5edf1b7020"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e4702aee-2bbc-3349-9622-7f78b6610224"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9b707c5d-5ee1-a941-a743-e0caf517aca9"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], 
     RowBox[{"_", "}"}]}], " ", ":>", " ", 
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Mod"]], "paclet:ref/Mod"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     RowBox[{
      StyleBox["x", "TI"], " ", 
      RowBox[{
       RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ce00497b-6432-cd46-9fe7-511b67cc2bf2"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66a2f9e1-faa8-3d4c-b1ed-70d7ffd1c0a6"],
 " is 2."
}], "Notes",
 CellID->604155449,ExpressionUUID->"cce37a1a-b16f-f44f-bc61-77ee0f5d86ff"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "80e2e3b3-b53c-d24e-91f2-1d9ce463ee5e"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->916940783,ExpressionUUID->"fef2826d-9fd6-9f46-b5ed-ef56651c55db"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6468b135-2302-3b47-a15b-db44e2505749"],
 " compiles the network to an oblivious ring machine with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkToObliviousRingMachineRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToObliviousRingMachineRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c1c99425-a6b2-4f44-9b38-f1b287886c63"],
 ", and that to a cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachineToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd7bc693-3fc4-4d40-af9e-65e2b299653f"],
 "."
}], "Notes",
 CellID->78500321,ExpressionUUID->"a26b3b92-4d7a-9b49-8d98-d75c662557ec"],

Cell[TextData[{
 "Run the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08e0afda-ebb8-3442-9f94-50ae747c57d0"],
 ", starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AutomataNetworkToCyclicTagInit"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagInit", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["network", "TI"], ",", " ", 
    StyleBox["states", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9cf96121-9015-fb43-b8ff-64dc522f34b8"],
 " for ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AutomataNetworkToCyclicTagSteps"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
AutomataNetworkToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["network", "TI"], ",", " ", 
    StyleBox["states", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "85a07b87-d670-8d42-8b98-6c8408fab51e"],
 " steps, and decode its evolution with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToAutomataNetwork"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToAutomataNetwork", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b330f22-a044-cc44-bdac-93e20517d626"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
