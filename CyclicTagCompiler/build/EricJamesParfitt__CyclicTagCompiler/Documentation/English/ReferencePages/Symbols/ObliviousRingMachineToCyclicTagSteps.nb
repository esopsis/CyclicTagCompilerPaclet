Cell[TextData[{
 "Each ring machine step takes a number of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "93b35238-26fa-4ee7-a0a4-de6162ed5e86"],
 "-ary cyclic tag steps given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachineToNaryCyclicTagSteps"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToNaryCyclicTagSteps", "EricJamesParfitt Package Symbol"},
   
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee079382-b779-46ed-a114-3acdeaa39165"],
 ", and each of those takes one cyclic tag step for each ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f6255f50-3dcf-428d-9c65-d52d236add54"],
 "-ary symbol."
}], "Notes",
 CellID->418923948,ExpressionUUID->"ddd76905-3cf9-4e2a-9652-defc0253c80c"],

Cell[TextData[{
 "Give the same ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a0d07b6b-b8e0-4c58-a25c-c25a8d700ff0"],
 " and ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "434f1d0d-f99c-4f43-84c4-1e47113fb5d5"],
