Cell[TextData[{
 "Each cell becomes a block of ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "430c1619-bde2-4159-8520-1cb0abad9024"],
 " + 2 cyclic tag cells that are all 0 except for a single 1."
}], "Notes",
 CellID->63551632,ExpressionUUID->"0a868408-11aa-49b3-a69b-1cb86311e9a1"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8f04e15-b93e-4a2a-98a1-2b3931526c67"],
 ", the tape starts with 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c11c13f-f701-4958-8361-7f78c144cba8"],
 " extra cells, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToObliviousRingMachineInit"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToObliviousRingMachineInit", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "feec1329-a1c8-4fa2-99c4-76dadef67dc4"],
 "."
}], "Notes",
 CellID->982088512,ExpressionUUID->"6b7652b0-333d-4e5b-a62f-07df627693d4"],

Cell["The following options can be given:", "Notes",
 CellID->410809577,ExpressionUUID->"dafc108b-ef10-4b71-acc9-a446979dd373"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "357fd1c7-69fa-415d-a938-37a803e9cb2a"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"55c09065-f291-47ba-b3ce-60e4aa441ab5"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "ee88897d-5c3b-4882-b8a1-f51326ac1a73"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "c96c8d80-d330-4bb6-8168-f69bf26a22c3"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "1808b995-56ed-44ba-8a0a-1afe4f78dabb"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "78e43be8-0fef-4899-843c-8d57dc2d9a55"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True}}}},
 CellID->526579041,ExpressionUUID->"a19bef0c-3b70-419a-bc68-1d0405f8d5ba"],

Cell[TextData[{
 "Use the same ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8b546d8c-d9fb-47db-a272-557c136aee49"],
 ", ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "206ff01a-0d18-4145-bdd0-9fde57f8f2ca"],
 " and option settings as for the rule, step count and decoding."
}], "Notes",
 CellID->297567740,ExpressionUUID->"a3a81fb7-b53b-4675-be11-a4145ba95c04"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9508fdac-1650-4519-a260-87f52bfdece1"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "edfb659a-8912-4b92-b793-5d6eddd5056e"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100154,ExpressionUUID->"75799618-2a35-4e40-b2a7-355a2c6a7545"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa2eafa1-b898-4fdf-ab29-b0efd213b7ab"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100161,ExpressionUUID->"1618ea80-76a0-49b0-9d6a-57b0eb5d93cc"],

Cell[TextData[{
 "No other setting is implemented yet. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToCyclicTagInit"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagInit", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0cb660b4-e04b-4bc6-91ac-ad03166db090"],
 " stays unevaluated when it is given any other value, rather than quietly \
compiling something else."
}], "Notes",
 CellID->707100168,ExpressionUUID->"415c4a64-ca56-4fbc-943f-4f0f778c277f"]
}, Closed]],

