Cell["\<\
An automata network is a set of automata, each of which has a state. At each \
step, each automaton computes its new state from the current states of \
certain automata in the network, called its inputs.\
\>", "Notes",
 CellID->616324255,ExpressionUUID->"14ccb030-fba6-46f3-96a5-562a7257f081"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rulesi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6119de93-3473-483b-bbf9-5d2cd57861a9"],
 " is a list of rules of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["x1", "TI"], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["x2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}], " ", "->", " ", 
     StyleBox["y", "TI"]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b6926da9-bad4-4fa3-91c5-4787f6db0a53"],
 ". At each step, the first rule whose left-hand side matches the list of the \
current states of the automata ",
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "453bfa8a-ba02-4104-b590-16289dff07bf"],
 " gives the new state ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a684d0b5-7af2-483a-8cda-8d6a5e82c1b3"],
 "."
}], "Notes",
 CellID->21850030,ExpressionUUID->"bab4ccfd-70ab-40b3-a771-a881c8617b2e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "95e28df5-f8b7-475a-9dbc-40044db91a53"],
 " is a list of labels of automata. It can include ",
 Cell[BoxData[
  StyleBox["labeli", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "abe49a31-7a9c-4233-818d-1882ef31a2e3"],
 " itself, and it can contain the same label more than once."
}], "Notes",
 CellID->172687368,ExpressionUUID->"27fdf15b-d45d-4ab9-a42c-6015b59bd45b"],

Cell[TextData[{
 "Labels can be any expressions, such as integers or strings. They are used \
only to refer to automata in ",
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76feadef-23b0-41c5-a208-d97eb2508634"],
 ", and do not have to match the positions of the automata in the list."
}], "Notes",
 CellID->933571231,ExpressionUUID->"26906f57-067d-488c-8fef-c59c742935f3"],

Cell["\<\
All automata are updated at the same time, using the states from the previous \
step. This is known as parallel or synchronous updating.\
\>", "Notes",
 CellID->672622872,ExpressionUUID->"a388aded-d81b-43e5-8586-dd590ae6ccf5"],

Cell[TextData[{
 "States can be any expressions. ",
 Cell[BoxData[
  StyleBox["rulesi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8e02c093-5c4f-4d20-985b-4ae66b39e3d4"],
 " can use patterns, conditions and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RuleDelayed"]], "paclet:ref/RuleDelayed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c961bb7-2283-4bd3-aa64-ca14cdc03da8"],
 "."
}], "Notes",
 CellID->386912160,ExpressionUUID->"dedbb5be-e9ce-4a7e-b9af-71b043a6feea"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "36e8316d-bd4c-4d82-bd63-9174b3e209c4"],
 " is a list of initial states, in the same order as the automata. Each \
element of the result gives the states in that order."
}], "Notes",
 CellID->528157382,ExpressionUUID->"0b0f938b-1950-4e61-985b-166ad2bfd0d1"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AutomataNetworkRun"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
     "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["network", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a7ed58d7-5e31-412a-a802-aa5c20ba672e"],
 ", each automaton has the form ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", "{"}], 
       StyleBox["rulesi", "TI"]}], ",", " ", 
      StyleBox["si", "TI"]}], "}"}], ",", " ", 
    StyleBox["inputsi", "TI"], ",", " ", 
    StyleBox["labeli", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e10a57b3-cbc6-4151-bfd7-24795f6f3229"],
 ". The result is a list of ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "07fe0dce-95fd-4718-8ba6-69167ab9491f"],
 "+1 networks of the same form, in which only the states ",
 Cell[BoxData[
  StyleBox["si", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e62725a7-d841-46d4-9147-c057fa3fee3d"],
 " change."
}], "Notes",
 CellID->672425218,ExpressionUUID->"50e153e3-dbe2-46e8-ab72-06249d17c9b0"],

