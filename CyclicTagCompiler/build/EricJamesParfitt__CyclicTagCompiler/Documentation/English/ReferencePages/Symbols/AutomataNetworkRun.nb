    "keywords" -> {
     "automata network", "automaton network", "Boolean network", 
      "random Boolean network", "Kauffman network", "NK model", 
      "discrete dynamical system", "synchronous update", "parallel update", 
      "finite automata", "gene regulatory network", "cellular automaton", 
      "NKS", "ruliology"}, "specialkeywords" -> {}, 
    "tutorialcollectionlinks" -> {}, "index" -> True, "label" -> 
    "Eric James Parfitt/ Cyclic Tag Compiler Symbol", "language" -> "en", 
    "paclet" -> "EricJamesParfitt/CyclicTagCompiler", "status" -> "None", 
    "summary" -> 
    "AutomataNetworkRun [{{ rules1, inputs1, label1 }, { rules2, inputs2, \
label2 }, ...}, init, t] gives the states at each of t steps of the automata \
network in which each automaton labeli updates its state by applying the \
rules rulesi to the states of the automata inputsi, starting from the states \
init. AutomataNetworkRun [{{{ rules1, s1}, inputs1, label1 }, {{ rules2, s2}, \
inputs2, label2 }, ...}, t] gives the complete network at each of t steps, \
where si is the current state of the automaton labeli.", "synonyms" -> {}, 
