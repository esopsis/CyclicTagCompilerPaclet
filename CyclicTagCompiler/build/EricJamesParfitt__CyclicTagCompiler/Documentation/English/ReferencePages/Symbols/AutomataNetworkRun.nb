Cell["\<\
An automata network is a set of automata, each of which has a state. At each \
step, each automaton computes its new state from the current states of \
certain automata in the network, called its inputs.\
\>", "Notes",
 CellID->616324255,ExpressionUUID->"fccc0e10-e6cb-8b4b-b4c7-2bb5ad45d267"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rulesi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "06dd9f13-b9b3-884d-ba2f-b5bfe6e7ad8f"],
 " is a list of rules of the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["x1", "TI"], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["x2", "TI"], 
      RowBox[{
       RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}], " ", "->", " ", 
     StyleBox["y", "TI"]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9e9e4b7-c9a1-0a41-9e88-e70db5409f21"],
 ". At each step, the first rule whose left-hand side matches the list of the \
current states of the automata ",
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3cc446ed-9fd5-a14c-90f6-4a0b411e4c83"],
 " gives the new state ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8bd853b7-9091-dd41-8b6d-9af113f940ee"],
 "."
}], "Notes",
 CellID->21850030,ExpressionUUID->"22868b05-c92c-f64a-8f34-e06d7becc10b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ec75a9aa-9497-2e49-9502-63638d53de33"],
 " is a list of labels of automata. It can include ",
 Cell[BoxData[
  StyleBox["labeli", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bdc17943-10da-254f-bf65-5bce62e8e083"],
 " itself, and it can contain the same label more than once."
}], "Notes",
 CellID->172687368,ExpressionUUID->"a21fc7cd-7c72-824a-8122-cd3d818cd2e1"],

Cell[TextData[{
 "Labels can be any expressions, such as integers or strings. They are used \
only to refer to automata in ",
 Cell[BoxData[
  StyleBox["inputsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6443800f-1e7f-7f4e-b32b-834e573a68a8"],
 ", and do not have to match the positions of the automata in the list."
}], "Notes",
 CellID->933571231,ExpressionUUID->"712c066e-5efb-224f-ba7f-447d592a8c93"],

Cell["\<\
All automata are updated at the same time, using the states from the previous \
step. This is known as parallel or synchronous updating.\
\>", "Notes",
 CellID->672622872,ExpressionUUID->"27c8667a-c31c-ac4c-8134-d1c2da2fd608"],

Cell[TextData[{
 "States can be any expressions. ",
 Cell[BoxData[
  StyleBox["rulesi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "822558e9-350f-4f4c-aa88-5305fe41a14e"],
 " can use patterns, conditions and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RuleDelayed"]], "paclet:ref/RuleDelayed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f6a31071-5714-874c-bb30-b79bf41f54a0"],
 "."
}], "Notes",
 CellID->386912160,ExpressionUUID->"b6f37635-b282-9849-8c71-880386672b49"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3186ae0c-9e2e-ca4b-bdde-22736c8eb1fb"],
 " is a list of initial states, in the same order as the automata. Each \
element of the result gives the states in that order."
}], "Notes",
 CellID->528157382,ExpressionUUID->"f3634824-0960-5e4b-a3e0-d530df83ab8a"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["AutomataNetworkRun"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
     "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["network", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "be170b1b-ec20-e54d-b90a-487b2aee9232"],
 ", each automaton has the form ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", "{"}], 
       StyleBox["rulesi", "TI"]}], ",", " ", 
      StyleBox["si", "TI"]}], "}"}], ",", " ", 
    StyleBox["inputsi", "TI"], ",", " ", 
    StyleBox["labeli", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cc4af242-ec81-5243-a905-2c06fe23200f"],
 ". The result is a list of ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e465f9c7-e512-c340-89b5-76877bc9eeb8"],
 "+1 networks of the same form, in which only the states ",
 Cell[BoxData[
  StyleBox["si", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "97c02e1d-e9d6-d942-89e5-b001c18461f0"],
 " change."
}], "Notes",
 CellID->672425218,ExpressionUUID->"cfccf361-56fa-e142-af92-948ffd23a48c"],

