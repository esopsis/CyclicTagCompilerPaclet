 CellID->1139814335,ExpressionUUID->"408ba777-526e-4da5-90f4-cfbb79655826"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7851c6ee-ac7e-4e46-98ce-810161f32ddb"],
 " is a list of cyclic tag tapes, one for each step, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c3d9e4f-4acd-4d1c-8845-47beee65b52c"],
 "."
}], "Notes",
 CellID->658181680,ExpressionUUID->"43f50247-120b-4051-8a49-bc377252354b"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0d908bf0-290b-41fb-9bcb-ca8edd21e18d"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "70440993-5f6a-43d8-9216-efce44fad2e8"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->758568249,ExpressionUUID->"714d12b8-22af-4624-91a5-5924e2f734e5"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b990c099-0cda-47f9-9288-7a2a344f162c"],
 ", the decoded evolution is the evolution of the cellular automaton on a \
cyclic tape."
}], "Notes",
 CellID->994261163,ExpressionUUID->"775556c9-8d1c-4dfd-9c63-e67640acf689"],

Cell["The following options can be given:", "Notes",
 CellID->122127515,ExpressionUUID->"2eeed8b6-38e9-4ee7-8ca9-a0af695d0d23"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "530c4e06-5cfa-488a-bf88-1ed2d0ca9f82"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"72c056e8-ed80-4e4d-87a2-04c4b4187115"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "47550308-839a-4905-ba1a-a2ec927abb45"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "d0e4fe59-435e-4911-823b-6e8c7f130e97"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "da90d2a3-663e-4299-97ad-c4a5eb78afcb"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "bc5876f6-c8d0-4922-ba0a-1dbe802dcfd9"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True}}}},
 CellID->612779532,ExpressionUUID->"29777ffa-a984-4e56-a9e9-8c3b2a6abe35"],

Cell[TextData[{
 "Use the same ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1d12f9b-6fe6-497e-b303-650eef390801"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfddaebb-ff1b-4a32-999d-2e1134f384d7"],
 ", ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15c4eaf3-b95f-48b0-a74b-a32436840d0c"],
 " and option settings as for the rule, initial condition and step count."
}], "Notes",
 CellID->509751031,ExpressionUUID->"9f2d7c0d-2885-4aae-899d-8faf343fb6f7"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72a6b91d-f298-4dfd-8eb0-37db56bdeb0c"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a0968fdf-805b-4cc3-bc46-2f20c5b8097d"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100175,ExpressionUUID->"e2a1e3c7-47fe-4470-b46a-9af852ef6ce8"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8831a080-cce4-4af0-93ff-717218402320"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100182,ExpressionUUID->"0d6cb9e1-72f5-4fe8-9e2f-acda4ce1761c"],

Cell[TextData[{
 "No other setting is implemented yet. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToCellularAutomaton"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToCellularAutomaton", "EricJamesParfitt Package Symbol"},
   "PackageLink",
