Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c459fba9-0943-be4b-b0bc-ac5732d776b8"],
 ", the system decodes from a system that's been compiled to cyclic tag where \
each cellular automaton symbol is represented by 6 cyclic tag cells, which is \
useful for compiling / decoding further to and from rule 110."
}], "ExampleText",
 CellID->83655945,ExpressionUUID->"ecc873f4-bbe9-b541-8d09-b5e5e9a9686b"],

