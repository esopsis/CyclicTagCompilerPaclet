Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "70610a1f-f460-7940-87b9-90a878ab9693"],
 " is a list of cyclic tag tapes, one for each step, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88e488c6-3f70-b34b-9423-46ecc5d4d69d"],
 "."
}], "Notes",
 CellID->658181680,ExpressionUUID->"128f3f31-14e5-0642-9a4d-f30d84139e3c"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0c532ccc-8403-1d4a-a8f7-35401e49e9e8"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c0714b19-5634-994d-a0dd-85179d2832e1"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->758568249,ExpressionUUID->"ab0c94ef-7956-1944-aac8-9cea216a810f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f122a04f-e427-3b4b-b8e2-51a6999485dc"],
 ", the decoded evolution is the evolution of the cellular automaton on a \
cyclic tape."
}], "Notes",
 CellID->994261163,ExpressionUUID->"e2a0200a-3e1b-804f-8c2b-125c34408858"],

