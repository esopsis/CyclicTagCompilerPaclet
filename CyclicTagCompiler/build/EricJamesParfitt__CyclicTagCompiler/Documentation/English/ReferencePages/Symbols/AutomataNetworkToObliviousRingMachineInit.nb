Cell["\<\
Each automaton's state fills its block of cells: one cell for each of its \
inputs, or more if more automata read its state.\
\>", "Notes",
 CellID->625427585,ExpressionUUID->"279d7d3b-4c64-a34c-9fce-e71a7b23ba33"]
}, Closed]],

