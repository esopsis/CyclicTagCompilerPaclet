Cell[TextData[{
 "Each step of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e12db9fd-1f65-446a-9fca-09dd3be03052"],
 "-ary system takes one cyclic tag step for each symbol, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["NaryCyclicTagToCyclicTagSteps"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["steps", "TI"], ",", " ", 
    StyleBox["states", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c483a57-f349-439f-98c7-c77102f28c5f"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["steps", "TI"], " ", 
   StyleBox["states", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f464719-893c-43fe-af5b-1ef55afe2761"],
 "."
}], "Notes",
 CellID->454674479,ExpressionUUID->"2c5c875e-3248-4ec6-8128-b9d7f1247af2"],

Cell["The following options can be given:", "Notes",
 CellID->865060223,ExpressionUUID->"9ddb29f0-8ac9-4cbb-8c80-ca66f4e096ef"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "770b6c72-d625-4558-9fbe-7b18182f89ab"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "2eb2ec45-cf8d-43a9-ac3c-5caabafde38e"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "a1074fa9-88b0-4191-856f-8c3f5c9c10b8"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "9b99d528-951b-4d1e-bd4f-efe674667816"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->411602785,ExpressionUUID->"bd2cc3e1-9ccf-453e-ad70-f93c1fc20106"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ff4db904-d240-4ac4-903a-3666ca98c2c0"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["Automatic"]], "paclet:ref/Automatic"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d8716a0e-449c-4f16-a6e8-9179c229d10a"],
 " uses as few cells as possible."
}], "Notes",
 CellID->74043799,ExpressionUUID->"af74fb56-33b5-422b-bfab-bc013faa2fc1"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08d4bc71-9ead-4c69-966c-334be3ad185b"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "00242ad7-a784-4eb7-803b-eb5abd14f293"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100259,ExpressionUUID->"0907431f-c1df-4548-88fb-df9d4034206a"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a92d62b8-58c7-4468-8e01-bd2f40cea95a"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100266,ExpressionUUID->"f676250f-ca6b-42f0-9589-602c8dbd2d8a"],

Cell[TextData[{
 "The step count already accounts for the symbols that are left out, so it is \
smaller than the number of symbols alone would suggest. The setting itself is \
not checked: unlike the rule, initial condition and decoding, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTagToCyclicTagSteps"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "14f77915-914c-4caa-b213-da0a5d161c88"],
 " still evaluates when it is given a setting that is not implemented."
}], "Notes",
 CellID->707100273,ExpressionUUID->"c8e2f652-650b-4d50-bb52-8ed6d4e09725"]
}, Closed]],

