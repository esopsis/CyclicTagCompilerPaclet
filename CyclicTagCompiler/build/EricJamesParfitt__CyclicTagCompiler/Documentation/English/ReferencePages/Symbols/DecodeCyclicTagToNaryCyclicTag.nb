Cell["Run a compiled 2-symbol system and decode its evolution:", "ExampleText",
 CellID->579218294,ExpressionUUID->"ef511731-cb88-4e8b-aa29-972260e978c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rule", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
