Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "02964563-cd06-4b9f-989e-a211b19cc5d9"],
