Cell[TextData[{
 "The number of steps only depends on ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1edb1336-3709-40e4-957b-c453c771891e"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "20af7d2c-4fd0-4d4c-8d8b-2a4790b00b2e"],
 " and ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "edebfff3-82e0-4c50-ae17-57296ba9a16f"],
 ", not on the rule itself."
}], "Notes",
 CellID->313727220,ExpressionUUID->"ce3c1fad-3be3-421c-8776-33a82079a776"],

Cell["The following options can be given:", "Notes",
 CellID->83513255,ExpressionUUID->"898c90db-1a48-47d8-a4b2-cc690db58d68"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "71be357b-e760-4f68-880d-39f1beae5517"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"891650ca-3b26-486e-a0cc-b968cfdb519a"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "dd3af343-c51c-4c1c-8291-2c46e0af3228"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "0201f8b8-564b-4176-b102-e9b7691cd698"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "e06dd78c-d9c7-442f-bd74-edf932c4f9be"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "4fcb2a91-8d4d-4c40-b707-0cdf0c8f7cc9"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True}}}},
 CellID->220544316,ExpressionUUID->"3058ff20-7571-43c2-a24e-e2db8cb5aa56"],

Cell[TextData[{
 "Use the same ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0e18dbd1-882a-42c5-b8f6-86f9d381f26d"],
 ", ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f824ff2-7a49-4ee2-8c81-83cfbedbe85c"],
 " and option settings as for the rule, initial condition and decoding."
}], "Notes",
 CellID->469041455,ExpressionUUID->"475c1b93-7b5a-49d5-bdc8-7ce43f505a6a"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ad20ec6-f70f-4a4b-af4c-6a0e955f2831"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94ddb864-3642-4851-8248-a4ea625b12d5"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100301,ExpressionUUID->"b3ad0a42-cf7a-4265-95a2-46758b22a0ac"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9ea5592-dbaa-43d5-b171-b46d1aae6a82"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100308,ExpressionUUID->"5116f527-39b0-461e-962b-df8be15e72e3"],

Cell[TextData[{
 "The step count already accounts for the symbols that are left out, so it is \
smaller than the number of symbols alone would suggest. The setting itself is \
not checked: unlike the rule, initial condition and decoding, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomatonToCyclicTagSteps"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
CellularAutomatonToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a73c21df-5339-49ee-bdd4-269039e88081"],
 " still evaluates when it is given a setting that is not implemented."
}], "Notes",
 CellID->707100315,ExpressionUUID->"13a3cb2e-dc0b-495a-81bc-d6bbbbe47767"]
}, Closed]],

