Cell[TextData[{
 "Rule numbers are as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1c7ab4c1-48a6-4ee4-a994-c7a74ce8e809"],
 ". The range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98b3aed8-cde4-4b7d-9943-09d5a6154227"],
 " can be a positive integer or half-integer; a cell's neighborhood has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "135ffe9d-3637-48bd-a6d0-20a8dd8bec69"],
 " + 1 cells."
}], "Notes",
 CellID->580663496,ExpressionUUID->"b5b8ddc4-a4e9-4463-9a42-e528fd879863"],

Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->106419818,ExpressionUUID->"b6c808ef-9261-47e5-a349-8c34e45b139a"],

Cell[TextData[{
 "The ring machine sweeps along the tape. At each step it reads a \
neighborhood, writes the cell's new color into the first cell of the \
neighborhood, and moves on by one cell. After a sweep of the whole tape, the \
new row of the cellular automaton is on the tape, shifted by ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "190a1a3c-fcf2-4490-9470-e58424c4c262"],
 " cells."
}], "Notes",
 CellID->949888204,ExpressionUUID->"f60854ff-9074-44b9-9481-dc2daccf2e40"],

Cell[TextData[{
 "By default, the ring machine rule is a single step and does not depend on \
",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2fa3e48d-c04f-4bff-9a81-88d441b13df4"],
 "."
}], "Notes",
 CellID->719714773,ExpressionUUID->"1b60145d-7ff2-40c0-92ee-889730a2442f"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a562b9ec-1e91-4e9a-95c7-df22339f9b19"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a1d52fa-36cc-4aa3-8ff9-cc4c84ba71a5"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->70910718,ExpressionUUID->"b0aa1763-d585-4700-8b54-89ef7eaca80d"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "37141145-b81d-4394-b3ee-d513178ed7b1"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd7a9a98-7aca-4f19-8a68-cb5e9c44ca40"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d9e468cf-7e70-487b-9138-d092c4ba3620"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bfb4138b-fa1c-4794-ba98-ec065849b8c7"],
 ", for any number of steps."
}], "Notes",
 CellID->153579744,ExpressionUUID->"253d0456-ed62-48a3-8b48-89f7a8340f88"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "112d3cec-5b7d-48c0-bb6c-bade78fddbd3"],
 ", ",
