Cell[TextData[{
 "Rule numbers are as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a5d8855-6a0a-bf47-a797-0b10322dd0eb"],
 ". The range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8585587a-3f4e-f342-91d3-53f699d3e149"],
 " can be a positive integer or half-integer; a cell's neighborhood has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "080e86d9-5ad0-0a4f-82cf-70807186cc12"],
 " + 1 cells."
}], "Notes",
 CellID->580663496,ExpressionUUID->"35b10f18-0775-9f44-9794-299d264a6274"],

Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->106419818,ExpressionUUID->"154f63a9-31ed-e745-9abf-22f37b8d757f"],

Cell[TextData[{
 "The ring machine sweeps along the tape. At each step it reads a \
neighborhood, writes the cell's new color into the first cell of the \
neighborhood, and moves on by one cell. After a sweep of the whole tape, the \
new row of the cellular automaton is on the tape, shifted by ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "558534e8-225d-0e49-9665-bbc2a8f88568"],
 " cells."
}], "Notes",
 CellID->949888204,ExpressionUUID->"49d21006-51e4-b148-a636-9a916a93b476"],

Cell[TextData[{
 "By default, the ring machine rule is a single step and does not depend on \
",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2737222-8168-1244-bdb4-a897ada092f9"],
 "."
}], "Notes",
 CellID->719714773,ExpressionUUID->"d7b1467d-219d-204f-be61-5c7d1360a67d"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "769942d9-9c8a-c54f-be2d-580d51e487cb"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e7991e68-d643-f74f-a079-d0e324a5a033"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->70910718,ExpressionUUID->"5954482c-a698-754d-8fb1-1167c90a1641"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a26a03e1-c342-4f40-80c0-aaf05a68f611"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9530f4ec-b1fc-6f4f-9f51-f62fdd9ebe14"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2894bcc2-f870-754c-9f95-ffb4d0545a94"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "628e9c8c-a127-0b46-8370-2fbda6f1b2d5"],
 ", for any number of steps."
}], "Notes",
 CellID->153579744,ExpressionUUID->"a4b5ae27-bda3-744e-9272-942df235ee0d"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e55d5ad5-6181-c742-8257-91f075a7aad7"],
 ", ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae1a2b43-5c8b-764d-baab-a4681dc59e6e"],
 " must be given. The ring machine rule then has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3c87062f-7a6d-1e47-a053-88223bbc8c4a"],
 " steps that copy the colors of the wrapped-around cells, followed by ",
