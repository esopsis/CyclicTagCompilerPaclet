Cell[TextData[{
 "Rule numbers are as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "de3f742d-902b-f94e-91bf-127e4b158379"],
 ". The range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2577fa60-e11d-5d4d-972d-5d441e7b2ede"],
 " can be a positive integer or half-integer; a cell's neighborhood has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8e7d3d18-bf22-224e-8f89-3e1e78b57113"],
 " + 1 cells."
}], "Notes",
 CellID->580663496,ExpressionUUID->"d32e5acf-d786-1e40-83f7-39a5b9333926"],

Cell["\<\
Explicit rules must all have neighborhoods of the same length, at least 2, \
and should give a color for every neighborhood.\
\>", "Notes",
 CellID->106419818,ExpressionUUID->"1f5d8e1a-cd04-7b4f-9fc1-2484762f2b62"],

Cell[TextData[{
 "The ring machine sweeps along the tape. At each step it reads a \
neighborhood, writes the cell's new color into the first cell of the \
neighborhood, and moves on by one cell. After a sweep of the whole tape, the \
new row of the cellular automaton is on the tape, shifted by ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5f1344db-e934-6b4b-ab42-725d119042e6"],
 " cells."
}], "Notes",
 CellID->949888204,ExpressionUUID->"ddccda65-36e0-3245-a043-7496d389e4aa"],

Cell[TextData[{
 "By default, the ring machine rule is a single step and does not depend on \
",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "12d97c56-f5a7-304e-bd56-66afd6bf7ef9"],
 "."
}], "Notes",
 CellID->719714773,ExpressionUUID->"b40bd6e8-92b7-6b4f-8f79-4d70103cb0fe"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "93d27ce3-d836-5041-b8f6-d3a8ba84ff12"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c6d14ded-fb3e-5b4a-8296-25a5cca81f97"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->70910718,ExpressionUUID->"1f7909d6-b0fc-3c45-aa1d-b230642da463"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2c025efc-0694-7047-a3d3-07bd2fab9fcf"],
 ", the ring machine tape has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4087e60e-a652-4249-b207-1fd4ec712b08"],
 " extra cells that keep the old colors of the cells that wrap around, and \
the decoded evolution is the evolution of the cellular automaton on a cyclic \
tape of ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c9fe0673-6857-0646-90b4-4fb02e27519e"],
 " cells, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CellularAutomaton"]], "paclet:ref/CellularAutomaton"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7d781826-fa98-1b4f-b13f-dcbaca0c3dca"],
 ", for any number of steps."
}], "Notes",
 CellID->153579744,ExpressionUUID->"a04708d8-2043-c245-bd0e-427cba8fa80c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bae00128-4c4a-ae4f-9eeb-b8734fadd623"],
 ", ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5f865613-0e76-694c-a63d-800713f27cbf"],
 " must be given. The ring machine rule then has 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe676b6b-518d-244b-b06a-36164cf36251"],
 " steps that copy the colors of the wrapped-around cells, followed by ",
