}], "Notes",
 CellID->661946391,ExpressionUUID->"3f46e7c8-0712-7349-89d6-f9df2a6f9e77"],

Cell["\<\
If none of the rules match, the elements are not changed, but the list is \
still rotated.\
\>", "Notes",
 CellID->444454167,ExpressionUUID->"082524a6-e3ef-0a40-bc6b-01e9f52a8ccf"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "52423909-46a1-4d44-9b58-7686ce5dbd4a"],
 " rotates the list to the right. With ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "af6a7dc0-ef85-9f40-90b3-657582c7f30f"],
 " = 0, the list is not rotated."
}], "Notes",
 CellID->790945370,ExpressionUUID->"93b44087-76ad-224d-b132-bbe59e536886"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{"{", "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5086025e-5885-7c4b-b3e3-039820a9feef"],
 ", ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1e716e93-8c2a-9748-a800-ebc10d8d7c84"],
 " must return a list. The ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae506911-d695-ac4b-9be2-22b2ffe8bdd7"],
 " can also be given as an integer, which does not change the result."
}], "Notes",
 CellID->852317730,ExpressionUUID->"8cfdbdf6-8b87-1640-bb91-ea6de465d5f0"],

Cell["The rules can change the length of the list.", "Notes",
 CellID->233504404,ExpressionUUID->"09cb4e2a-0bc2-cc47-ae46-b23961ffb76f"],

Cell[TextData[{
 "The elements of ",
