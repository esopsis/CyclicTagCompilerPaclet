      FontFamily->"Source Sans Pro",ExpressionUUID->
      "3cc11510-d379-cf4b-ada6-c103d8800fbe"],
     " positions to the left"
    }], "TableText",ExpressionUUID->"da3338ec-40b6-964e-baad-f9ee6f9a4850"]}
  }]], "2ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "Rows" -> {None, None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True, True}}}},
 CellID->776731504,ExpressionUUID->"3bf16857-41ae-6145-82ff-e9e3c864dc42"],

Cell[TextData[{
 "A list of rules given as the first argument is a single step, which uses \
the first rule that matches. To use the rules one at a time in turn, give \
each one its own list, as in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["lhs1", "TI"]}], " ", ":>", " ", 
   RowBox[{
    RowBox[{
     StyleBox["rhs1", "TI"], 
     RowBox[{"}", ",", " ", "{"}], 
     StyleBox["lhs2", "TI"]}], " ", ":>", " ", 
    RowBox[{
     StyleBox["rhs2", "TI"], 
     RowBox[{
      RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ce83943d-85fd-fb41-9220-9c00746f6cf3"],
 "."
}], "Notes",
 CellID->503724010,ExpressionUUID->"0111b9a8-5775-334f-b79b-34ab91014a03"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["lhsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4aa3eb2f-5025-1947-870d-a313f1109a02"],
 " must be an explicit list. Each ",
 Cell[BoxData[
  StyleBox["rhsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b9a0ceb2-1fac-364b-9326-e7ef8bdd2986"],
 " can be any expression that gives a list when it is evaluated. Rules can be \
given with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "43439392-68b8-8746-be3a-98656ddb35b3"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RuleDelayed"]], "paclet:ref/RuleDelayed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7eae07f2-a0fa-054d-b820-13b551f59c4b"],
 "."
}], "Notes",
 CellID->490046043,ExpressionUUID->"8fa99948-3612-344f-b0f9-dff711d8a4e8"],

Cell["\<\
If none of the rules match, the elements are not changed, but the list is \
still rotated.\
\>", "Notes",
 CellID->681008507,ExpressionUUID->"b7a880b3-7bd4-a140-9f71-9cba9c8b2ae2"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3770b4d3-aeba-794e-952d-21f96ab1874a"],
 " rotates the list to the right. With ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dcb09bed-775d-624b-9158-25b486d2c48e"],
 " = 0, the list is not rotated."
}], "Notes",
 CellID->283168815,ExpressionUUID->"d119b0d7-8f26-2d40-b75b-8db125082067"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{"{", "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b91e8911-9d7b-d341-84dd-10a7874a366c"],
 ", ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7f655f1-29f8-f943-89c4-34a33688668e"],
 " must return a list. The ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e57e203-8b5a-f242-be89-0343c4d83ca0"],
 " can also be given as an integer, which does not change the result."
}], "Notes",
 CellID->288242459,ExpressionUUID->"cca0c814-6a68-db4c-986f-94834aa45749"],

Cell["The rules can change the length of the list.", "Notes",
 CellID->316063417,ExpressionUUID->"880c9e07-7364-1343-8338-f332421acbad"],

Cell[TextData[{
 "The elements of ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72f812cf-63c2-e24a-bce5-0b6e789702da"],
 " can be any expressions."
}], "Notes",
 CellID->797711827,ExpressionUUID->"c37d7400-96fd-f444-b6c5-0cc575bfc5cb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ObliviousRingMachine"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine", 
     "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["steps", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e7676f9f-6cb3-a445-8775-257babc988f4"],
 " gives a list of length ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "04add945-9c7e-3d40-9e16-0bb1b04f5720"],
 "+1 whose first element is ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "154d0aa5-2f00-4e48-9678-2c28f88bff87"],
 "."
}], "Notes",
 CellID->787255654,ExpressionUUID->"544946b8-2c7d-db44-aff2-ffcf379ffa01"],

Cell["The following properties can be given:", "Notes",
 CellID->269157274,ExpressionUUID->"476a1963-19c5-bf41-ba21-349429ff3b48"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "92a5e6c2-3681-3d49-8c74-8b10b91eadad"], Cell[
    BoxData["\"\<States\>\""], "TableText",ExpressionUUID->
     "ead5c5e0-adcd-cf45-9da2-230d951b6aec"], Cell[
    "the list at each step (the default)", "TableText",ExpressionUUID->
     "1f2a6982-e80b-4a4e-8e98-6ba0e51cc463"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "62d23e46-1889-074a-ab7e-30f61a265a0a"], Cell[
    BoxData["\"\<Rules\>\""], "TableText",ExpressionUUID->
     "2e094402-20a3-1f43-a7f5-41dac3a6a2b9"], Cell["\<\
the step specification that is applied to the list next, at each step\
\>", "TableText",ExpressionUUID->"8929fd6b-564c-de46-8166-e4a58fc68091"]}
  }]], "2ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->517531026,ExpressionUUID->"3f785232-3b6a-ff45-95de-359b13140508"],

Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<States\>\"", ",", " ", "\"\<Rules\>\""}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88471e60-bba6-d447-b06b-db9a8447837f"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["list", "TI"], ",", " ", 
    StyleBox["step", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bba7073f-55ac-7d44-adc1-ef9f07f82d46"],
 " at each step."
}], "Notes",
 CellID->251411682,ExpressionUUID->"9c863321-9a96-534b-90d6-c321d1b014fe"],

Cell["The following option can be given:", "Notes",
 CellID->457481787,ExpressionUUID->"284c90bb-c374-7943-b90a-2c39a2e35dbf"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "8843e1db-827f-cd49-a443-dc3eab11e249"], "\"\<LengthPreserving\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the rules are meant to keep the length of the list the same (not \
currently used)\
\>", "TableText",ExpressionUUID->"2ecb9ba5-0bfe-9446-99d3-75d971d9ede8"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {{None}}},
 GridBoxDividers->{"Rows" -> {{True, True}}}},
 CellID->939663294,ExpressionUUID->"2b793a91-1035-b948-873c-77c486c783c8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachineToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8b509e8e-b619-b741-bced-5d7bfb109ab8"],
 " compiles an oblivious ring machine that keeps the length of the list the \
same to a cyclic tag system."
}], "Notes",
 CellID->162789467,ExpressionUUID->"e1ba878b-7111-b94e-9248-c276d2255ebe"]
}, Closed]],

