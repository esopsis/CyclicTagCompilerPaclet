Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"returnTime", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evolution", " ", "=", " ", 
       RowBox[{"ObliviousRingMachine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
               RowBox[{"{", 
                RowBox[{"y", ",", " ", "x"}], "}"}]}], "}"}], ",", " ", "2"}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
             RowBox[{"{", "x", "}"}]}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"Range", "[", "n", "]"}], ",", " ", "1000"}], "]"}]}], "}"}],
      ",", " ", 
     RowBox[{"First", "[", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{
        RowBox[{"Rest", "[", "evolution", "]"}], ",", " ", 
        RowBox[{"Range", "[", "n", "]"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellProlog:>Needs["EricJamesParfitt`CyclicTagCompiler`"],
