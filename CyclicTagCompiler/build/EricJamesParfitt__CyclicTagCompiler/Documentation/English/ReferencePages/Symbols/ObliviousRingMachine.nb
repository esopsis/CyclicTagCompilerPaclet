      StyleBox["k", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "c9181aa1-52c1-40db-9b70-c2524b32cc25"],
     " positions to the left"
    }], "TableText",ExpressionUUID->"831f9cbd-9501-45a9-97b5-a28e15872f50"]}
  }]], "2ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "Rows" -> {None, None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True, True}}}},
 CellID->776731504,ExpressionUUID->"b75603f3-fbf0-4597-84eb-6dfdd1c0f4d8"],

Cell[TextData[{
 "A list of rules given as the first argument is a single step, which uses \
the first rule that matches. To use the rules one at a time in turn, give \
each one its own list, as in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["lhs1", "TI"]}], " ", ":>", " ", 
   RowBox[{
    RowBox[{
     StyleBox["rhs1", "TI"], 
     RowBox[{"}", ",", " ", "{"}], 
     StyleBox["lhs2", "TI"]}], " ", ":>", " ", 
    RowBox[{
     StyleBox["rhs2", "TI"], 
     RowBox[{
      RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "42a3c36c-3806-4efc-83e3-908ab158ffb6"],
 "."
}], "Notes",
 CellID->503724010,ExpressionUUID->"f9a9d70d-32c5-4119-88f9-f689d84f3973"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["lhsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76486b1f-d53d-419d-b7c8-b0e9a9485d3a"],
 " must be an explicit list. Each ",
 Cell[BoxData[
  StyleBox["rhsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bbf303c7-c312-4cab-9b3f-8e2f478fb68d"],
 " can be any expression that gives a list when it is evaluated. Rules can be \
given with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f43fcdb5-4b46-435f-9996-55ee374374cc"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RuleDelayed"]], "paclet:ref/RuleDelayed"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29dd880a-e32e-4c71-9df3-9c6eb1ed1e94"],
 "."
}], "Notes",
 CellID->490046043,ExpressionUUID->"de224ee8-e91c-4b19-aae3-64279270716e"],

Cell["\<\
If none of the rules match, the elements are not changed, but the list is \
still rotated.\
\>", "Notes",
 CellID->681008507,ExpressionUUID->"07eeecad-41a0-49a2-a33d-43b61ef07903"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33d81484-e52b-4ed7-86dc-f716612f0b6b"],
 " rotates the list to the right. With ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e0f28c41-154b-428b-ab81-68d39c3be7df"],
 " = 0, the list is not rotated."
}], "Notes",
 CellID->283168815,ExpressionUUID->"1dbc17ee-c5c9-45a0-b340-025354601919"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    RowBox[{"{", "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c9c8641b-e6a8-4f4b-86db-0c71614302e8"],
 ", ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72d7d3dd-1de5-4fbd-a06e-86e9bcc5bb15"],
 " must return a list. The ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6ae63efb-fc3d-4775-a86e-3bec13eb37a7"],
 " can also be given as an integer, which does not change the result."
}], "Notes",
 CellID->288242459,ExpressionUUID->"a48ea597-c9b8-42ba-96f1-09a4fe5691ee"],

Cell["The rules can change the length of the list.", "Notes",
 CellID->316063417,ExpressionUUID->"4f7643d5-d84d-48ae-8b5f-2fd90df5cb49"],

Cell[TextData[{
 "The elements of ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "306f2a97-c14c-4da0-b819-97d81c1b6b9a"],
 " can be any expressions."
}], "Notes",
 CellID->797711827,ExpressionUUID->"e8e33510-4630-4efc-8a8a-ec2cef767374"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ObliviousRingMachine"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine", 
     "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["steps", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "01ee04ae-b968-43c4-a861-e8ff63167c96"],
 " gives a list of length ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "30792250-7223-4852-b341-13e080172b67"],
 "+1 whose first element is ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f5351a04-45c7-4a82-8f22-5a81c7a0c996"],
 "."
}], "Notes",
 CellID->787255654,ExpressionUUID->"47e93e6b-6a97-477d-9e01-76a77081df48"],

Cell["The following properties can be given:", "Notes",
 CellID->269157274,ExpressionUUID->"13edf91c-de9b-4044-a731-a2a9005625ed"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "5173416e-8dfb-4761-9c91-df254b7d616f"], Cell[
    BoxData["\"\<States\>\""], "TableText",ExpressionUUID->
     "7d314c36-7a8f-4ea4-88c9-ad6579afdaf9"], Cell[
    "the list at each step (the default)", "TableText",ExpressionUUID->
     "fd2ed10d-defe-48e5-ad7b-c670886bf7f8"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "04a3706a-72f7-4656-885c-3b65a1f30f04"], Cell[
    BoxData["\"\<Rules\>\""], "TableText",ExpressionUUID->
     "21518c85-eb4c-4a84-a29e-49c11bd17176"], Cell["\<\
the step specification that is applied to the list next, at each step\
\>", "TableText",ExpressionUUID->"1da0f98a-b6ad-41f3-bd72-c14491358023"]}
  }]], "2ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->517531026,ExpressionUUID->"bcfa628d-b0e0-470b-bedb-990b5de79e35"],

Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<States\>\"", ",", " ", "\"\<Rules\>\""}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5f47a174-bf30-42b0-bf4f-e07e45bdbcfe"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["list", "TI"], ",", " ", 
    StyleBox["step", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "75407444-9888-4cdd-af44-b3dd3c80f499"],
 " at each step."
}], "Notes",
 CellID->251411682,ExpressionUUID->"7c8d95d8-b08e-4477-8802-cf964d64578b"],

Cell["The following option can be given:", "Notes",
 CellID->457481787,ExpressionUUID->"ecc25688-d3fb-4e27-998f-ebd74919d092"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "665dbb71-1c4e-44f9-a6e0-aaee2ad0e286"], "\"\<LengthPreserving\>\"", 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether the rules are meant to keep the length of the list the same (not \
currently used)\
\>", "TableText",ExpressionUUID->"da40b772-acfc-4e88-91af-058a26eb8e87"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {{None}}},
 GridBoxDividers->{"Rows" -> {{True, True}}}},
 CellID->939663294,ExpressionUUID->"6e129996-07a1-4350-a2c6-ff872705505f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachineToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8a4e155c-aa7e-43cd-b7fb-a04d4478bdb2"],
 " compiles an oblivious ring machine that keeps the length of the list the \
same to a cyclic tag system."
}], "Notes",
 CellID->162789467,ExpressionUUID->"611ed815-ff62-429c-8e98-6a60c3204b3d"]
}, Closed]],

