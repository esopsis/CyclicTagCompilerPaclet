Cell[TextData[{
 "A list of rules given as the first argument is a single step, which uses \
the first rule that matches. To use the rules one at a time in turn, give \
each one its own list, as in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["lhs1", "TI"]}], " ", ":>", " ", 
   RowBox[{
    RowBox[{
     StyleBox["rhs1", "TI"], 
     RowBox[{"}", ",", " ", "{"}], 
     StyleBox["lhs2", "TI"]}], " ", ":>", " ", 
    RowBox[{
     StyleBox["rhs2", "TI"], 
     RowBox[{
      RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b63a9869-a99a-d645-af64-6c69220c31e5"],
 "."
}], "Notes",
 CellID->428604010,ExpressionUUID->"a826ddf7-0592-6441-a4fb-28a264d9031e"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["lhsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d5478fc9-cd78-884c-8520-ae2f3ca8b8a1"],
 " must be an explicit list. Each ",
 Cell[BoxData[
  StyleBox["rhsi", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab7c23b3-cecb-b842-84a6-46d1b2f57ecb"],
 " can be any expression that gives a list when it is evaluated. Rules can be \
given with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
