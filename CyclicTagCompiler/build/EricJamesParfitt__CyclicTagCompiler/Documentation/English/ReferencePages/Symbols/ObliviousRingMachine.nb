Cell[TextData[{
 "Find how many steps it takes a list of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "990f297f-92a5-9144-be45-c619878b0401"],
 " distinct elements to first return to its initial order:"
}], "ExampleText",
 CellID->274570650,ExpressionUUID->"4d04fcbc-c60d-ab4e-8323-51a61a4bb98f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"returnTime", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evolution", " ", "=", " ", 
       RowBox[{"ObliviousRingMachine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
               RowBox[{"{", 
                RowBox[{"y", ",", " ", "x"}], "}"}]}], "}"}], ",", " ", "2"}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "x_", "}"}], " ", ":>", " ", 
             RowBox[{"{", "x", "}"}]}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"Range", "[", "n", "]"}], ",", " ", "1000"}], "]"}]}], "}"}],
      ",", " ", 
     RowBox[{"First", "[", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{
        RowBox[{"Rest", "[", "evolution", "]"}], ",", " ", 
        RowBox[{"Range", "[", "n", "]"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellProlog:>Needs["EricJamesParfitt`CyclicTagCompiler`"],
 CellLabel->"In[1]:=",
 CellID->340422749,ExpressionUUID->"c1f8fb8a-f6d6-9647-bfef-58e536add0ec"],

