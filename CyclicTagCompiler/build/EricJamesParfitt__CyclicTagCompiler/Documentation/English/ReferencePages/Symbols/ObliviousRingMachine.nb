  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33405fb4-fc86-3342-ae30-5ad0d51e4340"],
 " can be any expressions."
}], "Notes",
 CellID->175576939,ExpressionUUID->"3f325853-9f52-1141-90cb-eb63ce8a48b5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ObliviousRingMachine"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine", 
     "EricJamesParfitt Package Symbol"},
