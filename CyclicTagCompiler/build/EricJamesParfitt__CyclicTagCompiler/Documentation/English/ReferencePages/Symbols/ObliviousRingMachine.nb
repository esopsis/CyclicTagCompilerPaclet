  FontFamily->"Source Sans Pro",ExpressionUUID->
  "626bffc8-9868-d04e-b0fa-14c661174c12"],
 " are used in order, starting again from ",
 Cell[BoxData[
  StyleBox["step1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16526cc0-4e9c-8c4e-8c1e-68651737c343"],
 " after the last one."
}], "Notes",
 CellID->927771835,ExpressionUUID->"1f7d907b-ee0d-a441-9c9b-a3a540140c52"],

