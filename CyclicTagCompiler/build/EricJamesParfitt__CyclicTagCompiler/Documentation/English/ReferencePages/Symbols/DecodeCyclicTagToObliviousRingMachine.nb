Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "46d291c4-7408-4dd0-882d-d01709dd8e2f"],
 " is a list of cyclic tag tapes, one for each step, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fc8d8d78-98fe-4270-8b69-18be1ca3839c"],
 "."
}], "Notes",
 CellID->146966268,ExpressionUUID->"d2083ffe-658e-44f1-afc3-ddaed0071a9f"],

Cell[TextData[{
 "Decoding first gives the evolution of the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bd5bb434-032c-407f-8ee1-3c516d84cd25"],
 "-ary cyclic tag system, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToNaryCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0bf89d89-65cb-466d-aa57-812ac63a2292"],
 " does, and then keeps the tapes at which a ring machine step ends, as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeNaryCyclicTagToObliviousRingMachine"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeNaryCyclicTagToObliviousRingMachine", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "315d64db-f073-4338-94ce-5030b3cb9830"],
 " does."
}], "Notes",
 CellID->301205998,ExpressionUUID->"04248d38-8210-40a8-a3f1-25ece631ff78"],

Cell[TextData[{
 "Give the same ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "43e6db00-5e2d-4016-a568-65096ec8015d"],
 " and ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ac2b3ee4-9212-4670-8577-1fcd71888242"],
 " as to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachineToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
ObliviousRingMachineToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e053a951-16fa-4e7a-965e-18a18f06e336"],
 "."
}], "Notes",
 CellID->875292146,ExpressionUUID->"135c7d32-9339-4934-a6d6-968e27063a6c"],

Cell["The following options can be given:", "Notes",
 CellID->744851105,ExpressionUUID->"87bf4978-774b-4f63-8ecb-21030ac327d3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "d92f1878-a6fa-46f6-98d5-552a78b83193"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "2e2a7c2f-1541-4709-932a-564ebcaacec4"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "fa362354-d6bc-40f7-9c23-9c2d1a062197"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "0988975f-c792-4254-963b-ac571331e5b7"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->986200209,ExpressionUUID->"6052cb96-8cbc-46dc-9cc3-ca568104241a"],

Cell[TextData[{
 "The rule, initial condition, step count and decoding of one compilation \
must all use the same number of symbols and the same ",
 Cell[BoxData["\"\<TargetSystem\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "91e89930-b91a-4d29-beb9-10bd2278c7fd"],
 " setting."
}], "Notes",
 CellID->467709451,ExpressionUUID->"5a2f9567-f504-42b4-a8f7-2b907c018195"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db083a5e-a1cd-4517-8bfc-fdb7d30761b3"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a053b388-26e6-4036-9c01-9b31c8bcd76f"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100112,ExpressionUUID->"9c380de3-658b-466b-81ac-4c2a76c04cfb"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "58339a50-3f2a-4ef1-826b-9d8cf7388b0d"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100119,ExpressionUUID->"5accac47-98e8-48ae-a4a0-1fffbc951890"],

Cell[TextData[{
 "No other setting is implemented yet. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToObliviousRingMachine"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToObliviousRingMachine", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5d94bd2e-862b-4d95-a9e5-572129870672"],
 " stays unevaluated when it is given any other value, rather than quietly \
compiling something else."
}], "Notes",
 CellID->707100126,ExpressionUUID->"6cc5e62c-f92e-4c63-9d06-e1952b88838d"]
}, Closed]],

