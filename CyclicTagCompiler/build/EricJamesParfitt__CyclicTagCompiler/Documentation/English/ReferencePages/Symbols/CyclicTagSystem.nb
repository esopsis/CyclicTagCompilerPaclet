Cell[TextData[{
 "In a step of evolution in a cyclic tag system, the first element of the \
tape is deleted. If the first element was 0, no elements are added to the end \
of the tape. If the first element was 1, then the first block in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e3f4c825-3a1f-4cfe-be1f-0c8c5b580987"],
 " is added to the end of the tape. At every evolution step, the blocks in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b58a917-c96a-479c-8780-7b2d42d3765e"],
 " are rotated left one step so that the first block goes to the end of ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41dc81d0-b775-473a-8e35-3ac668ce9510"],
 "."
}], "Notes",
 CellID->118407882,ExpressionUUID->"ec029e0e-49d1-4d36-aea6-51ff9731d1b2"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "825108fe-dcc1-43e7-96cc-6e0997e38602"],
 " should be given as a list, where each element is a list specifying a block \
of digits to be added to the end of the tape, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", "0", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "27e1e2d5-0a8e-4b27-ae68-dff0bdcb2de5"],
 "."
}], "Notes",
 CellID->840317386,ExpressionUUID->"dfeea2fc-03f6-42ea-b3bf-15c0363052f3"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "53e38572-6775-433b-96e0-d490c0b247af"],
 " should be given as a list that specifies the initial tape configuration, \
such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0eee2224-0b54-47b2-a61f-1fd5ac8cb21e"],
 "."
}], "Notes",
 CellID->587791968,ExpressionUUID->"74c738d8-3bff-4d38-86ab-6f07a52c3e1c"],

Cell[TextData[{
 "The result has ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "67cf2f7f-5765-46c4-a82a-b7eef266d0ee"],
 " + 1 elements, the first of which is for ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8224e1ae-44e9-4a06-859b-367b3c0c2110"],
 ". Once the tape is empty, it stays empty."
}], "Notes",
 CellID->461655069,ExpressionUUID->"9cf58768-4d6e-4118-bda1-b75e70206be0"],

Cell["The following properties can be given:", "Notes",
 CellID->56621341,ExpressionUUID->"2b0452c9-594e-433f-b2a0-6c908d262b16"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "5a5da9ab-406f-45ed-b405-1829333ccb86"], Cell[
    BoxData["\"\<States\>\""], "TableText",ExpressionUUID->
     "93e33fec-80f6-48d7-baa7-a192ac44c4d2"], Cell[
    "the tape at each step (the default)", "TableText",ExpressionUUID->
     "ef5563fb-f3dc-4fa4-8b01-831e92c1630e"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "b8be7e26-d613-4983-8b84-bb1cd2061544"], Cell[
    BoxData["\"\<Rules\>\""], "TableText",ExpressionUUID->
     "87d9727e-27db-4a59-8e22-cdce00340705"], Cell[TextData[{
     "the block at the front of ",
     Cell[BoxData[
      StyleBox["rules", "TI"]], "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "db444568-7262-4788-98fa-3d4a15ac7985"],
     " at each step, which is added to the end of the tape if the first \
element of the tape is 1"
    }], "TableText",ExpressionUUID->"9c084f10-c542-49c1-af34-69cfdfdee9cf"]}
