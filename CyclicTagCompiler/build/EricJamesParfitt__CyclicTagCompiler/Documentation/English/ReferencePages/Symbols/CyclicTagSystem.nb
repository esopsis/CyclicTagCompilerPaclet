 CellID->512455948,ExpressionUUID->"e79ef61c-79f3-457f-8028-821c845783ed"],

Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<States\>\"", ",", " ", "\"\<Rules\>\""}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "55d93c86-bcba-4a1b-9ad9-50b244f23019"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["tape", "TI"], ",", " ", 
    StyleBox["block", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b4dad5dd-be27-43eb-a02a-1f65d8d65833"],
 " at each step."
}], "Notes",
 CellID->97640389,ExpressionUUID->"5f9e9324-ffd2-4175-91bb-016cebc5e0ab"],

