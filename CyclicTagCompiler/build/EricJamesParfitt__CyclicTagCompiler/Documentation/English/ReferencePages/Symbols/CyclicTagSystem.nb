Cell[TextData[{
 "In a step of evolution in a cyclic tag system, the first element of the \
tape is deleted. If the first element was 0, no elements are added to the end \
of the tape. If the first element was 1, then the first block in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0579cc5d-7ee3-c945-924e-a13f3f890753"],
 " is added to the end of the tape. At every evolution step, the blocks in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "542c90c2-680e-f442-929d-ef079076578b"],
 " are rotated left one step so that the first block goes to the end of ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "43ea7ab8-47a5-2049-a247-7b78d359b437"],
 "."
}], "Notes",
 CellID->88300010,ExpressionUUID->"fbb8399d-b1d5-6543-8b45-e95b6b7e64dc"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0d3b48f0-6a38-7948-b551-0837a2c26916"],
 " should be given as a list, where each element is a list specifying a block \
of digits to be added to the end of the tape, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", "0", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "19c61434-28d0-7b40-8780-7a2f035b1394"],
 "."
}], "Notes",
 CellID->328108744,ExpressionUUID->"ae33229f-054a-ef4b-a24b-dc83dd789753"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3262ef92-b9d5-9a44-9e8d-9d869a859b67"],
 " should be given as a list that specifies the initial tape configuration, \
such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a3c9bb78-feec-8e4c-8440-ba0e0e2731a2"],
 "."
}], "Notes",
 CellID->350927690,ExpressionUUID->"897c1ed0-184d-2d4a-b998-d6b159c29136"],

