Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<States\>\"", ",", " ", "\"\<Rules\>\""}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5e7fa422-bc22-6f48-93ab-4b7fe1be5252"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["tape", "TI"], ",", " ", 
    StyleBox["block", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4344c435-a58c-214a-bd59-1694d0d973e0"],
 " at each step."
}], "Notes",
 CellID->97640389,ExpressionUUID->"6c8fcff6-19cf-2c4d-8270-fdd6abb7e264"],

