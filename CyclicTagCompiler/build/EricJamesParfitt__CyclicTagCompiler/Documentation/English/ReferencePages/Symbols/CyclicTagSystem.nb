Cell[TextData[{
 "In a step of evolution in a cyclic tag system, the first element of the \
tape is deleted. If the first element was 0, no elements are added to the end \
of the tape. If the first element was 1, then the first block in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "04126d29-8d26-4647-8125-e5f839dad52e"],
 " is added to the end of the tape. At every evolution step, the blocks in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "de8e9d03-9abb-4248-9df5-4183d84267fe"],
 " are rotated left one step so that the first block goes to the end of ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a32c5d12-8ec1-9041-9baa-a738ce906955"],
 "."
}], "Notes",
 CellID->118407882,ExpressionUUID->"b7b1fa69-db78-5347-b5ae-8111a6e55ebb"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4c47a02e-e8cf-9f40-84ed-59517af74815"],
 " should be given as a list, where each element is a list specifying a block \
of digits to be added to the end of the tape, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", "0", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76aabca8-4d60-2248-850b-e13d90b7660e"],
 "."
}], "Notes",
 CellID->840317386,ExpressionUUID->"344ef98f-15ec-574c-bcd2-31a876d2c639"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "183bf748-8906-5b40-a716-888ff38a5ee6"],
 " should be given as a list that specifies the initial tape configuration, \
such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dfbc4564-a9c6-da48-94bd-91e8ec42a8a1"],
 "."
}], "Notes",
 CellID->587791968,ExpressionUUID->"f6b89eb2-1539-3e40-98c1-8286a3e94fb2"],

Cell[TextData[{
 "The result has ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "802928e8-f658-d14c-ac5a-0bdde2970b04"],
 " + 1 elements, the first of which is for ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b54f944-1fcb-e241-94cf-77287c6b490b"],
 ". Once the tape is empty, it stays empty."
}], "Notes",
 CellID->461655069,ExpressionUUID->"0a7fafe5-06e2-5e41-87a8-b60c5386422f"],

Cell["The following properties can be given:", "Notes",
 CellID->56621341,ExpressionUUID->"4700a23f-7b5a-234a-8483-158c2ee6bfa5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "ed031f40-2660-2441-a050-36ad636b7656"], Cell[
    BoxData["\"\<States\>\""], "TableText",ExpressionUUID->
     "e4562420-74a5-754d-87f5-d74d9a23f7c1"], Cell[
    "the tape at each step (the default)", "TableText",ExpressionUUID->
     "90738434-3abc-384e-9842-cd96ea5ff60a"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
