  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aafecb52-326c-7d4e-a766-5300955243e8"],
 "."
}], "Notes",
 CellID->878978311,ExpressionUUID->"8e638754-be2a-9b4c-a35b-290ae48ce949"]
}, Closed]],

