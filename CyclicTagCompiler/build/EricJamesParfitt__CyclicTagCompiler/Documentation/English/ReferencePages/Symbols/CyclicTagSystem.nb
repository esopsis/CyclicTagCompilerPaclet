Cell[TextData[{
 "With the default setting ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeRules\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["False"]], "paclet:ref/False"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ac044a69-527f-bb41-aeb5-30f21a46f1a7"],
 ", each state is given as a tape. With ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeRules\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6af4af9-3917-204f-9de4-459a0284d054"],
 ", each state is given as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["tape", "TI"], ",", " ", 
    StyleBox["block", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f3e68470-0866-a148-9289-f663455703f4"],
 ", where ",
 Cell[BoxData[
  StyleBox["block", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1ee7761-70f4-0c4b-a1d0-513db91891ea"],
 " is the block at the front of ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "460ad5dc-f5e5-4544-8269-852cd845c4f0"],
 " at that step, which is the block added to the end of the tape if the first \
element of ",
 Cell[BoxData[
  StyleBox["tape", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "485ec8b0-0182-ff45-b57d-1dc900c0827a"],
 " is 1."
}], "Notes",
 CellID->458835917,ExpressionUUID->"3aced043-6e3a-1246-ae59-265a2cadec0d"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<IncludeRules\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2968170-e0ef-074b-b6b1-cac5791a974c"],
 " option has no effect on the ",
 Cell[BoxData["\"\<Lengths\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7812cf3f-40a6-854a-be66-86841ad1b04e"],
 " property."
}], "Notes",
 CellID->363483202,ExpressionUUID->"de499877-0155-734f-9128-7db7e2869c10"],

