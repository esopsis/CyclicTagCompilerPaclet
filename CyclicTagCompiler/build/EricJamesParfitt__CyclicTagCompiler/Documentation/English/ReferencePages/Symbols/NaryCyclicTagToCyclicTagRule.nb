Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "547789b8-57f8-b243-aa34-eba663905122"],
 "-ary cyclic tag system has a tape of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9269821b-e605-744c-b8f3-0650ee81e18a"],
 "-1 and a list of rule parts that it uses in turn. At each step it deletes \
the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2296eb24-3cf9-3d41-bf2f-8a693159ff1a"],
 " of the tape and appends the appendant for ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8acf6d0b-d1be-4649-889a-2842608389a5"],
 " from the current rule part."
}], "Notes",
 CellID->596608220,ExpressionUUID->"4ceede50-648e-c044-b57e-750e7bbfb212"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1ae5c1a-e948-0b41-8721-9eccc4ef3fb0"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["part1", "TI"], ",", " ", 
    RowBox[{
     StyleBox["part2", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5bc0a581-2fe6-d74f-a737-12373ff03451"],
 " of rule parts. Each part is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["a0", "TI"], ",", " ", 
    RowBox[{
     StyleBox["a1", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7f47a21-5aaf-154d-8ede-74cea69c1a91"],
 " of appendants: ",
 Cell[BoxData[
  StyleBox["a0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c18039ce-50ec-8e4e-ae93-f7aef326f45b"],
 " is appended when the deleted symbol is 0, ",
 Cell[BoxData[
  StyleBox["a1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "73cc2504-0300-cc4d-935b-8380cc9b1c81"],
 " when it is 1, and so on. Each appendant is a list of symbols."
}], "Notes",
 CellID->909996744,ExpressionUUID->"1b98ceb3-abd1-3e4a-9a3f-aa6611aab312"],

Cell["\<\
A rule part with fewer appendants than symbols appends nothing for the \
missing symbols.\
\>", "Notes",
 CellID->721716713,ExpressionUUID->"2d53ad41-50cd-304d-9454-0491a451f821"],

Cell[TextData[{
 "The number of symbols ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b8e324a-6246-a644-ac73-73f8fbf25547"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6997f56-858a-2a49-ba35-98b47be073c9"],
 ", one more than the largest symbol in ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0ca85966-5ddd-ba4b-a68e-b9684800c44e"],
 ", and the length of the longest rule part. The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8acc15f6-47d4-7348-8ddc-b11e677c9cb4"],
 " is 2."
}], "Notes",
 CellID->817974380,ExpressionUUID->"1eb76ab2-8388-b045-96be-78ded0c29498"],

Cell[TextData[{
 "Each symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "43f663a9-e96d-eb41-9a82-2862f56d31e3"],
 " is encoded as a block of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "892fff56-6e2b-0344-9957-2a1b661e4865"],
 " cyclic tag cells that are all 0 except for a 1 at position ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f21df0d7-1727-b749-ac9f-6c40d4388c41"],
 "+1. Each rule part becomes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "626f39cc-6e10-644b-b67f-b9373982ec32"],
 " consecutive cyclic tag appendants, one for each symbol, so one step of the \
",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "421f1bad-1466-0642-bd4a-42b42324c89a"],
 "-ary system takes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "823fcd49-995c-9149-9c8d-dcda8862eb54"],
 " cyclic tag steps."
}], "Notes",
 CellID->398508024,ExpressionUUID->"ae7774e1-beb9-874f-b650-f2dbdc9e2885"],

