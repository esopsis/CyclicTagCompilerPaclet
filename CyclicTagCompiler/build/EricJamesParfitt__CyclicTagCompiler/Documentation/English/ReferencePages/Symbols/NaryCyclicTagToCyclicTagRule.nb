 " steps, and decode its evolution with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToNaryCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51ece55e-41df-574f-9f97-c51da22cbf65"],
 "."
}], "Notes",
 CellID->49467831,ExpressionUUID->"ba5275f4-2491-124c-8150-eaea62b8e04c"],

