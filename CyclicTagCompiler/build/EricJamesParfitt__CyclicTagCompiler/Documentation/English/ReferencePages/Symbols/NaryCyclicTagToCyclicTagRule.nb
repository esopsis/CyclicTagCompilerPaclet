Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b0bd0a4d-ba9e-4743-977d-3b7e9f63266f"],
 "-ary cyclic tag system has a tape of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "694aeecc-5d30-48b0-be32-e2f946e031c3"],
 "-1 and a list of rule parts that it uses in turn. At each step it deletes \
the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4abf8b2f-026e-4acc-ba34-0626629a78c7"],
 " of the tape and appends the appendant for ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "811e6337-f93b-473d-8309-9e7934527dae"],
 " from the current rule part."
}], "Notes",
 CellID->596608220,ExpressionUUID->"68915315-6a9e-4894-8834-a3645aad1671"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0a3233eb-8208-43bc-b5dc-13ff90190da1"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["part1", "TI"], ",", " ", 
    RowBox[{
     StyleBox["part2", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8f6119eb-723d-49ce-8fee-b679e532255c"],
 " of rule parts. Each part is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["a0", "TI"], ",", " ", 
    RowBox[{
     StyleBox["a1", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "482d129b-a745-4395-bd97-c160b6bfcfb2"],
 " of appendants: ",
 Cell[BoxData[
  StyleBox["a0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ce27bdb8-4199-4b3b-9531-55959f151ad5"],
 " is appended when the deleted symbol is 0, ",
 Cell[BoxData[
  StyleBox["a1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc014bf6-706c-4c46-ae94-19d85206896d"],
 " when it is 1, and so on. Each appendant is a list of symbols."
}], "Notes",
 CellID->909996744,ExpressionUUID->"0f3f2484-2726-425e-998c-5ee6eb524c25"],

Cell["\<\
Every rule part must give an appendant for every symbol, so all the rule \
parts must be the same length. An appendant can be empty, which appends \
nothing for its symbol.\
\>", "Notes",
 CellID->721716713,ExpressionUUID->"6b1966dd-7c74-4100-acb5-08588db3e102"],

Cell[TextData[{
 "The number of symbols ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "de3a9d08-6f3f-4c9a-a644-999f0901e4ea"],
 " is the length of the rule parts, so every symbol that ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "738cecfb-965a-4502-9adc-bb3acee76340"],
 " appends must have an appendant of its own in every rule part."
}], "Notes",
 CellID->817974380,ExpressionUUID->"e08204bd-9cce-491e-a972-507315763e6d"],

Cell[TextData[{
 "Each symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ba2e823-cb5a-40ce-b29b-fe15d74c2fd8"],
 " is encoded as a block of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "40c2192b-15ba-46d1-927c-e2a5e53b1f29"],
 " cyclic tag cells that are all 0 except for a 1 at position ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "64561622-fd13-4bdf-aa30-92e172e8d594"],
 "+1. Each rule part becomes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3de4c8de-4809-42e6-bcd0-24434745a977"],
 " consecutive cyclic tag appendants, one for each symbol, so one step of the \
",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b491675e-934b-4d8c-bde3-9525ebae0bd6"],
 "-ary system takes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f6b305f-5b59-4508-b6d5-51c7ebe37f36"],
 " cyclic tag steps."
}], "Notes",
 CellID->398508024,ExpressionUUID->"e1a003db-5994-4b41-bf80-03dec6941340"],

Cell[TextData[{
 "Run the cyclic tag system with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e19a788b-807a-4a8e-8946-95b8ad362e5d"],
 ", starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["NaryCyclicTagToCyclicTagInit"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagInit", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
