Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c11dd1b9-8c6e-ad4b-b3a1-dbe06fdc3199"],
 "-ary cyclic tag system has a tape of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f12bec3b-0094-7d41-bdf6-5c5aad92acdf"],
 "-1 and a list of rule parts that it uses in turn. At each step it deletes \
the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e44e28c2-6171-a94a-96e6-20bf998efe4a"],
 " of the tape and appends the appendant for ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cacbb7a4-4a5b-cd48-b606-ba78e63d5fe6"],
 " from the current rule part."
}], "Notes",
 CellID->596608220,ExpressionUUID->"395f4a6c-746f-b142-81a8-73d8311e5f01"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "78db25a0-b868-6343-86c5-7800e9f25050"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["part1", "TI"], ",", " ", 
    RowBox[{
     StyleBox["part2", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fab65a07-e5d5-f64e-9691-c6729370ded4"],
 " of rule parts. Each part is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["a0", "TI"], ",", " ", 
    RowBox[{
     StyleBox["a1", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c1e64ba1-770c-8644-bf69-4e95a0d8c603"],
 " of appendants: ",
 Cell[BoxData[
  StyleBox["a0", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "70c324c5-c2b3-3448-9585-d2e02fbc7e0d"],
 " is appended when the deleted symbol is 0, ",
 Cell[BoxData[
  StyleBox["a1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4b7a3d47-1542-a34a-81b4-c8a10be99a1b"],
 " when it is 1, and so on. Each appendant is a list of symbols."
}], "Notes",
 CellID->909996744,ExpressionUUID->"436b7baf-0bef-0d42-8aed-7829fc15cbb1"],

Cell["\<\
A rule part with fewer appendants than symbols appends nothing for the \
missing symbols.\
\>", "Notes",
 CellID->721716713,ExpressionUUID->"0e03afe6-624d-dd40-b87c-b52f810838ca"],

Cell[TextData[{
 "The number of symbols ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c0f3656b-6a99-2544-b7af-ae837d4e365b"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b7ff73b-69b6-6d43-82ee-08aba26aaf7e"],
 ", one more than the largest symbol in ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "aaf62110-fc24-b947-b61c-19c1ebca7bdd"],
 ", and the length of the longest rule part. The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e100b8f-2402-7c4e-8d4e-a7beea0c7816"],
 " is 2."
}], "Notes",
 CellID->817974380,ExpressionUUID->"27f9f808-cfaa-b745-937e-e0845fccce5f"],

Cell[TextData[{
 "Each symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1d5db096-9913-5a4e-9c8f-bba7fe4b09c2"],
 " is encoded as a block of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ea46d9e6-e885-414b-9032-c89efbfe4f53"],
 " cyclic tag cells that are all 0 except for a 1 at position ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d1169451-2d25-3d4d-a23e-40b6478fa0da"],
 "+1. Each rule part becomes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2a57bb3f-585f-5c45-ae4b-d6da207b45ff"],
 " consecutive cyclic tag appendants, one for each symbol, so one step of the \
",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "804f93c6-c5fb-e44a-b390-e257e63768f6"],
 "-ary system takes ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "49e5de2a-c245-9249-8c86-d35d4cc1abb7"],
 " cyclic tag steps."
}], "Notes",
 CellID->398508024,ExpressionUUID->"6e55a242-6819-fb47-8c17-e838f2306838"],

