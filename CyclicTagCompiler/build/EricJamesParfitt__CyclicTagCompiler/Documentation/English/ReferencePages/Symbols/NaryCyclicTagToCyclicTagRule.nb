    StyleBox["init", "TI"], ",", " ", 
    StyleBox["rule", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "87e20e2f-df59-4439-9f6e-556c1a0aec26"],
 " for ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["NaryCyclicTagToCyclicTagSteps"]], 
     "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagSteps", "EricJamesParfitt Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["t", "TI"], ",", " ", 
    StyleBox["rule", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4220b29d-9f85-44f7-b0dd-35d451ef8e64"],
 " steps, and decode its evolution with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DecodeCyclicTagToNaryCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
DecodeCyclicTagToNaryCyclicTag", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0881cb52-5a16-4d40-9290-f0c4ac7ae8f2"],
 "."
}], "Notes",
 CellID->49467831,ExpressionUUID->"86a9f69c-c4a2-4ce8-890e-c9660fbbee42"],

Cell["The following options can be given:", "Notes",
 CellID->490037067,ExpressionUUID->"da87b4eb-3556-47c8-8298-d541e12acba1"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "c7348e95-70eb-43d6-942d-7ae68e0c8442"], "\"\<TargetSystem\>\"", 
