   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0c3cc749-7a43-624c-9ec4-07d04175bf2f"],
 "."
}], "Notes",
 CellID->49467831,ExpressionUUID->"c0cc702e-3e06-f341-a93b-09b67a40ce20"],

