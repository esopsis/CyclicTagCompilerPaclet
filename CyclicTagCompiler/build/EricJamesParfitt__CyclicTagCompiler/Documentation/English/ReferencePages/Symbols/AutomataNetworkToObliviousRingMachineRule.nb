Cell[TextData[{
 "An automata network is a list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "{"}], 
    StyleBox["rules1", "TI"]}], ",", " ", 
   StyleBox["inputs1", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label1", "TI"], 
    RowBox[{"}", ",", " ", "{"}], 
    StyleBox["rules2", "TI"]}], ",", " ", 
   StyleBox["inputs2", "TI"], ",", " ", 
   RowBox[{
    StyleBox["label2", "TI"], 
    RowBox[{
     RowBox[{"}", ",", " ", "\[Ellipsis]"}], "}"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6512e1e7-f00d-604b-a7e3-bc311de236e7"],
 " of automata, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a0a5ee1-7c6a-9548-a28d-2a35ec1134c0"],
 ". At each step, every automaton updates its state at the same time, by \
applying its rules to the list of the states of the automata whose labels are \
in its inputs."
}], "Notes",
 CellID->703472248,ExpressionUUID->"d5c06f99-870d-7d4b-83d4-1cc5a7228f10"],

Cell[TextData[{
 "Rules can be explicit, such as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", "1"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cdec840a-cce8-9645-92d0-54970dd87301"],
 ", or patterns, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], "_"}], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["y", "TI"], 
      RowBox[{"_", "}"}]}], " ", ":>", " ", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["Mod"]], "paclet:ref/Mod"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      RowBox[{
       StyleBox["x", "TI"], " ", "+", " ", 
       RowBox[{
        StyleBox["y", "TI"], 
        RowBox[{
         RowBox[{",", " ", "2"}], "]"}]}]}]}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fcb6b0a7-8e18-9042-96e6-280c63344e90"],
 "."
}], "Notes",
 CellID->438958633,ExpressionUUID->"9e175cc7-b545-e44f-a2e3-8ee4dedc7173"],

Cell["\<\
Labels can be any expressions. An automaton can read its own state, read the \
same automaton more than once, or be read by no automaton.\
\>", "Notes",
 CellID->314399102,ExpressionUUID->"015f1f99-a229-a44c-9b72-7e8c9e789a32"],

Cell[TextData[{
 "The states of the automata are integers from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebe43596-d966-0c42-9698-6bfc046ff54a"],
 "-1, where ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6eeedd3-6c1a-b142-b23e-f7841db23f9f"],
 " is the largest of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "268a8c81-4641-e344-a649-8516270f2940"],
 " and one more than the largest state written explicitly in the rules. \
States computed by a pattern rule are not counted, so give ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6830956e-3160-ab47-9f34-f161851dadb3"],
 " for rules like ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], 
     RowBox[{"_", "}"}]}], " ", ":>", " ", 
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["Mod"]], "paclet:ref/Mod"},
      "RefLink",
      BaseStyle->{"InlineFormula"}], "[", 
     RowBox[{
      StyleBox["x", "TI"], " ", 
      RowBox[{
       RowBox[{"+", " ", "1"}], ",", " ", "3"}]}], "]"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d281cddf-e40f-3144-9975-e3ce4b184aa2"],
 ". The default value of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "baeb61c2-bc8d-ed4b-a476-af3b337f724a"],
 " is 2."
}], "Notes",
 CellID->620954575,ExpressionUUID->"63e7d824-7eca-b14e-85a9-88a34899e8cf"],

Cell[TextData[{
 "Every automaton must give a state from 0 to ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3a82cbd0-d8a8-d74e-aca3-ec9a1c5bc6ae"],
 "-1 for every combination of the states of its inputs. Combinations that no \
rule matches leave the automaton's cells unchanged."
}], "Notes",
 CellID->912302504,ExpressionUUID->"19b35ced-cb58-7d49-91fb-a6fcb53808df"],

Cell["\<\
On the oblivious ring machine tape, each automaton has a block of cells: one \
for each of its inputs, plus extra cells if more automata read its state than \
it has inputs. One step of the network is one pass through the ring machine \
rule, in three phases. First the extra cells of each block get copies of the \
automaton's state. Then the cells are bubble-sorted, so that each automaton's \
input cells hold the states of its inputs. Finally each automaton's rules are \
applied to its input cells, writing its new state into all of them.\
\>", "Notes",
 CellID->569335793,ExpressionUUID->"4d7400ac-e70c-044b-97ff-29d0ab1fa20c"],

Cell["\<\
The grow and sort phases use function steps that skip, swap or copy cells. \
When fewer automata need extra cells, the grow phase is shorter.\
\>", "Notes",
 CellID->67998794,ExpressionUUID->"c4f816aa-2fef-ad41-96ec-b6d83357f7e2"]
}, Closed]],

