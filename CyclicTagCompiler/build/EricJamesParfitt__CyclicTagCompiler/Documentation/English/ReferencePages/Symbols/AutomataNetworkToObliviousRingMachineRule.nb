Cell["\<\
An elementary cellular automaton on a cyclic tape is an automata network in \
which each cell reads its neighbors. Emulate rule 30 on 5 cells:\
\>", "ExampleText",
 CellID->900883049,ExpressionUUID->"33cb4807-6a15-44e1-a0c2-e63cc94cfa6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ring", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "3"}], "]"}], " ", 
         "->", " ", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"30", ",", " ", "2", ",", " ", "8"}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"i", " ", "-", " ", "2"}], ",", " ", "5"}], "]"}], " ", "+",
           " ", "1"}], ",", " ", "i", ",", " ", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"i", ",", " ", "5"}], "]"}], " ", "+", " ", "1"}]}], "}"}],
        ",", " ", "i"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["EricJamesParfitt`CyclicTagCompiler`"],
 CellLabel->"In[1]:=",
 CellID->234395337,ExpressionUUID->"6770f70d-45a1-4797-b11c-5780555734bb"],

