Cell["\<\
An elementary cellular automaton on a cyclic tape is an automata network in \
which each cell reads its neighbors. Emulate rule 30 on 5 cells:\
\>", "ExampleText",
 CellID->900883049,ExpressionUUID->"5620705c-2488-5c40-8525-39181df10746"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ring", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "3"}], "]"}], " ", 
         "->", " ", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"30", ",", " ", "2", ",", " ", "8"}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"i", " ", "-", " ", "2"}], ",", " ", "5"}], "]"}], " ", "+",
           " ", "1"}], ",", " ", "i", ",", " ", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"i", ",", " ", "5"}], "]"}], " ", "+", " ", "1"}]}], "}"}],
        ",", " ", "i"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellProlog:>Needs["EricJamesParfitt`CyclicTagCompiler`"],
 CellLabel->"In[1]:=",
 CellID->234395337,ExpressionUUID->"ffc11be4-0f92-2e4c-8b7b-0ee0e1f3e24f"],

