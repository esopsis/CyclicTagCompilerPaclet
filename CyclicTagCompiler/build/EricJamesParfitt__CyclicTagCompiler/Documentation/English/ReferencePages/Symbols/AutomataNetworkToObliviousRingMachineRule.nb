         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
