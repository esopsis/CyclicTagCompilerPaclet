Cell[TextData[{
 "The compiled ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ec544e1f-22bd-4437-8cdb-973b6d44a879"],
 "-ary cyclic tag system has one more symbol than the ring machine. Each \
symbol of ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50eca28d-8dcc-4c23-aaec-57a5720d32de"],
 " becomes a block with one cell for each symbol that survives the encoding, \
all 0 except for a single 1, as in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTagToCyclicTagInit"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagInit", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e763ed6c-77fb-4469-a228-aa174088746d"],
 "."
}], "Notes",
 CellID->302180388,ExpressionUUID->"937b953e-912d-44cf-b7cb-5c7b042edc00"],

Cell[TextData[{
 "Give the same ",
 Cell[BoxData[
  StyleBox["tapeStates", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "701079e0-07c8-4e61-a0a3-e55088ff19bc"],
 " as to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
