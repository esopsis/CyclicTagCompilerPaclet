Cell["\<\
Decode 4 steps of a network of 3 automata, run as a cyclic tag system:\
\>", "ExampleText",
 CellID->270347292,ExpressionUUID->"7fe549eb-3206-41c2-8ca3-7882dc0226d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", " ", "y_"}], "}"}], " ", ":>", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], "}"}],
