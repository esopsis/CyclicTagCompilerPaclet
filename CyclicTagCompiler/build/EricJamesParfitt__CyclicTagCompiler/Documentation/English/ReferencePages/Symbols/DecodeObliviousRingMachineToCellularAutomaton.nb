Cell[TextData[{
 Cell[BoxData[
  StyleBox["history", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe4b7302-f690-d648-bf38-f63036843edd"],
 " is a list of ring machine tapes, one for each step, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ObliviousRingMachine"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/ObliviousRingMachine", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "edb2ba6d-ac3e-d648-83c5-b8dafe4c9a6e"],
 ". A cellular automaton step ends after each sweep of the tape."
}], "Notes",
 CellID->82542479,ExpressionUUID->"5d64e846-5144-7c40-90c9-12d63509db70"],

Cell[TextData[{
 "By default, the tape has ",
 Cell[BoxData[
  StyleBox["tapeLength", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4446812d-924f-4f4d-a80a-a7635c799dc5"],
 " cells, and the ring machine updates the cells one after another, so cells \
near the end of the tape see neighbors that have already been updated. The \
decoded evolution then contains only the cells that never depended on an \
updated neighbor: 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9b0354e-70de-f542-90dd-cb02d3581928"],
 " fewer cells at each step, for as long as any cells are left."
}], "Notes",
 CellID->272689928,ExpressionUUID->"fab8b7d3-415a-644e-8e60-7d137a26396b"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94facfe7-ae01-2144-bd29-ac96d20b1eef"],
 ", decoding drops the 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1b1e4680-5c3e-a44a-8833-f306868a6772"],
 " extra cells and undoes the shift of each sweep, so the result is the \
cellular automaton evolution on a cyclic tape."
}], "Notes",
 CellID->645753504,ExpressionUUID->"6da5c78f-5930-c24b-9414-074c3d77666a"],

Cell["The following option can be given:", "Notes",
 CellID->262775758,ExpressionUUID->"c948a3aa-9a3f-ec40-8d80-162a4ab16d1c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "b1bcb21d-eeaf-b04b-b03b-67af738713b1"], "\"\<InfiniteSteps\>\"", 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
whether to emulate the cyclic cellular automaton for any number of steps\
\>", "TableText",ExpressionUUID->"a9948f36-cf69-0147-9bfc-f39bdee93b1d"]}
  }]], "3ColumnTableMod",
