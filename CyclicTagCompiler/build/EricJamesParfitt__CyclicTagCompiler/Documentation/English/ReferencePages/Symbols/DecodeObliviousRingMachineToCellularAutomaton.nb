Cell["\<\
Decode the evolution of a ring machine running rule 30 on 7 cells:\
\>", "ExampleText",
 CellID->426730523,ExpressionUUID->"39599166-092d-b04e-ad9d-9e52fe30959d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"history", " ", "=", " ", 
   RowBox[{"ObliviousRingMachine", "[", 
    RowBox[{
     RowBox[{"CellularAutomatonToObliviousRingMachineRule", "[", "30", "]"}], 
