Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "615e0bd4-ba62-466a-8157-39a59309aa5a"],
 " is a list of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7825dd46-58da-483f-adaf-a9a11a3e586e"],
 "-1."
}], "Notes",
 CellID->8475976,ExpressionUUID->"f9669960-442c-4d54-a85b-e10c4aa32bc0"],

Cell[TextData[{
 "Each symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "62a5e18d-50e2-4b42-a523-e28a5ce6b227"],
 " becomes a block of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fe1f4099-8d62-4b1b-8008-ed1611514bf6"],
 " cells that are all 0 except for a 1 at position ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d00a18bb-01d9-4f55-8bc4-917912867b6b"],
 "+1."
}], "Notes",
 CellID->282599932,ExpressionUUID->"5772ff6d-1992-407b-a4a4-cb9aba6ef1f9"],

Cell[TextData[{
 "Use the same number of symbols as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTagToCyclicTagRule"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagRule", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6db688a7-f2e7-4af8-afef-9bfaab840883"],
 " uses for the rule. If ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f8892f8-d314-42fd-86e5-e5f191fb8ddc"],
 " contains a symbol of ",
 Cell[BoxData[
  StyleBox["states", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4ba1553-438c-4b46-9ac7-e6f4bd536881"],
 " or more, more cells are used for every symbol."
}], "Notes",
 CellID->813700257,ExpressionUUID->"fe4665e9-696e-45d5-8d3a-5bfe0290cd6b"],

Cell["The following options can be given:", "Notes",
 CellID->885249170,ExpressionUUID->"7336974e-026a-4318-9bc4-b369ce93b7d0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "4ebe05d0-c26b-4f52-8b3d-ffbaecbd747f"], "\"\<TargetSystem\>\"", 
    TemplateBox[{
      Cell[
       TextData["Automatic"]], "paclet:ref/Automatic"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[
    "the kind of cyclic tag system to compile to", "TableText",ExpressionUUID->
     "40f19e19-9417-401f-96ef-e65772dfcf01"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "66721ad8-2bd7-47e3-ba84-f21e16f4b40d"], "\"\<Optimization\>\"", \
"\"\<DeletedSymbolsHighest\>\"", Cell[
    "which optimization of the encoding to use", "TableText",ExpressionUUID->
     "23bffa06-5a4d-4cb0-a682-0dcb681f3abb"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True}}}},
 CellID->608114205,ExpressionUUID->"0ee54c88-7bd8-4c35-8fe4-e528e6559f64"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7097fdb4-03e1-45fb-b9e9-68e5ceb3a135"],
 ", the number of cells used for each symbol is rounded up to a multiple of \
6, so the number of cyclic tag appendants is a multiple of 6, as in the \
cyclic tag systems that Matthew Cook's construction emulates with rule 110. \
The default ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["Automatic"]], "paclet:ref/Automatic"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "acc08ea8-797d-4303-9418-248de65875b0"],
 " uses as few cells as possible."
}], "Notes",
 CellID->425611352,ExpressionUUID->"69e4f10f-60a9-46bd-a293-c05d9c80629e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Optimization\>\"", " ", "->", 
   " ", "\"\<DeletedSymbolsHighest\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfa9ae9b-19aa-427e-8651-99d570832c1c"],
 ", the default, the symbol columns that every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "11fb9d45-853a-405b-89cd-ad409fa3f711"],
 "-ary rule part leaves empty are left out of the encoding. Nothing in the \
compiled cyclic tag system ever appends for those symbols, so leaving them \
out makes every block narrower and every step cheaper."
}], "Notes",
 CellID->707100028,ExpressionUUID->"71313c1a-12ac-4617-bc88-26295e210d6a"],

Cell[TextData[{
 "The compilation is then faithful up to a relabeling of the symbols: each \
symbol that survives is renamed to its position among the survivors, and \
every symbol that is left out decodes to one label that no surviving symbol \
uses. The decoded evolution therefore behaves like the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3b01851c-4b43-4676-a9a2-1907c97f22b3"],
 "-ary one with its symbols renumbered, and is identical to it when there is \
nothing to leave out."
}], "Notes",
 CellID->707100035,ExpressionUUID->"e867b23c-9607-4cb5-b010-93c8beec7853"],

Cell[TextData[{
 "No other setting is implemented yet. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTagToCyclicTagInit"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/\
NaryCyclicTagToCyclicTagInit", "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "74d5c842-ed72-4c39-be6d-06499e7c02cb"],
 " stays unevaluated when it is given any other value, rather than quietly \
compiling something else."
}], "Notes",
 CellID->707100042,ExpressionUUID->"8be2a11a-be14-41ec-ab3a-37a3fcf503aa"]
}, Closed]],

