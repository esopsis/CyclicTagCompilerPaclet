Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<States\>\"", ",", " ", "\"\<Rules\>\""}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f05efdfc-4c8d-0244-ae43-e4dc51bb1bd2"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["tape", "TI"], ",", " ", 
    StyleBox["rule", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2aaf27ae-3628-214c-989b-726c29efc45f"],
 " at each step."
}], "Notes",
