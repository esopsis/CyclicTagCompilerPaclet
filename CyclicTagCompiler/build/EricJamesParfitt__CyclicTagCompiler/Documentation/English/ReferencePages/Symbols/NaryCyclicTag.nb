Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d5976344-97eb-f943-bb40-054de3bef5b3"],
 "-ary cyclic tag system works on a tape, which is a list of the symbols 0, \
1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ef265dd5-c450-1f41-9684-28f44c805b4e"],
 "-1."
}], "Notes",
 CellID->71114830,ExpressionUUID->"3ac2b153-7b00-214b-922e-58d8478763b1"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2edad91-8593-684f-aa30-8aac67e7a908"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["w0", "TI"], ",", " ", 
    RowBox[{
     StyleBox["w1", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "592a34f0-fef9-4040-a7e6-3716475356c5"],
 " of appendants. Each appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "607be518-1431-964c-827e-8d6f5a4edbe6"],
 " is a list of symbols."
}], "Notes",
 CellID->746397807,ExpressionUUID->"737ff873-bfd6-c741-ac43-e1cc50d8eae6"],

Cell[TextData[{
 "At each step, the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e77d6b00-d730-e043-b800-88abd4f7393d"],
 " is removed from the tape, and the appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "10e354a3-5c97-904e-9931-61f36bf2902b"],
 " of the current rule is added to the end of the tape."
}], "Notes",
 CellID->928152345,ExpressionUUID->"dad65ca8-2b52-e043-a15a-8a3e7206005a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b7374ee5-9ecc-c042-8533-1552c3c17a75"],
 " are used in turn, one at each step, starting again from ",
 Cell[BoxData[
  StyleBox["rule1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "80466042-a0dd-4a40-aec4-edfed6493a17"],
 " after the last one."
}], "Notes",
 CellID->836444955,ExpressionUUID->"836b213d-8e02-744d-bc1b-4cba90ebe5d2"],

Cell[TextData[{
 "A rule with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4ed63d94-e4db-924f-83f8-c867645a5a41"],
 " appendants gives appendants for the symbols 0 through ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51e959b2-5027-1946-ad7e-97ce13a1b8e1"],
 "-1. Rules can have different lengths, as long as each rule has an appendant \
for every symbol that is at the start of the tape when the rule is used."
}], "Notes",
 CellID->183476603,ExpressionUUID->"f4e11215-1a35-b74d-bc65-3cbe037497c7"],

Cell["\<\
An appendant can be empty. The tape is then one symbol shorter after the step.\
\>", "Notes",
 CellID->888542513,ExpressionUUID->"c8d1bee8-8c27-a74f-9298-2464cd518c0f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ccc7d2d1-9abb-0443-b1e7-cc4a0cf76533"],
 " must be a list of nonnegative integers. It can be empty."
}], "Notes",
 CellID->987842714,ExpressionUUID->"4253f6c5-4f7d-af4e-9f6b-2213e0fbac50"],

Cell["The following option can be given:", "Notes",
