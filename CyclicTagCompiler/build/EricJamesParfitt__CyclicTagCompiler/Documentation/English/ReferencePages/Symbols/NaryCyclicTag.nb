Cell[TextData[{
 "With a single rule, each pass through the tape gives the next step of the \
corresponding neighborhood-independent ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SubstitutionSystem"]], "paclet:ref/SubstitutionSystem"},
