Cell[TextData[{
 "A binary system whose rules have the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "}"}], ",", " ", 
    StyleBox["ai", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "519c9d55-aa62-451d-9b47-f9a78818634a"],
 " gives the same result as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4f659009-a42e-4f4f-97b1-2ff987c31f74"],
 " with appendants ",
