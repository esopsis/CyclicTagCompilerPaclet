Cell[TextData[{
 "A binary system whose rules have the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "}"}], ",", " ", 
    StyleBox["ai", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7f7ceb8c-d788-e749-bc42-a71a4beaee14"],
 " gives the same result as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CyclicTagSystem"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/CyclicTagSystem", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "40a2a9e9-e839-cd40-a96d-77bbf6a6fbf7"],
 " with appendants ",
 Cell[BoxData[
  StyleBox["ai", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3a005482-845e-7148-8932-7f90e78c85ca"],
 ":"
}], "ExampleText",
 CellID->460355868,ExpressionUUID->"4fc9241c-aafc-1748-ba84-5ba34b425864"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CyclicTagSystem", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", "1", "}"}], ",", " ", "10"}], "]"}], " ", "===", " ", 
  RowBox[{"NaryCyclicTag", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", "1", "}"}], ",", " ", "10"}], "]"}]}]], "Input",
 CellProlog:>Needs["EricJamesParfitt`CyclicTagCompiler`"],
 CellLabel->"In[1]:=",
 CellID->147430855,ExpressionUUID->"beb180df-795a-b840-b486-bad236de76ba"],

