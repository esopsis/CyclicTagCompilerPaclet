Cell[TextData[{
 "With a list of properties, each element of the result is the list of those \
properties at that step. For example, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<States\>\"", ",", " ", "\"\<Rules\>\""}], "}"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "22ed6f10-662d-487e-9b41-9fb4eb10fbfb"],
 " gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["tape", "TI"], ",", " ", 
    StyleBox["rule", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b7f96662-e5d5-4602-a476-3895c956d8d0"],
 " at each step."
}], "Notes",
 CellID->674677682,ExpressionUUID->"c4a27708-7609-45f5-b625-f50dc1ea4366"],

