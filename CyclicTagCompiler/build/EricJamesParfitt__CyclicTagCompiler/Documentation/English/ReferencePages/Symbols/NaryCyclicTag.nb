Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e4b130e2-4e78-0d4d-840d-f236f1dda92a"],
 "-ary cyclic tag system works on a tape, which is a list of the symbols 0, \
1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "99bb1d3a-a27a-2a4f-a14d-817c2aead641"],
 "-1."
}], "Notes",
 CellID->39283519,ExpressionUUID->"b30572ad-2f37-8a42-9512-abc3e6245ca4"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9403f1b4-dca7-ea4f-903e-e1432ccc3f9e"],
 " is a list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["w0", "TI"], ",", " ", 
    RowBox[{
     StyleBox["w1", "TI"], 
     RowBox[{
      RowBox[{",", " ", "\[Ellipsis]"}], "}"}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b2edf5e8-f2eb-b546-adc8-7270ff118906"],
 " of appendants. Each appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "701de21d-f59d-cf44-98dd-d5621aa98607"],
 " is a list of symbols."
}], "Notes",
 CellID->279955860,ExpressionUUID->"d1914593-da0a-ed4f-aba0-539cab55f4b6"],

Cell[TextData[{
 "At each step, the first symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d68ba5df-aa42-2343-973b-0db8fa2c3a79"],
 " is removed from the tape, and the appendant ",
 Cell[BoxData[
  StyleBox["ws", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "751963d9-75ae-5441-9318-7157702f0ba8"],
 " of the current rule is added to the end of the tape."
}], "Notes",
 CellID->723538001,ExpressionUUID->"7e4cc01f-e0f6-2643-8a9b-e553ec6643f8"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rulei", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bc6c165a-f4de-1846-8b8a-11e27160c3ee"],
 " are used in turn, one at each step, starting again from ",
 Cell[BoxData[
  StyleBox["rule1", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1e51f590-2c0f-d944-93a4-2bb8d68920ba"],
 " after the last one."
}], "Notes",
 CellID->614269972,ExpressionUUID->"147d86d1-819d-994d-bdd9-f27d4031fbbc"],

Cell[TextData[{
 "A rule with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "10071dd3-9403-6b40-b689-15e52edec4bc"],
 " appendants gives appendants for the symbols 0 through ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5517f9c9-ed2c-3846-b6fe-6da1b5b85b4b"],
 "-1. Rules can have different lengths, as long as each rule has an appendant \
for every symbol that is at the start of the tape when the rule is used."
}], "Notes",
 CellID->583189011,ExpressionUUID->"2196b2e5-27e3-1140-b4d4-1557e6e91b22"],

Cell["\<\
An appendant can be empty. The tape is then one symbol shorter after the step.\
\>", "Notes",
 CellID->405725213,ExpressionUUID->"6cc5c11c-5b0c-184b-bdd2-f52fbd661472"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0b79e9b2-4d36-5043-b51c-4e7885e7dc8f"],
 " must be a list of nonnegative integers. It can be empty."
}], "Notes",
 CellID->552375982,ExpressionUUID->"d42eef9b-0359-be4f-84ee-4ea063a26d40"],

Cell["The following properties can be given:", "Notes",
 CellID->490511496,ExpressionUUID->"f8007fac-aad5-9641-aad9-c4c094c33e3f"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
