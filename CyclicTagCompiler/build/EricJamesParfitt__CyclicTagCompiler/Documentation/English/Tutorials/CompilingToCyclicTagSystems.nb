}, Open  ]],

Cell["\<\
On the oblivious ring machine tape, each automaton has a block of cells: one \
for each of its inputs, plus extra cells if more automata read its state than \
it has inputs. Each network step is one pass through the ring machine rule, \
in three phases:\
\>", "TechNoteText",
 CellID->555678078,ExpressionUUID->"975bfd17-908b-45cd-983c-8f8803278127"],

Cell["\<\
grow: fill the extra cells of each block with copies of the automaton's state\
\
\>", "Item",
 CellID->272319002,ExpressionUUID->"7656afa6-4c3e-4305-bbb3-0f4cf7bc8d42"],

Cell["\<\
sort: bubble-sort the cells by swapping or skipping neighbors, so that each \
automaton's input cells hold the states of its inputs\
\>", "Item",
 CellID->562356427,ExpressionUUID->"40b37779-3b5e-468c-9a24-5d5e4a441abe"],

Cell[CellGroupData[{

Cell["\<\
apply: apply each automaton's rules to its input cells, writing its new state \
into all of them\
\>", "Item",
 CellID->563234749,ExpressionUUID->"c2dad154-3dc3-45e8-81f2-f95eb8230aef"],

Cell["\<\
Automaton 2 is read by 2 automata but has 1 input, so it gets an extra cell:\
\>", "TechNoteMathCaption",
 CellID->200860385,ExpressionUUID->"0976f533-35ba-4c85-9728-95a2c23753f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkToObliviousRingMachineInit", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "net"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->337382418,ExpressionUUID->"3ae6ad1e-309b-42aa-854e-76fcf06c2835"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "0", ",", "0"}],
   "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->419060780,ExpressionUUID->"3e9bd137-35bb-415b-9e1e-10f7c2e7e55b"]
}, Open  ]],

Cell["Run the network as a cyclic tag system:", "TechNoteMathCaption",
 CellID->181597273,ExpressionUUID->"3ffea25f-3606-4c7a-ac3d-ea9f6d020030"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CompiledAutomataNetworkToCyclicTag", "[", 
   RowBox[{"net", ",", " ", "3"}], "]"}], "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->797390995,ExpressionUUID->"048dc220-fe54-4a1f-9adf-7ffad14b206c"],

Cell[BoxData[
 RowBox[{"{", 
