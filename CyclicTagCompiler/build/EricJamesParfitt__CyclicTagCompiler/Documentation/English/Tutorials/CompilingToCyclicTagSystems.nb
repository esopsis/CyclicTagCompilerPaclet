Cell[CellGroupData[{

Cell["Automata Networks", "TechNoteSection",
 CellID->611966894,ExpressionUUID->"6893910a-ec17-9a44-b2e0-aaf0d2ba9a5c"],

Cell[TextData[{
 "An automata network is a list of automata ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["inputs", "TI"], ",", " ", 
    StyleBox["label", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8634d0dc-94bc-eb44-9c4d-d3f1bb3499a3"],
 ". At each step all automata update at once, each applying its rules to the \
states of its inputs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "49b2f385-353a-fa45-a06d-81a0987c4d6c"],
 " runs automata networks:"
}], "TechNoteText",
 CellID->613702652,ExpressionUUID->"4195f39c-fc15-a941-ab95-744e18bbba23"],

Cell["A network of 3 automata with 3 states:", "TechNoteMathCaption",
 CellID->493951475,ExpressionUUID->"3b7f87f6-1c2d-cf43-b26c-9a214c086041"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "3"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",", " ", "1", ",",
            " ", "2", ",", " ", "2", ",", " ", "1", ",", " ", "0", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",",
            " ", "0", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "1"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "2"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "1", ",", " ", "2", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "2", "}"}], " ", "->", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "1", "}"}], " ", "->", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "0", "}"}], " ", "->", " ", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}], ",", " ", "3"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->178967235,ExpressionUUID->"fe2ebf21-a86f-f447-8e06-28686a9fd0de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkRun", "[", 
  RowBox[{"net", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->793597778,ExpressionUUID->"7933a0a3-3c55-1a40-8569-cb81b62e9331"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->192146418,ExpressionUUID->"c3c6e4a6-f7ad-324d-8066-4eb8db3b2ba7"]
}, Open  ]],

Cell["\<\
On the oblivious ring machine tape, each automaton has a block of cells: one \
for each of its inputs, plus extra cells if more automata read its state than \
it has inputs. Each network step is one pass through the ring machine rule, \
in three phases:\
\>", "TechNoteText",
 CellID->555678078,ExpressionUUID->"73c0dba7-2834-634a-b117-c7f97db96c20"],

Cell["\<\
grow: fill the extra cells of each block with copies of the automaton's state\
\
\>", "Item",
 CellID->272319002,ExpressionUUID->"1bfc80a1-c8b0-434e-9ce3-17e1eef84f3f"],

Cell["\<\
sort: bubble-sort the cells by swapping or skipping neighbors, so that each \
automaton's input cells hold the states of its inputs\
\>", "Item",
 CellID->562356427,ExpressionUUID->"fe9d1847-6b2c-b44a-a43a-7d68c8769381"],

Cell[CellGroupData[{

Cell["\<\
apply: apply each automaton's rules to its input cells, writing its new state \
into all of them\
\>", "Item",
 CellID->563234749,ExpressionUUID->"1821770e-09d6-6248-9c84-13853999449a"],

Cell["\<\
Automaton 2 is read by 2 automata but has 1 input, so it gets an extra cell:\
\>", "TechNoteMathCaption",
 CellID->200860385,ExpressionUUID->"44e93c25-82e4-3f41-a0c0-093bd1b13bed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkToObliviousRingMachineInit", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "net"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->337382418,ExpressionUUID->"88955ac4-e86c-c340-863a-2fc292f811c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "0", ",", "0"}],
   "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->419060780,ExpressionUUID->"26ff644a-d6d9-684e-9a69-8204274a873b"]
}, Open  ]],

Cell["Run the network as a cyclic tag system:", "TechNoteMathCaption",
 CellID->181597273,ExpressionUUID->"808673b1-f95c-624a-bc10-5fcbb54ad7b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CompiledAutomataNetworkToCyclicTag", "[", 
   RowBox[{"net", ",", " ", "3"}], "]"}], "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->797390995,ExpressionUUID->"083566ca-ac84-4540-bfc9-d8ebd81721b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->822051473,ExpressionUUID->"c0196fb1-86d7-0243-ad75-18306d3863d2"]
}, Open  ]],

Cell["\<\
Since a cellular automaton on a cyclic tape is an automata network in which \
each cell reads its neighbors, this gives a second way to compile cellular \
automata, and one that also works for other kinds of wiring.\
\>", "TechNoteText",
 CellID->206498190,ExpressionUUID->"b6a9fcb2-0cd8-6e44-a022-03624807f3a4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rule 110", "TechNoteSection",
 CellID->173401426,ExpressionUUID->"79950731-308c-d147-9772-f0228590e5da"],

Cell[TextData[{
 "Matthew Cook's construction emulates cyclic tag systems in rule 110 when \
their number of appendants is a multiple of 6. ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "06bba874-267c-7d47-86c5-adaf20e80487"],
 " rounds the size of every symbol's block up to a multiple of 6, which makes \
the number of appendants a multiple of 6. The compiled functions have the \
option ",
 Cell[BoxData["\"\<Mod6CyclicTag\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "43c5df6f-81df-e746-afc3-ce2d41ad7370"],
 " for this:"
}], "TechNoteText",
 CellID->405983159,ExpressionUUID->"5e895547-8fe8-244c-99fb-ca9b8337cde6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"30", ",", " ", "9"}], "]"}], ",", " ", 
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"30", ",", " ", "9", ",", " ", 
      RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->389782504,ExpressionUUID->"34fd23ac-7db0-c345-9873-f6f0fa5a6848"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"96", ",", "144"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->638848494,ExpressionUUID->"c41fea6b-2e50-9b4a-82ce-78879b38a875"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"30", ",", " ", "9", ",", " ", 
     RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<Mod6CyclicTag\>\"", " ", "->", " ", "True"}]}], "]"}], "[", 
   
   RowBox[{
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "4"}], "]"}], " ", "===",
   " ", 
  RowBox[{"CellularAutomaton", "[", 
   RowBox[{"30", ",", " ", 
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "4"}], "]"}]}]], "Input",\

 CellLabel->"In[2]:=",
 CellID->305360880,ExpressionUUID->"1961954a-2732-0943-b0f0-633ecaf3de4f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",
 CellID->599077929,ExpressionUUID->"6b82d9c7-af62-7343-b785-4153e78c01b6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Limitations", "TechNoteSection",
 CellID->646402629,ExpressionUUID->"b35286d4-9096-0a4f-ad8d-7778e6f814a3"],

Cell["\<\
Only finite systems can be compiled: cellular automata on cyclic tapes of a \
given length, and finite automata networks.\
\>", "Item",
 CellID->51305288,ExpressionUUID->"bf90a7d0-a014-4e42-a4a0-7fb55447992c"],

Cell["\<\
Oblivious ring machine steps must replace their window by the same number of \
symbols, read windows of the same size in each step, and only rotate the tape \
forward.\
\>", "Item",
 CellID->485182430,ExpressionUUID->"6c7bed9a-01b5-f84d-be14-8ab9f040bbae"],

Cell["\<\
Symbols or states that rules compute rather than write explicitly are not \
counted automatically; give the number of symbols or states for such rules.\
\>", "Item",
 CellID->806171566,ExpressionUUID->"f54f1cdd-e1c6-6840-95f5-6a3e48cecfbe"],

Cell[CellGroupData[{

Cell["\<\
The compiled cyclic tag systems are large, and grow with the tape length, the \
number of colors and the range:\
\>", "Item",
 CellID->63741478,ExpressionUUID->"d6276ad7-6259-d24f-bfe3-c9f61171e4fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"110", ",", " ", "n"}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "4", ",", " ", "12", ",", " ", "2"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->825897897,ExpressionUUID->"febf70cf-4098-8f4f-8809-4d9876ce8ba5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"56", ",", "72", ",", "88", ",", "104", ",", "120"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->812078781,ExpressionUUID->"96d94ebf-2901-1d4f-8100-8cf6823f8628"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

