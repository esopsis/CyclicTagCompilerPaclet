    RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->808745307,ExpressionUUID->"cf35f07e-7f0b-234f-bd19-0a5543b53cf7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["n-ary Cyclic Tag Systems", "TechNoteSection",
 CellID->25226445,ExpressionUUID->"a0aeeecb-e844-4b40-a7f2-b0705b5b287e"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1c36ad4e-bbf7-1a4f-b5f5-ca52c48ce5bf"],
 "-ary cyclic tag system has a tape of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4a34e4e3-ba53-e34a-bfa0-ae4127dab05d"],
 "-1. Each part of its rule gives an appendant for each symbol, and at each \
step the system deletes the first symbol and appends the appendant for that \
symbol from the current rule part. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5bcb2fd1-ed6b-6e4b-b7c2-74e313fb1afe"],
 " runs ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1d12e722-a767-0f41-827d-b0472f55f0fb"],
 "-ary cyclic tag systems:"
}], "TechNoteText",
 CellID->567517556,ExpressionUUID->"7bc3762c-9195-724a-81af-8e58ba8801d6"],

