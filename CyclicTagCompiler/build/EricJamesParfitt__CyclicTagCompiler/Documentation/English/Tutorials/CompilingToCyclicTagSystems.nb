Cell[CellGroupData[{

Cell["Cellular Automata", "TechNoteSection",
 CellID->601377700,ExpressionUUID->"315f0dfe-c271-471f-9a27-3c6ed489e250"],

Cell["\<\
An oblivious ring machine can emulate a cellular automaton on a finite cyclic \
tape by sweeping along the tape. At each step it reads a neighborhood, writes \
the new color of the cell at its center into the first cell of the \
neighborhood, and moves on by one cell:\
\>", "TechNoteText",
 CellID->863003076,ExpressionUUID->"4e77eff5-298d-4db5-b150-b7f9235ee393"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CellularAutomatonToObliviousRingMachineRule", "[", "110", 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->372450554,ExpressionUUID->"994cf568-0c3f-41be-92a9-fde2abe091be"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->108117850,ExpressionUUID->"5abc34cb-8180-42ac-98bc-31ec2318517d"]
}, Open  ]],

Cell[TextData[{
 "After a sweep of the whole tape, the new row of the cellular automaton is \
on the tape, shifted by the range of the rule. But the cells near the end of \
the tape see neighbors that have already been updated, so only the cells \
whose neighborhoods stayed inside the tape are reliable, 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ed4a60e6-c88b-4851-b8da-8311323a11cc"],
 " fewer at each step. This is what the compilation gives by default:"
}], "TechNoteText",
 CellID->976322935,ExpressionUUID->"12df6262-13df-4be2-aae6-d4f7bc4b5bc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"110", ",", " ", "9"}], "]"}], "[", 
   RowBox[{
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "5"}], "]"}], " ", "//",
   " ", "Column"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->785825157,ExpressionUUID->"b9ac6114-a47a-46a5-99c4-0fb6d7f0378b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "0", ",", "0", ",", "1", ",", "0", ",", "0", ",", 
       "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
      "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}]},
    {
     RowBox[{"{", "1", "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->"Out[2]=",
 CellID->799594873,ExpressionUUID->"fb7d6420-2f96-46a8-a07a-118d13a9103d"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "86e74d60-7d4b-498d-82e9-a3ff3605cca7"],
 ", the ring machine tape gets 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae17fd64-a775-45d1-b2b8-9b24a51df09c"],
 " extra cells, and before each sweep the machine copies the first 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "78ed627c-f2ce-4a6b-98f9-ee39864be106"],
 " cells into them. The neighborhoods at the end of the sweep then wrap \
around into old colors, and the compiled system emulates the cellular \
automaton on a cyclic tape for any number of steps:"
}], "TechNoteText",
 CellID->612890879,ExpressionUUID->"30bb4631-d412-414e-b1ca-c761615507c4"],

