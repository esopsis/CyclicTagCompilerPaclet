Cell[CellGroupData[{

Cell["Cellular Automata", "TechNoteSection",
 CellID->601377700,ExpressionUUID->"d551d9ce-3686-8846-a5f0-d9ce5ccd6468"],

Cell["\<\
An oblivious ring machine can emulate a cellular automaton on a finite cyclic \
tape by sweeping along the tape. At each step it reads a neighborhood, writes \
the new color of the cell at its center into the first cell of the \
neighborhood, and moves on by one cell:\
\>", "TechNoteText",
 CellID->863003076,ExpressionUUID->"2724dcd7-f39a-8340-bd78-7460ab87eb51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CellularAutomatonToObliviousRingMachineRule", "[", "110", 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->372450554,ExpressionUUID->"b69d9cd4-7fc6-3142-a47c-d3570473694b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->108117850,ExpressionUUID->"e0e50188-2b65-8348-a3ed-91fd3a3e4b25"]
}, Open  ]],

Cell[TextData[{
 "After a sweep of the whole tape, the new row of the cellular automaton is \
on the tape, shifted by the range of the rule. But the cells near the end of \
the tape see neighbors that have already been updated, so only the cells \
whose neighborhoods stayed inside the tape are reliable, 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d8255e39-fe6f-e645-9509-55db48a2bf2e"],
 " fewer at each step. This is what the compilation gives by default:"
}], "TechNoteText",
 CellID->976322935,ExpressionUUID->"00411b7f-3de8-3c48-b451-e653e02d5af8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"110", ",", " ", "9"}], "]"}], "[", 
   RowBox[{
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "5"}], "]"}], " ", "//",
   " ", "Column"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->785825157,ExpressionUUID->"7518f1cf-c0f1-e342-bdfa-5595a4016168"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "0", ",", "0", ",", "1", ",", "0", ",", "0", ",", 
       "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
      "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}]},
    {
     RowBox[{"{", "1", "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->"Out[2]=",
 CellID->799594873,ExpressionUUID->"2b3d245c-8e61-5446-88fd-d16749f10a0d"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3017eda4-0b84-134a-93eb-3cb1f5f375b3"],
 ", the ring machine tape gets 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "033b15cb-d456-f446-95ef-9f89ca1b5d86"],
 " extra cells, and before each sweep the machine copies the first 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d193e307-7e8c-014f-b756-f5b89bc4f14a"],
 " cells into them. The neighborhoods at the end of the sweep then wrap \
around into old colors, and the compiled system emulates the cellular \
automaton on a cyclic tape for any number of steps:"
}], "TechNoteText",
 CellID->612890879,ExpressionUUID->"9aeb5515-04f7-2d48-a8a8-e716c8997b93"],

