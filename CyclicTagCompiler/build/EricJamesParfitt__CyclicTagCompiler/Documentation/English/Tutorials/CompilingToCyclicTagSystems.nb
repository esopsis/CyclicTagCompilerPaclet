    RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->808745307,ExpressionUUID->"a5c5695d-824d-224f-a4da-6f9772d92738"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["n-ary Cyclic Tag Systems", "TechNoteSection",
 CellID->25226445,ExpressionUUID->"f8bdfeb4-2502-0f4c-bd6a-b7103170bb97"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e5a47c03-5f13-1d43-be6f-988956505e31"],
 "-ary cyclic tag system has a tape of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "71b9ce30-5bb8-b549-88c3-7e036c2db31b"],
 "-1. Each part of its rule gives an appendant for each symbol, and at each \
step the system deletes the first symbol and appends the appendant for that \
symbol from the current rule part. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b3837cd6-f26a-1d47-84ed-d0ebc6a92ff2"],
 " runs ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a04a1e3c-988d-c245-bb48-6365550a73d7"],
 "-ary cyclic tag systems:"
}], "TechNoteText",
 CellID->567517556,ExpressionUUID->"87e74101-a728-da4e-b563-d89615aeb0db"],

