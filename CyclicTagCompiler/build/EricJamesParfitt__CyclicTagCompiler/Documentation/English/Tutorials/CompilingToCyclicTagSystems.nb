Cell[BoxData[
 RowBox[{"Dimensions", "[", "nctRule", "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->513641876,ExpressionUUID->"a486069b-0eaf-4446-a79f-a43bf8f26976"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"24", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->194386813,ExpressionUUID->"4a24e846-bdfe-45d5-873a-d831526b1461"]
}, Open  ]],

Cell[TextData[{
 "Run the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "75ebb2b1-fdcc-43c7-97f7-888546e3af02"],
 "-ary system, decode its evolution, and compare with the ring machine:"
}], "TechNoteMathCaption",
 CellID->23521187,ExpressionUUID->"4900839a-f4b9-4c6b-a574-5564e07d5267"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DecodeNaryCyclicTagToObliviousRingMachine", "[", 
  RowBox[{
   RowBox[{"NaryCyclicTag", "[", 
    RowBox[{"nctRule", ",", " ", 
     RowBox[{"{", 
