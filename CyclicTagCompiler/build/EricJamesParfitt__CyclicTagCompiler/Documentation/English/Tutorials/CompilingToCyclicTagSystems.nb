 CellID->323922974,ExpressionUUID->"c04e7128-adb4-e34a-8306-923e383ad2a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], ",", 
