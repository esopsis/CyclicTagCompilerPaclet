 RowBox[{"AutomataNetworkRun", "[", 
  RowBox[{"net", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
