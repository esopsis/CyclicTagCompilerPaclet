Cell[CellGroupData[{

Cell["Automata Networks", "TechNoteSection",
 CellID->611966894,ExpressionUUID->"4c0e9a83-b574-4b9c-949e-88dad27edf47"],

Cell[TextData[{
 "An automata network is a list of automata ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["inputs", "TI"], ",", " ", 
    StyleBox["label", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "09c53637-0564-4304-97e7-2e93679d255e"],
 ". At each step all automata update at once, each applying its rules to the \
states of its inputs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "074f5591-bd37-4068-ab37-131358f80476"],
 " runs automata networks:"
}], "TechNoteText",
 CellID->613702652,ExpressionUUID->"ba59d24b-3af5-4383-bf78-d02ea20650c1"],

Cell["A network of 3 automata with 3 states:", "TechNoteMathCaption",
 CellID->493951475,ExpressionUUID->"4af4eeda-c54d-4209-af51-6be6ed790ccf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "3"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",", " ", "1", ",",
            " ", "2", ",", " ", "2", ",", " ", "1", ",", " ", "0", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",",
            " ", "0", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "1"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "2"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "1", ",", " ", "2", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "2", "}"}], " ", "->", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "1", "}"}], " ", "->", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "0", "}"}], " ", "->", " ", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}], ",", " ", "3"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->178967235,ExpressionUUID->"930d513e-0ed9-4c7f-839b-049e6243ecb9"],

