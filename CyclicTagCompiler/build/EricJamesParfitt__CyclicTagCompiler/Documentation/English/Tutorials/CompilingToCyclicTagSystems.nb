Cell[CellGroupData[{

Cell["n-ary Cyclic Tag Systems", "TechNoteSection",
 CellID->25226445,ExpressionUUID->"39ec091d-08cb-4ca4-a9e5-dbdb3bbe9838"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90826f50-6f77-45b2-a44f-99fd0b63cb69"],
 "-ary cyclic tag system has a tape of symbols from 0 to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29929ea4-44df-4ec9-a9bc-035f8cb9a782"],
 "-1. Each part of its rule gives an appendant for each symbol, and at each \
step the system deletes the first symbol and appends the appendant for that \
symbol from the current rule part. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NaryCyclicTag"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/NaryCyclicTag", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bd9d7c15-ff68-4694-bc7f-29b040d20928"],
 " runs ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1504cefb-cfb2-4fd9-b170-b4b4bd10cd3b"],
 "-ary cyclic tag systems:"
}], "TechNoteText",
 CellID->567517556,ExpressionUUID->"a45c4446-32be-4e52-9a5c-f88666593a75"],

