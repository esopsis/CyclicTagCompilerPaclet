    RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->822051473,ExpressionUUID->"9e2d5e1c-7ac4-40ff-b817-9b1736c39f8d"]
}, Open  ]],

Cell["\<\
Since a cellular automaton on a cyclic tape is an automata network in which \
each cell reads its neighbors, this gives a second way to compile cellular \
automata, and one that also works for other kinds of wiring.\
\>", "TechNoteText",
 CellID->206498190,ExpressionUUID->"74275afc-10bc-4949-b14f-e3a5b2af8f68"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rule 110", "TechNoteSection",
 CellID->173401426,ExpressionUUID->"9fc9b45c-c86a-40b6-bbae-04eebcbdbd1e"],

Cell[TextData[{
 "Matthew Cook's construction emulates cyclic tag systems in rule 110 when \
their number of appendants is a multiple of 6. ",
 Cell[BoxData[
  RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6b7f0d1-7e42-4c6d-8e8c-42da42165e67"],
 " rounds the size of every symbol's block up to a multiple of 6, which makes \
the number of appendants a multiple of 6. The compiled functions have the \
option ",
 Cell[BoxData["\"\<Mod6CyclicTag\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c21b54f3-8da9-4e16-b488-5167c05cb206"],
 " for this:"
}], "TechNoteText",
 CellID->405983159,ExpressionUUID->"87be62f2-dba3-463c-981d-a2186cb9f9e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"30", ",", " ", "9"}], "]"}], ",", " ", 
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"30", ",", " ", "9", ",", " ", 
      RowBox[{"\"\<TargetSystem\>\"", " ", "->", " ", "\"\<Rule110\>\""}]}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->389782504,ExpressionUUID->"2f79a81a-b7c4-4ec8-a910-54a36ad93f78"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"46", ",", "138"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->638848494,ExpressionUUID->"1b05f01f-26ee-47f9-b7fd-535c0a736442"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"30", ",", " ", "9", ",", " ", 
     RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<Mod6CyclicTag\>\"", " ", "->", " ", "True"}]}], "]"}], "[", 
   
   RowBox[{
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "4"}], "]"}], " ", "===",
   " ", 
  RowBox[{"CellularAutomaton", "[", 
   RowBox[{"30", ",", " ", 
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "4"}], "]"}]}]], "Input",\

 CellLabel->"In[2]:=",
 CellID->305360880,ExpressionUUID->"7d323f32-6ea2-4f7a-a613-09f1269a5691"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",
 CellID->599077929,ExpressionUUID->"2fa15960-b365-41cb-bed7-494bd9777e0a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Limitations", "TechNoteSection",
 CellID->646402629,ExpressionUUID->"49dcd75b-cef0-4e29-ab02-9c5bbf8f81f6"],

Cell["\<\
Only finite systems can be compiled: cellular automata on cyclic tapes of a \
given length, and finite automata networks.\
\>", "Item",
 CellID->51305288,ExpressionUUID->"a8dbc1c2-2539-4e1c-8ed4-51a5bb298a6b"],

Cell["\<\
Oblivious ring machine steps must replace their window by the same number of \
symbols, read windows of the same size in each step, and only rotate the tape \
forward.\
\>", "Item",
 CellID->485182430,ExpressionUUID->"b6417833-f657-4cd5-b4c7-4d8248a627c8"],

Cell["\<\
Symbols or states that rules compute rather than write explicitly are not \
counted automatically; give the number of symbols or states for such rules.\
\>", "Item",
 CellID->806171566,ExpressionUUID->"7f53b93b-f234-4bc5-8a7e-af14753333be"],

Cell[CellGroupData[{

Cell["\<\
The compiled cyclic tag systems are large, and grow with the tape length, the \
number of colors and the range:\
\>", "Item",
 CellID->63741478,ExpressionUUID->"0897e8e8-282c-4d1a-90ce-2d942cc37e9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"CellularAutomatonToCyclicTagRule", "[", 
     RowBox[{"110", ",", " ", "n"}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "4", ",", " ", "12", ",", " ", "2"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->825897897,ExpressionUUID->"e4e6f0c6-4740-4c4a-b3d7-f5f4c8b3dbeb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"26", ",", "34", ",", "42", ",", "50", ",", "58"}], "}"}]], "Output",\

 CellLabel->"Out[1]=",
 CellID->812078781,ExpressionUUID->"ed5c659a-1355-4abe-8d9e-63322bd10ce5"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

