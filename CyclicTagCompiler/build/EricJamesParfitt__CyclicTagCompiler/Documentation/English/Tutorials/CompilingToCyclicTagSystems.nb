  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ae7c0637-4e6c-a741-a0d1-53c53c96d585"],
 "-ary step."
}], "TechNoteText",
 CellID->619584675,ExpressionUUID->"39656ed3-b0e4-d848-aa91-742684990305"],

