Cell[CellGroupData[{

Cell["Cellular Automata", "TechNoteSection",
 CellID->601377700,ExpressionUUID->"1a728522-a18d-464c-98fe-383991c6d940"],

Cell["\<\
An oblivious ring machine can emulate a cellular automaton on a finite cyclic \
tape by sweeping along the tape. At each step it reads a neighborhood, writes \
the new color of the cell at its center into the first cell of the \
neighborhood, and moves on by one cell:\
\>", "TechNoteText",
 CellID->863003076,ExpressionUUID->"44743569-28fe-274e-81d0-1c4869fd1071"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CellularAutomatonToObliviousRingMachineRule", "[", "110", 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->372450554,ExpressionUUID->"3f44b8ba-4f39-cd4b-a05f-047a3dadb7b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->108117850,ExpressionUUID->"2f40eeb8-7825-9d4c-9898-794df13c8c56"]
}, Open  ]],

Cell[TextData[{
 "After a sweep of the whole tape, the new row of the cellular automaton is \
on the tape, shifted by the range of the rule. But the cells near the end of \
the tape see neighbors that have already been updated, so only the cells \
whose neighborhoods stayed inside the tape are reliable, 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c1cde182-657c-354e-a1db-53fd7557c481"],
 " fewer at each step. This is what the compilation gives by default:"
}], "TechNoteText",
 CellID->976322935,ExpressionUUID->"f27e08b6-0131-a546-9215-408dd2046076"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CompiledCellularAutomatonToCyclicTag", "[", 
    RowBox[{"110", ",", " ", "9"}], "]"}], "[", 
   RowBox[{
    RowBox[{"CenterArray", "[", "9", "]"}], ",", " ", "5"}], "]"}], " ", "//",
   " ", "Column"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->785825157,ExpressionUUID->"4edc0052-121c-5441-a82e-d63e408d5fd5"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "0", ",", "0", ",", "1", ",", "0", ",", "0", ",", 
       "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
      "0", ",", "0", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
      "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}]},
    {
     RowBox[{"{", "1", "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->"Out[2]=",
 CellID->799594873,ExpressionUUID->"56430af1-ef11-824e-943a-3c8674b84786"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<InfiniteSteps\>\"", " ", "->", " ", 
   TemplateBox[{
     Cell[
      TextData["True"]], "paclet:ref/True"},
    "RefLink",
    BaseStyle->{"InlineFormula"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "992fad8c-f0a2-3347-b1bd-5e17437ae895"],
 ", the ring machine tape gets 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6f0d520d-975f-ab4c-be3b-029bef70575d"],
 " extra cells, and before each sweep the machine copies the first 2 ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "27959c95-803a-d240-80bf-a9c488e104b6"],
 " cells into them. The neighborhoods at the end of the sweep then wrap \
around into old colors, and the compiled system emulates the cellular \
automaton on a cyclic tape for any number of steps:"
}], "TechNoteText",
 CellID->612890879,ExpressionUUID->"db7b4738-6d10-4645-a6b7-99a6b8591241"],

