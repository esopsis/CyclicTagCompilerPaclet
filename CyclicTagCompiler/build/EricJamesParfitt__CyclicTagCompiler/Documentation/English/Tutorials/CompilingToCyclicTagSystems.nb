   RowBox[{"ObliviousRingMachineToNaryCyclicTagRule", "[", 
    RowBox[{"orm", ",", " ", "5"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->375049957,ExpressionUUID->"3ea99445-d9b5-bb44-8704-b00ea0457a56"],

