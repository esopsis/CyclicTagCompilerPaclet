  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6180e1f1-3d5e-0248-aa6e-e1bc01a30bd9"],
 "-ary step."
}], "TechNoteText",
 CellID->619584675,ExpressionUUID->"7cb2380c-e5cf-004b-bfc1-6d3437133221"],

