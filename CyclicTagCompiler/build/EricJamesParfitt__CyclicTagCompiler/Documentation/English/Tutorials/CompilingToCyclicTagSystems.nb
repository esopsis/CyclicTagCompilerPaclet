 RowBox[{
  RowBox[{"nctRule", " ", "=", " ", 
   RowBox[{"ObliviousRingMachineToNaryCyclicTagRule", "[", 
    RowBox[{"orm", ",", " ", "5"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->375049957,ExpressionUUID->"e3a4b31d-a022-44c9-9a9d-8a80a5c05e77"],

