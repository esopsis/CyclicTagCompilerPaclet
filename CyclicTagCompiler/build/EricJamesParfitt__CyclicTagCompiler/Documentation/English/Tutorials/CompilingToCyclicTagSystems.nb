Cell[CellGroupData[{

Cell["Automata Networks", "TechNoteSection",
 CellID->611966894,ExpressionUUID->"d27b2a96-163b-cd4c-b93c-160126bac487"],

Cell[TextData[{
 "An automata network is a list of automata ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["inputs", "TI"], ",", " ", 
    StyleBox["label", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fceaa669-60bc-9542-b386-ebdbe8303d33"],
 ". At each step all automata update at once, each applying its rules to the \
states of its inputs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AutomataNetworkRun"]], 
    "paclet:EricJamesParfitt/CyclicTagCompiler/ref/AutomataNetworkRun", 
    "EricJamesParfitt Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "443b8bfa-3f5a-9d4f-bca1-cc2316a4d40f"],
 " runs automata networks:"
}], "TechNoteText",
 CellID->613702652,ExpressionUUID->"0cc6bbeb-8953-aa4a-8a84-21b7dfe7c3af"],

Cell["A network of 3 automata with 3 states:", "TechNoteMathCaption",
 CellID->493951475,ExpressionUUID->"498fd686-4991-6543-938c-1e5b9c013ddd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "3"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",", " ", "1", ",",
            " ", "2", ",", " ", "2", ",", " ", "1", ",", " ", "0", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", "2", ",",
            " ", "0", ",", " ", "1", ",", " ", "1", ",", " ", "2", ",", " ", 
           "1", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", "1"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           "2"}], "]"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
            " ", "1", ",", " ", "2", ",", " ", "0", ",", " ", "1"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "2", "}"}], " ", "->", " ", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "1", "}"}], " ", "->", " ", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "0", "}"}], " ", "->", " ", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}], ",", " ", "3"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->178967235,ExpressionUUID->"cffa6c38-a75c-4b45-b628-bc5d5bfe1c3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkRun", "[", 
  RowBox[{"net", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->793597778,ExpressionUUID->"bdb9a8fd-a577-094d-a886-605c9c036179"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->192146418,ExpressionUUID->"ac27fa06-7308-f84f-968c-b12200bcb516"]
}, Open  ]],

Cell["\<\
On the oblivious ring machine tape, each automaton has a block of cells: one \
for each of its inputs, plus extra cells if more automata read its state than \
it has inputs. Each network step is one pass through the ring machine rule, \
in three phases:\
\>", "TechNoteText",
 CellID->555678078,ExpressionUUID->"cdc9e24c-3839-364c-a857-f6763a55993d"],

Cell["\<\
grow: fill the extra cells of each block with copies of the automaton's state\
\
\>", "Item",
 CellID->272319002,ExpressionUUID->"2173a01f-4cac-d245-b227-1b9182367552"],

Cell["\<\
sort: bubble-sort the cells by swapping or skipping neighbors, so that each \
automaton's input cells hold the states of its inputs\
\>", "Item",
 CellID->562356427,ExpressionUUID->"ad7da524-cc50-1f47-8e0f-2bcc862da335"],

Cell[CellGroupData[{

Cell["\<\
apply: apply each automaton's rules to its input cells, writing its new state \
into all of them\
\>", "Item",
 CellID->563234749,ExpressionUUID->"f67523c6-fc60-004a-94bd-8bb094a3555d"],

Cell["\<\
Automaton 2 is read by 2 automata but has 1 input, so it gets an extra cell:\
\>", "TechNoteMathCaption",
 CellID->200860385,ExpressionUUID->"39590abb-feb6-8c40-8c63-1c1c626f322c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AutomataNetworkToObliviousRingMachineInit", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "net"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->337382418,ExpressionUUID->"c984bc93-6897-ba49-aaff-21b603e07a87"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "0", ",", "0"}],
   "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->419060780,ExpressionUUID->"0c186880-43ad-a340-8c7e-40cde4dd65cc"]
}, Open  ]],

Cell["Run the network as a cyclic tag system:", "TechNoteMathCaption",
 CellID->181597273,ExpressionUUID->"3f20128a-7f35-ce49-b36f-3f6a4cdeb2e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CompiledAutomataNetworkToCyclicTag", "[", 
   RowBox[{"net", ",", " ", "3"}], "]"}], "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", "5"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->797390995,ExpressionUUID->"55dc4b28-845f-d84a-8643-882dee4ec0b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
